# --- PostgreSQL ---
# Application role, sql/roles.sql.
DATABASE_URL=postgres://insurance_app:app_password@localhost:5432/insurance
# The database `npm test` writes to -- never the working one above. Built and
# marked by `node scripts/setupTestDb.mjs` (from the repo root). The tests
# that write refuse to start without it, and refuse a database that is the
# working one or does not carry the marker.
# Application role, sql/roles.sql.
TEST_DATABASE_URL=postgres://insurance_app:app_password@localhost:5432/insurance_test
# Maintenance role: createdb, sql/schema.sql, CREATE EXTENSION pgcrypto, the
# test-database marker, and applying sql/roles.sql.
DATABASE_MAINT_URL=postgres://postgres:postgres@localhost:5432/insurance

# --- Canton / Daml JSON Ledger API ---
# Ports below match the Canton Builder Tool's LocalNet defaults: the App
# Provider participant is where this platform's insurer + oracle-operator
# parties should be hosted.
DAML_JSON_API_URL=http://localhost:3975
# LocalNet ("unsafe-jwt-hmac-256" auth): leave DAML_LEDGER_TOKEN unset and
# set this instead -- damlClient.js mints a fresh HS256 token per call.
DAML_UNSAFE_JWT_SECRET=unsafe
DAML_UNSAFE_JWT_SUB=ledger-api-user
# Production/TestNet/MainNet: set a real OIDC-issued bearer token here
# instead (takes priority over DAML_UNSAFE_JWT_SECRET if both are set).
DAML_LEDGER_TOKEN=
# Raw package-id hash from the deployed DAR's META-INF/MANIFEST.MF
# (Main-Dalf filename's trailing hash) -- PV34 networks like Canton Builder
# Tool's LocalNet need id-based addressing, not package-name. Changes on
# every DAR rebuild; re-run `canton builder deploy` and update this after.
DAML_PACKAGE_ID=replace-with-deployed-package-id
# The SECOND participant: where the oracle operator parties are hosted and
# where every submission made as an oracle party is sent. LocalNet's App User
# participant is http://localhost:2975, which scripts/uploadDar.mjs already
# uploads the DAR to.
#
# EMPTY (the default) = one participant: the oracle operator shares the
# insurer's participant, DAML_JSON_API_URL above, as in a single-participant
# setup. SET = the oracle's parties are allocated there, the CanActAs right
# is granted to that participant's ledger user (rights are per participant),
# and the trigger is submitted there. There is no half state: if it is set and
# unreachable, the dispatcher says so loudly at startup and every trigger
# fails -- nothing falls back to the insurer's participant.
#
# Measured by a two-participant check kept outside this repository: the trigger works
# across the two in ONE submission, the insurer cannot exercise it from its
# own participant (400 DAML_AUTHORIZATION_ERROR), and the oracle party cannot
# be submitted as from the participant that does not host it (403).
DAML_JSON_API_URL_ORACLE=
# Delay before each retry of a trigger the oracle's participant refused with
# CONTRACT_NOT_FOUND because the freshly minted token has not reached it yet,
# in milliseconds -- the same comma-separated format as
# WEBHOOK_RETRY_SCHEDULE_MS below. USED ONLY when DAML_JSON_API_URL_ORACLE is
# set and names a different participant; with one participant a
# CONTRACT_NOT_FOUND fails the outbox row immediately, as it always has.
# The default spans the window the two-participant measurement found -- one run of five was refused at
# +473ms after the mint and accepted at +1122ms, the others accepted first try
# between +455 and +1046ms -- giving attempts at +0, +500, +1500, +3500 and
# +7500ms. When the list runs out the row is marked failed and the error says
# how many attempts were made.
ORACLE_TRIGGER_RETRY_SCHEDULE_MS=500,1000,2000,4000
# Delay before each retry of a trigger the ledger refused ONLY because its
# event has not ended yet on the ledger's clock (the choice refuses an eventEnd
# after the transaction's ledger time), in milliseconds, in the same format.
# The oracle queues a window once it has closed on its own clock, which is not
# the ledger's. Used with one participant or two. The default is
# ORACLE_TRIGGER_RETRY_SCHEDULE_MS's default, copied, not measured: no
# difference between the two clocks has been measured. When the list runs out
# the row is marked failed and the error says how many attempts were made.
ORACLE_TRIGGER_UNENDED_RETRY_SCHEDULE_MS=500,1000,2000,4000

# --- Dispatcher ---
# How often dispatch/dispatcher.js looks for pending policy_events rows of
# every type, not only activations. The key keeps its earlier mint-watcher
# name (config.js says so).
MINT_WATCHER_POLL_MS=2000

# --- Oracle bot ---
# Read in the Node process's own timezone: unlike the four sweepers below,
# oracleBot.js gives node-cron no zone.
ORACLE_POLL_CRON=*/15 * * * *
# STAND-IN provider, not a chosen data source: MET Norway Locationforecast.
# Base URL only -- oracleBot.js appends the product path. It is a FORECAST
# product, not an observation, and cell ids look like "metno:<lat>,<lon>".
CLIMATE_API_URL=https://api.met.no
# Required by MET Norway: application/domain name plus a contact address.
# There is no default; the fetch refuses without it.
CLIMATE_API_USER_AGENT=your-app/0.1 you@example.com

# --- Expiry sweeper ---
# Default is hourly, on the hour -- a convenience only. Correctness
# comes from the sweeper's own "expiry in the past, still open" query, not
# from this schedule; a missed run (downtime, etc.) is recoverable simply
# by running again.
# Hourly because a policy held past expiry for its last window should stay
# open at most an hour, not a day, once that window has closed and been
# evaluated; the sweeper is a state test, so running it often is harmless.
# Read in Europe/Istanbul, fixed in the sweeper's code, whatever the server's zone.
EXPIRY_SWEEP_CRON=0 * * * *

# --- Grace-period sweeper ---
# Two phases: queues 'termination' for policies whose notice period has
# elapsed, then 'termination_archive' once a terminated policy's payouts are
# all closed. Same convenience-not-correctness reasoning as the
# expiry sweeper above.
# Kept daily in v22: hourly would record a termination before a late but timely payment report can arrive; a held window waits up to a day, delayed but not lost.
# Read in Europe/Istanbul, fixed in the sweeper's code, whatever the server's zone.
GRACE_SWEEP_CRON=0 12 * * *
# m. 1434(2): the first-premium withdrawal sweep. A separate mechanism from
# the grace sweep above, not a phase of it.
# Read in Europe/Istanbul, fixed in the sweeper's code, whatever the server's zone.
FIRST_PREMIUM_SWEEP_CRON=0 12 * * *

# m. 1434(4): when the elected termination is checked for having reached the
# end of its insurance period. A convenience only -- the sweeper is a state
# test and the instant it records is frozen on the policy.
# Read in Europe/Istanbul, fixed in the sweeper's code, whatever the server's zone.
TWO_NOTICE_SWEEP_CRON=0 12 * * *

# --- Payout listener ---
# Polls the ledger for PayoutApproved contracts and writes a settlement-
# tracking row. It instructs no payment: the insurer pays through its own
# systems and reports the settlement back.
PAYOUT_LISTENER_POLL_MS=10000

# --- Payout notification sender ---
# Posts the thin envelope (id, type, payoutId, createdAt, apiVersion) to the
# address an insurer set with `npm run set-webhook`, signed with HMAC-SHA256.
# The master key signs nothing directly: each insurer's secret is derived from
# it and its webhook_secret_version, and is never stored. Empty = the sender
# does not start; there is no unsigned delivery path. Generate your own; never
# commit it.
WEBHOOK_SIGNING_MASTER_KEY=
WEBHOOK_SENDER_POLL_MS=5000
WEBHOOK_TIMEOUT_MS=10000
# Delay before each retry, in milliseconds. When the list runs out the
# notification is marked failed.
WEBHOOK_RETRY_SCHEDULE_MS=60000,300000,1800000,7200000,43200000
# A row left in processing longer than this (a sender that exited mid-delivery)
# is handed back to pending with the attempt counted, or failed if the retry
# schedule has run out. Keep it well above WEBHOOK_TIMEOUT_MS.
WEBHOOK_STALE_PROCESSING_MS=120000
# false = only loopback addresses (localhost, 127.0.0.0/8, ::1) are posted to;
# any other address is marked failed without a request. Keep it false: nothing
# goes to a real insurer address until a legal review is complete.
WEBHOOK_ALLOW_NON_LOOPBACK=false

# --- Server ---
PORT=8080
# Empty = off. Only the exact value true mounts /debug (the dashboards, the
# story and roles pages and their data: party ids and contract payloads, no
# authentication, loopback only); anything else, false included, leaves them
# off and is logged at startup as not recognised. Never true in a deployment.
# The same page files are also served from node/public as /debug-dashboard.html,
# /story.html and /roles.html whatever this flag says, without the loopback
# check; with the flag off, the /debug data calls they make get 404.
DEBUG_ROUTES_ENABLED=
