-- A real mortgagee with per-coverage claim amounts. The bank's charge sits
-- on one coverage and not the other -- an absent claim amount is the normal
-- case, not a missing value.
test_mortgageeWithPerCoverageClaimAmounts : Script ()
test_mortgageeWithPerCoverageClaimAmounts = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "MortgageeBank"
  let charged = frostCoverage with mortgageeClaimAmount = Some 40000.0
      -- no claim amount: the bank's charge does not reach this coverage
      uncharged = Coverage with
        coverageCode = "GLASS"
        sumInsured = 20000.0
        remainingLimit = 20000.0
        payoutTiers = frostTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [charged, uncharged]

  Some policy <- queryContractId insurer policyCid
  assert (policy.mortgagee == Some bank)
  let Some c1 = find (\c -> c.coverageCode == "FROST") policy.coverages
      Some c2 = find (\c -> c.coverageCode == "GLASS") policy.coverages
  assert (c1.mortgageeClaimAmount == Some 40000.0)
  assert (isNone c2.mortgageeClaimAmount)

  -- The mortgagee is an observer and can therefore see the token -- INCLUDING
  -- the coverage it has no claim on. That is what a Daml observer is; there
  -- is no per-field visibility. Asserted so the consequence is on the record
  -- rather than implied.
  Some asSeenByBank <- queryContractId bank policyCid
  assert (asSeenByBank == policy)
  assert (length asSeenByBank.coverages == 2)

-- The invariant that predates role intake, and the same ensure that
-- test_mortgageeClaimEnsureRejectsClaimWithoutMortgagee exercises: a claim
-- amount without a mortgagee to claim it.
test_claimAmountWithoutMortgageeIsRejected : Script ()
test_claimAmountWithoutMortgageeIsRejected = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let charged = frostCoverage with mortgageeClaimAmount = Some 40000.0
  submitMustFail insurer do
    createCmd PolicyToken with
      policyNo = "TEST-CLAIM-NO-MORTGAGEE"
      version = 1
      predecessorRef = None
      insurer
      policyholder
      insured
      beneficiary = None
      beneficiaryDescriptorHash = None
      coverageBeganAt = None
      coverageStartBasis = None
      retroactiveCoverCheckedAt = None
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee = None            -- ...but a coverage claims against one
      oracleOperator
      coverages = [charged]
      termStart = time (date 2026 Jan 1) 12 0 0
      expiry = time (date 2026 Dec 31) 12 0 0
      coverageValidThrough = time (date 2026 Dec 31) 12 0 0
      noticeServiceDate = None
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
      defaultState = DS_None
      documentHash = None
      amendmentReason = None

-- The m. 1456 sequence, end to end, on a policy that actually has a
-- mortgagee. Every one of these choices had existed since termination was
-- built, and none had ever run against a token where `mortgagee` was Some.
test_mortgageeFlowsRunOnAPolicyThatHasOne : Script ()
test_mortgageeFlowsRunOnAPolicyThatHasOne = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "MortgageeBank"
  now <- getTime
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [frostCoverage with mortgageeClaimAmount = Some 40000.0]

  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now

  -- m. 1456(4): the insurer says it notified the real-right holder.
  notifiedCid <- submit insurer do
    exerciseCmd inNoticeCid PolicyToken_RecordMortgageeNotice with
      notifiedAt = now
  Some notified <- queryContractId insurer notifiedCid
  assert (notified.mortgageeNotifiedAt == Some now)

  -- m. 1456(5): the window opens AT termination, and its length is supplied,
  -- never assumed.
  let terminationInstant = addRelTime now (days 10)
      windowEnds = addRelTime terminationInstant (days 15)
  terminatedCid <- submit insurer do
    exerciseCmd notifiedCid PolicyToken_Terminate with
      terminationInstant
      unrunDays = 60
      mortgageeContinuationEndsAt = Some windowEnds
  Some terminated <- queryContractId insurer terminatedCid
  assert (terminated.defaultState == DS_Terminated)
  assert (terminated.mortgageeContinuationEndsAt == Some windowEnds)
  assert (terminated.mortgageeNotifiedAt == Some now)   -- survives termination

  electedCid <- submit insurer do
    exerciseCmd terminatedCid PolicyToken_RecordMortgageeElection with
      election = ME_Continue
  Some elected <- queryContractId insurer electedCid
  assert (elected.mortgageeElection == Some ME_Continue)
  -- Recording ME_Continue does NOT revive the contract. The takeover is
  -- deliberately not implemented; this is a recorded fact and nothing more.
  assert (elected.defaultState == DS_Terminated)
  assert (elected.coverageValidThrough == terminationInstant)

  -- And the bank could see all of it throughout, as an observer.
  Some asSeenByBank <- queryContractId bank electedCid
  assert (asSeenByBank.mortgageeElection == Some ME_Continue)

-- m. 1456(5): an election needs a mortgagee to make it and a terminated
-- contract for it to arise on; ME_Decline records like ME_Continue does.
test_mortgageeElectionGuards : Script ()
test_mortgageeElectionGuards = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "MortgageeBank"
  now <- getTime

  -- No mortgagee: a terminated policy, but nobody to elect.
  bareCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  bareNoticeCid <- submit insurer do
    exerciseCmd bareCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  bareTerminatedCid <- submit insurer do
    exerciseCmd bareNoticeCid PolicyToken_Terminate with
      terminationInstant = addRelTime now (days 10)
      unrunDays = 60
      mortgageeContinuationEndsAt = None
  submitMustFail insurer do
    exerciseCmd bareTerminatedCid PolicyToken_RecordMortgageeElection with
      election = ME_Decline

  -- A mortgagee, but the contract is still in its notice period.
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [frostCoverage with mortgageeClaimAmount = Some 40000.0]
  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  submitMustFail insurer do
    exerciseCmd inNoticeCid PolicyToken_RecordMortgageeElection with
      election = ME_Decline

  -- control: the same policy once terminated records ME_Decline
  terminatedCid <- submit insurer do
    exerciseCmd inNoticeCid PolicyToken_Terminate with
      terminationInstant = addRelTime now (days 10)
      unrunDays = 60
      mortgageeContinuationEndsAt = Some (addRelTime now (days 25))
  declinedCid <- submit insurer do
    exerciseCmd terminatedCid PolicyToken_RecordMortgageeElection with
      election = ME_Decline
  Some declined <- queryContractId insurer declinedCid
  assert (declined.mortgageeElection == Some ME_Decline)
  assert (declined.defaultState == DS_Terminated)

-- ---------------------------------------------------------------------------
-- m. 1434(2): first-premium default -- cayma, not fesih
-- ---------------------------------------------------------------------------
--
-- A different mechanism from the notice flow, with its own vocabulary. These
-- assert that the two cannot be conflated on one token, that both routes to
-- withdrawal work, and that the routes are not interchangeable.

-- Helper: report a due date and land in first-premium default.
inFirstPremiumDefault : Party -> ContractId PolicyToken -> Time -> Script (ContractId PolicyToken)
inFirstPremiumDefault insurer cid dueDate =
  submit insurer do
    exerciseCmd cid PolicyToken_RecordPremiumDueDate with dueDate

-- Sentence 1: "sigortacı ... sözleşmeden üç ay içinde cayabilir" -- an act.
test_insurerWithdrawsForFirstPremium : Script ()
test_insurerWithdrawsForFirstPremium = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let dueDate = addRelTime now (days (-30))

  unpaidCid <- inFirstPremiumDefault insurer policyCid dueDate
  Some unpaid <- queryContractId insurer unpaidCid
  assert (unpaid.defaultState == DS_FirstPremiumUnpaid)
  assert (unpaid.premiumDueDate == Some dueDate)
  -- Cover is NOT moved. Whether it ever began is m. 1421's question and this
  -- mechanism does not answer it.
  assert (unpaid.coverageValidThrough == unpaid.expiry)

  withdrawnCid <- submit insurer do
    exerciseCmd unpaidCid PolicyToken_WithdrawForFirstPremium with
      withdrawnAt = now
      path = WP_InsurerWithdrew
  Some withdrawn <- queryContractId insurer withdrawnCid
  assert (withdrawn.defaultState == DS_WithdrawnForFirstPremium)
  assert (withdrawn.withdrawnAt == Some now)
  assert (withdrawn.withdrawalPath == Some WP_InsurerWithdrew)
  assert (withdrawn.premiumDueDate == Some dueDate)   -- the due date survives
  -- The token is re-minted, NOT archived: archiving would encode a holding on
  -- whether cayma is retroactive, which the text does not support.
  assert (withdrawn.version == unpaid.version + 1)

-- Sentence 2: withdrawal follows from the claim NOT having been pursued.
test_deemedWithdrawalWithoutEnforcement : Script ()
test_deemedWithdrawalWithoutEnforcement = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let dueDate = addRelTime now (days (-100))

  unpaidCid <- inFirstPremiumDefault insurer policyCid dueDate
  withdrawnCid <- submit insurer do
    exerciseCmd unpaidCid PolicyToken_WithdrawForFirstPremium with
      withdrawnAt = now
      path = WP_DeemedNoEnforcement
  Some withdrawn <- queryContractId insurer withdrawnCid
  assert (withdrawn.defaultState == DS_WithdrawnForFirstPremium)
  assert (withdrawn.withdrawalPath == Some WP_DeemedNoEnforcement)
  assert (isNone withdrawn.enforcementCommencedAt)

-- The deemed route exists BECAUSE the claim was not pursued. Where the
-- insurer reports it was, sentence 2 does not apply and only the insurer's
-- own act can end the contract.
test_enforcementForeclosesTheDeemedPath : Script ()
test_enforcementForeclosesTheDeemedPath = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let dueDate = addRelTime now (days (-100))

  unpaidCid <- inFirstPremiumDefault insurer policyCid dueDate
  pursuedCid <- submit insurer do
    exerciseCmd unpaidCid PolicyToken_RecordEnforcementCommenced with
      commencedAt = addRelTime now (days (-40))
  Some pursued <- queryContractId insurer pursuedCid
  assert (isSome pursued.enforcementCommencedAt)
  assert (pursued.defaultState == DS_FirstPremiumUnpaid)  -- still in default

  -- Commencement is reported once; the report above is its control.
  submitMustFail insurer do
    exerciseCmd pursuedCid PolicyToken_RecordEnforcementCommenced with
      commencedAt = addRelTime now (days (-20))

  -- The deemed path is refused...
  submitMustFail insurer do
    exerciseCmd pursuedCid PolicyToken_WithdrawForFirstPremium with
      withdrawnAt = now
      path = WP_DeemedNoEnforcement

  -- ...but the insurer's own act is not.
  withdrawnCid <- submit insurer do
    exerciseCmd pursuedCid PolicyToken_WithdrawForFirstPremium with
      withdrawnAt = now
      path = WP_InsurerWithdrew
  Some withdrawn <- queryContractId insurer withdrawnCid
  assert (withdrawn.withdrawalPath == Some WP_InsurerWithdrew)
  assert (isSome withdrawn.enforcementCommencedAt)

-- Payment arriving before either route completes.
test_firstPremiumPaidBeforeEitherPathCompletes : Script ()
test_firstPremiumPaidBeforeEitherPathCompletes = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let dueDate = addRelTime now (days (-10))

  unpaidCid <- inFirstPremiumDefault insurer policyCid dueDate
  paidCid <- submit insurer do
    exerciseCmd unpaidCid PolicyToken_RecordFirstPremiumPaid with paidAt = now
  Some paid <- queryContractId insurer paidCid
  assert (paid.defaultState == DS_None)
  -- The due date stays: it is a fact about what happened, not a flag.
  assert (paid.premiumDueDate == Some dueDate)
  assert (isNone paid.withdrawnAt)

  -- And withdrawal is no longer available on it.
  submitMustFail insurer do
    exerciseCmd paidCid PolicyToken_WithdrawForFirstPremium with
      withdrawnAt = now
      path = WP_InsurerWithdrew

  -- Nor can a due date be reported again: the token is back in DS_None, but
  -- the first report above stands and is not restated.
  submitMustFail insurer do
    exerciseCmd paidCid PolicyToken_RecordPremiumDueDate with dueDate = now

-- A trigger in first-premium default is refused, with its own reason -- a
-- policy whose first premium is reported unpaid is not a policy that lost
-- cover.
test_triggerRejectedInFirstPremiumDefault : Script ()
test_triggerRejectedInFirstPremiumDefault = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  -- Minted here, before the ledger clock moves to the event's end, so its
  -- cover starts with the others' (v22).
  controlCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  unpaidCid <- inFirstPremiumDefault insurer policyCid (addRelTime now (days (-30)))
  reachEventEnd (addRelTime now (days 1))
  submitMustFail oracleOperator do
    exerciseCmd unpaidCid PolicyToken_EvaluateTrigger with
      selfContractId = show unpaidCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-first-premium-unpaid"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

  withdrawnCid <- submit insurer do
    exerciseCmd unpaidCid PolicyToken_WithdrawForFirstPremium with
      withdrawnAt = now
      path = WP_InsurerWithdrew
  reachEventEnd (addRelTime now (days 1))
  submitMustFail oracleOperator do
    exerciseCmd withdrawnCid PolicyToken_EvaluateTrigger with
      selfContractId = show withdrawnCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-after-withdrawal"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

  -- Control: the same reading on a policy in neither state DOES pay, so the
  -- refusals above are the state and not the reading.
  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd controlCid PolicyToken_EvaluateTrigger with
      selfContractId = show controlCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "control-reading"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched

-- The two mechanisms are mutually exclusive on one token. m. 1434(2) governs
-- the FIRST premium and m. 1434(3) the ones that follow; conflating them is
-- the specific failure this vocabulary exists to prevent.
test_firstPremiumAndNoticeMechanismsCannotCoexist : Script ()
test_firstPremiumAndNoticeMechanismsCannotCoexist = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  -- A policy under notice for a subsequent premium cannot then be put into
  -- the first-premium mechanism.
  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  submitMustFail insurer do
    exerciseCmd inNoticeCid PolicyToken_RecordPremiumDueDate with dueDate = now
  -- ...nor be reported as having paid its first premium.
  submitMustFail insurer do
    exerciseCmd inNoticeCid PolicyToken_RecordFirstPremiumPaid with paidAt = now

  -- The same holds once the notice has been paid off. The token is back in
  -- DS_None, so this reaches the "already under notice" guard and not the
  -- "already in default" one the refusal above stops at.
  paidOffCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  reinstatedCid <- noticeThenPay insurer paidOffCid now
  submitMustFail insurer do
    exerciseCmd reinstatedCid PolicyToken_RecordPremiumDueDate with dueDate = now
  -- control: in DS_None the first premium can be reported paid
  _ <- submit insurer do
    exerciseCmd reinstatedCid PolicyToken_RecordFirstPremiumPaid with paidAt = now

  -- And a policy in first-premium default cannot be served an ihtar.
  otherCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  unpaidCid <- inFirstPremiumDefault insurer otherCid (addRelTime now (days (-30)))
  submitMustFail insurer do
    exerciseCmd unpaidCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  -- ...nor terminated under m. 1434(3), which is a different mechanism.
  submitMustFail insurer do
    exerciseCmd unpaidCid PolicyToken_Terminate with
      terminationInstant = now
      unrunDays = 10
      mortgageeContinuationEndsAt = None

-- ensure: withdrawal cannot be asserted without the facts, and the due date
-- both of m. 1434(2)'s clocks run from cannot be absent.
test_firstPremiumEnsureGuards : Script ()
test_firstPremiumEnsureGuards = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  let base = PolicyToken with
        policyNo = "TEST-FP-ENSURE"
        version = 1
        predecessorRef = None
        insurer
        policyholder
        insured
        beneficiary = None
        beneficiaryDescriptorHash = None
        mortgagee = None
        oracleOperator
        coverages = [frostCoverage]
        termStart = time (date 2026 Jan 1) 12 0 0
        expiry = time (date 2026 Dec 31) 12 0 0
        coverageValidThrough = time (date 2026 Dec 31) 12 0 0
        noticeServiceDate = None
        noticeRecordedAt = None
        noticeCount = 0
        noticeServiceDates = []
        twoNoticeElectionAt = None
        twoNoticeEffectiveAt = None
        coverageBeganAt = None
        coverageStartBasis = None
        retroactiveCoverCheckedAt = None
        enforcementFruitlessAt = None
        enforcementRoute = None
        substitutionNotifiedAt = None
        substitutedAt = None
        supersededPolicyholder = None
        premiumDueDate = None
        enforcementCommencedAt = None
        withdrawnAt = None
        withdrawalPath = None
        terminationInstant = None
        unrunDays = None
        mortgageeNotifiedAt = None
        mortgageeContinuationEndsAt = None
        mortgageeElection = None
        mortgageeInfoRequestedAt = None
        mortgageeInfoProvidedAt = None
        status = PS_Active
        defaultState = DS_None
        documentHash = None
        amendmentReason = None

  -- withdrawnAt without withdrawalPath
  submitMustFail insurer do
    createCmd base with
      premiumDueDate = Some now
      withdrawnAt = Some now
      defaultState = DS_WithdrawnForFirstPremium

  -- the withdrawn state without the withdrawal facts
  submitMustFail insurer do
    createCmd base with
      premiumDueDate = Some now
      defaultState = DS_WithdrawnForFirstPremium

  -- either first-premium state without the reported due date
  submitMustFail insurer do
    createCmd base with defaultState = DS_FirstPremiumUnpaid

  -- enforcement reported on a premium that never fell due
  submitMustFail insurer do
    createCmd base with enforcementCommencedAt = Some now

  -- both mechanisms at once
  submitMustFail insurer do
    createCmd base with
      premiumDueDate = Some now
      noticeServiceDate = Some now
      noticeRecordedAt = Some now
      noticeCount = 1
      noticeServiceDates = [now]
      defaultState = DS_FirstPremiumUnpaid

  -- control: the same record with the facts consistent DOES create
  ok <- submit insurer do
    createCmd base with
      premiumDueDate = Some now
      withdrawnAt = Some now
      withdrawalPath = Some WP_InsurerWithdrew
      defaultState = DS_WithdrawnForFirstPremium
  Some created <- queryContractId insurer ok
  assert (created.defaultState == DS_WithdrawnForFirstPremium)

-- ---------------------------------------------------------------------------
-- m. 1421: cover start. Minting no longer means the policy is live.
-- ---------------------------------------------------------------------------

-- A token minted the way the platform now mints one: the contract exists,
-- cover has not begun. mintTestPolicy deliberately does NOT produce this --
-- it mints a live policy, because every test that triggers wants one.
mintWithoutCover : Party -> Party -> Party -> Party -> Script (ContractId PolicyToken)
mintWithoutCover insurer policyholder insured oracleOperator =
  submit insurer do
    createCmd PolicyToken with
      policyNo = "TEST-NO-COVER-YET"
      version = 1
      predecessorRef = None
      insurer
      policyholder
      insured
      beneficiary = None
      beneficiaryDescriptorHash = None
      coverageBeganAt = None            -- the contract exists; cover has not begun
      coverageStartBasis = None
      retroactiveCoverCheckedAt = None
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee = None
      oracleOperator
      coverages = [frostCoverage]
      termStart = time (date 2026 Jan 1) 12 0 0
      expiry = time (date 2026 Dec 31) 12 0 0
      coverageValidThrough = time (date 2026 Dec 31) 12 0 0
      noticeServiceDate = None
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
      defaultState = DS_None
      documentHash = None
      amendmentReason = None

-- A minted policy has no cover until it is reported. This is the change to
-- the original design's assumption, asserted directly.
test_mintedPolicyHasNoCoverUntilReported : Script ()
test_mintedPolicyHasNoCoverUntilReported = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintWithoutCover insurer policyholder insured oracleOperator

  Some policy <- queryContractId insurer policyCid
  assert (isNone policy.coverageBeganAt)
  assert (isNone policy.coverageStartBasis)
  -- The token is otherwise a perfectly ordinary live-looking policy: status
  -- is PS_Active and the term is running. "Active" means the contract
  -- exists, not that cover does.
  assert (policy.status == PS_Active)
  assert (policy.defaultState == DS_None)

-- m. 1421 refuses the trigger, with its own message.
test_triggerRefusedBeforeCoverBegins : Script ()
test_triggerRefusedBeforeCoverBegins = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintWithoutCover insurer policyholder insured oracleOperator
  now <- getTime
  -- The control, minted before the ledger clock moves to the event's end
  -- (v22).
  liveCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]

  reachEventEnd (addRelTime now (days 1))
  submitMustFail oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-before-cover"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

  -- Control: the SAME reading on a policy whose cover has begun pays. The
  -- refusal is the cover state, not the reading.
  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd liveCid PolicyToken_EvaluateTrigger with
      selfContractId = show liveCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "control-reading"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched

-- Reporting payment starts cover at the reported instant, and records why.
test_reportingPaymentStartsCover : Script ()
test_reportingPaymentStartsCover = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintWithoutCover insurer policyholder insured oracleOperator
  now <- getTime
  let paidAt = addRelTime now (days 3)

  -- Captured BEFORE the exercise: RecordFirstPremiumPaid archives and
  -- re-mints, so the original contract id no longer resolves afterwards.
  Some before <- queryContractId insurer policyCid

  -- v22: a payment is reported at or after it was made.
  setTime paidAt
  paidCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordFirstPremiumPaid with paidAt
  Some paid <- queryContractId insurer paidCid
  assert (paid.coverageBeganAt == Some paidAt)
  assert (paid.coverageStartBasis == Some CSB_PremiumPaid)
  assert (paid.defaultState == DS_None)

  -- The term did NOT shift. expiry and termStart are where they were; the
  -- policy simply has less cover than its term suggests, and the gap between
  -- termStart and coverageBeganAt is what makes that legible.
  assert (paid.expiry == before.expiry)
  assert (paid.termStart == before.termStart)
  assert (paid.coverageValidThrough == before.coverageValidThrough)
  -- The gap itself: cover began at an instant of its own, not at the term
  -- start. That difference IS the uncovered stretch, and it is legible
  -- from the contract alone.
  assert (paid.coverageBeganAt /= Some paid.termStart)

  -- And a trigger now works.
  reachEventEnd (addRelTime paidAt (days 1))
  result <- submit oracleOperator do
    exerciseCmd paidCid PolicyToken_EvaluateTrigger with
      selfContractId = show paidCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-after-payment"
      currency = "TRY"
      eventStart = paidAt
      eventEnd = addRelTime paidAt (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched

-- "aksine sözleşme": cover agreed to start without payment. A later payment
-- does NOT restart it -- the earlier instant governs, and the basis records
-- that it was an agreement rather than a payment.
test_agreedStartEarlierThanPaymentIsNotOverwritten : Script ()
test_agreedStartEarlierThanPaymentIsNotOverwritten = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  -- mintTestPolicy mints on the agreed basis at the ledger clock.
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some agreed <- queryContractId insurer policyCid
  assert (agreed.coverageStartBasis == Some CSB_AgreedWithoutPayment)
  let agreedStart = agreed.coverageBeganAt

  -- v22: a payment is reported at or after it was made.
  setTime (addRelTime now (days 20))
  paidCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordFirstPremiumPaid with
      paidAt = addRelTime now (days 20)
  Some paid <- queryContractId insurer paidCid
  assert (paid.coverageBeganAt == agreedStart)                      -- unchanged
  assert (paid.coverageStartBasis == Some CSB_AgreedWithoutPayment) -- and why

-- The direction guard. m. 1452(3) forbids varying m. 1421 to the insured's
-- detriment, so an agreed start LATER than payment -- leaving them paying for
-- a gap the Code's default would have covered -- is refused.
test_agreedStartLaterThanPaymentIsRejected : Script ()
test_agreedStartLaterThanPaymentIsRejected = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some agreed <- queryContractId insurer policyCid

  -- Payment reported BEFORE the agreed start.
  submitMustFail insurer do
    exerciseCmd policyCid PolicyToken_RecordFirstPremiumPaid with
      paidAt = addRelTime now (days (-30))

  -- Control: payment on or after the agreed start is fine.
  -- v22: a payment is reported at or after it was made.
  setTime (addRelTime now (days 30))
  ok <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordFirstPremiumPaid with
      paidAt = addRelTime now (days 30)
  Some paid <- queryContractId insurer ok
  assert (paid.coverageBeganAt == agreed.coverageBeganAt)

-- ensure: the instant and its reason are set together, and cover cannot
-- begin after the term ends.
test_coverStartEnsureGuards : Script ()
test_coverStartEnsureGuards = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let base = PolicyToken with
        policyNo = "TEST-COVER-ENSURE"
        version = 1
        predecessorRef = None
        insurer
        policyholder
        insured
        beneficiary = None
        beneficiaryDescriptorHash = None
        coverageBeganAt = None
        coverageStartBasis = None
        retroactiveCoverCheckedAt = None
        enforcementFruitlessAt = None
        enforcementRoute = None
        substitutionNotifiedAt = None
        substitutedAt = None
        supersededPolicyholder = None
        premiumDueDate = None
        enforcementCommencedAt = None
        withdrawnAt = None
        withdrawalPath = None
        mortgagee = None
        oracleOperator
        coverages = [frostCoverage]
        termStart = time (date 2026 Jan 1) 12 0 0
        expiry = time (date 2026 Dec 31) 12 0 0
        coverageValidThrough = time (date 2026 Dec 31) 12 0 0
        noticeServiceDate = None
        noticeRecordedAt = None
        noticeCount = 0
        noticeServiceDates = []
        twoNoticeElectionAt = None
        twoNoticeEffectiveAt = None
        terminationInstant = None
        unrunDays = None
        mortgageeNotifiedAt = None
        mortgageeContinuationEndsAt = None
        mortgageeElection = None
        mortgageeInfoRequestedAt = None
        mortgageeInfoProvidedAt = None
        status = PS_Active
        defaultState = DS_None
        documentHash = None
        amendmentReason = None

  -- an instant with no reason
  submitMustFail insurer do
    createCmd base with coverageBeganAt = Some (time (date 2026 Mar 1) 12 0 0)
  -- a reason with no instant
  submitMustFail insurer do
    createCmd base with coverageStartBasis = Some CSB_PremiumPaid
  -- cover beginning after the term ends
  submitMustFail insurer do
    createCmd base with
      coverageBeganAt = Some (time (date 2027 Jun 1) 12 0 0)
      coverageStartBasis = Some CSB_PremiumPaid
      retroactiveCoverCheckedAt = None

  -- control: consistent, and it creates
  ok <- submit insurer do
    createCmd base with
      coverageBeganAt = Some (time (date 2026 Mar 1) 12 0 0)
      coverageStartBasis = Some CSB_PremiumPaid
      retroactiveCoverCheckedAt = None
  Some created <- queryContractId insurer ok
  assert (created.coverageStartBasis == Some CSB_PremiumPaid)

-- m. 1421 and m. 1434(2) COMPOSE rather than duplicate: an unpaid first
-- premium is both "cover not begun" and, once the due date is reported, a
-- withdrawal candidate. Reporting payment resolves both at once.
test_coverStartComposesWithFirstPremiumDefault : Script ()
test_coverStartComposesWithFirstPremiumDefault = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintWithoutCover insurer policyholder insured oracleOperator
  now <- getTime
  let dueDate = addRelTime now (days (-30))

  unpaidCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordPremiumDueDate with dueDate
  Some unpaid <- queryContractId insurer unpaidCid
  -- Both facts are true of this policy at once, and they are separate fields.
  assert (unpaid.defaultState == DS_FirstPremiumUnpaid)
  assert (isNone unpaid.coverageBeganAt)

  -- One report settles both: cover begins AND the default clears.
  paidCid <- submit insurer do
    exerciseCmd unpaidCid PolicyToken_RecordFirstPremiumPaid with paidAt = now
  Some paid <- queryContractId insurer paidCid
  assert (paid.defaultState == DS_None)
  assert (paid.coverageBeganAt == Some now)
  assert (paid.coverageStartBasis == Some CSB_PremiumPaid)
  -- The due date stays: a fact about what happened.
  assert (paid.premiumDueDate == Some dueDate)

  -- Withdrawal is no longer available, because the default is cleared.
  submitMustFail insurer do
    exerciseCmd paidCid PolicyToken_WithdrawForFirstPremium with
      withdrawnAt = now
      path = WP_InsurerWithdrew

-- m. 1458: the retroactive-cover check is performed OFF the ledger, against
-- the platform's own oracle history, so the token carries only the fact that
-- it ran. What the ledger has to hold up is therefore narrow and exact: the
-- timestamp cannot exist without a cover start to have checked, and it must
-- not be lost when the token is re-minted.

-- ensure: a check timestamp with no cover start is incoherent. There is no
-- backdated window to have searched, so the token refuses to record one.
test_retroactiveCheckEnsureGuard : Script ()
test_retroactiveCheckEnsureGuard = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let base = PolicyToken with
        policyNo = "TEST-RETRO-ENSURE"
        version = 1
        predecessorRef = None
        insurer
        policyholder
        insured
        beneficiary = None
        beneficiaryDescriptorHash = None
        coverageBeganAt = None
        coverageStartBasis = None
        retroactiveCoverCheckedAt = None
        enforcementFruitlessAt = None
        enforcementRoute = None
        substitutionNotifiedAt = None
        substitutedAt = None
        supersededPolicyholder = None
        premiumDueDate = None
        enforcementCommencedAt = None
        withdrawnAt = None
        withdrawalPath = None
        mortgagee = None
        oracleOperator
        coverages = [frostCoverage]
        termStart = time (date 2026 Jan 1) 12 0 0
        expiry = time (date 2026 Dec 31) 12 0 0
        coverageValidThrough = time (date 2026 Dec 31) 12 0 0
        noticeServiceDate = None
        noticeRecordedAt = None
        noticeCount = 0
        noticeServiceDates = []
        twoNoticeElectionAt = None
        twoNoticeEffectiveAt = None
        terminationInstant = None
        unrunDays = None
        mortgageeNotifiedAt = None
        mortgageeContinuationEndsAt = None
        mortgageeElection = None
        mortgageeInfoRequestedAt = None
        mortgageeInfoProvidedAt = None
        status = PS_Active
        defaultState = DS_None
        documentHash = None
        amendmentReason = None

  -- a check that "ran" against a policy with no cover start at all
  submitMustFail insurer do
    createCmd base with
      retroactiveCoverCheckedAt = Some (time (date 2026 Feb 1) 12 0 0)

  -- Control: with a cover start present, the same timestamp creates. This is
  -- what a backdated policy that passed the check looks like.
  ok <- submit insurer do
    createCmd base with
      coverageBeganAt = Some (time (date 2026 Mar 1) 12 0 0)
      coverageStartBasis = Some CSB_AgreedWithoutPayment
      retroactiveCoverCheckedAt = Some (time (date 2026 Feb 1) 12 0 0)
  Some created <- queryContractId insurer ok
  assert (created.retroactiveCoverCheckedAt == Some (time (date 2026 Feb 1) 12 0 0))

  -- And a policy that needed no check still mints with the field empty --
  -- the ordinary forward-dated case, which is most of them.
  plain <- submit insurer do
    createCmd base with
      coverageBeganAt = Some (time (date 2026 Mar 1) 12 0 0)
      coverageStartBasis = Some CSB_AgreedWithoutPayment
  Some created2 <- queryContractId insurer plain
  assert (isNone created2.retroactiveCoverCheckedAt)

-- The token is re-minted by every lifecycle choice, and a check timestamp
-- that vanished on the first of them would leave a policy whose ledger
-- record no longer says a check was ever performed. The whole point of
-- putting it on the ledger is that it survives.
test_retroactiveCheckSurvivesRemint : Script ()
test_retroactiveCheckSurvivesRemint = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  let checkedAt = addRelTime now (days (-30))

  policyCid <- submit insurer do
    createCmd PolicyToken with
      policyNo = "TEST-RETRO-REMINT"
      version = 1
      predecessorRef = None
      insurer
      policyholder
      insured
      beneficiary = None
      beneficiaryDescriptorHash = None
      -- Backdated: cover began before the check ran, which is the shape the
      -- dispatcher only ever produces after a passing check.
      coverageBeganAt = Some (addRelTime now (days (-60)))
      coverageStartBasis = Some CSB_AgreedWithoutPayment
      retroactiveCoverCheckedAt = Some checkedAt
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee = None
      oracleOperator
      coverages = [frostCoverage]
      termStart = time (date 2026 Jan 1) 12 0 0
      expiry = time (date 2026 Dec 31) 12 0 0
      coverageValidThrough = time (date 2026 Dec 31) 12 0 0
      noticeServiceDate = None
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
      defaultState = DS_None
      documentHash = None
      amendmentReason = None

  -- A partial payout re-mints the token.
  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-retro"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched
  Some paidCid <- pure result.newPolicyCid
  Some afterPayout <- queryContractId insurer paidCid
  assert (afterPayout.retroactiveCoverCheckedAt == Some checkedAt)

  -- So does an endorsement, on a different code path.
  amendedCid <- submit insurer do
    exerciseCmd paidCid amendNothing with
      reason = ER_SumInsuredIncrease
      sumInsuredChanges = [("FROST", 120000.0)]
  Some amended <- queryContractId insurer amendedCid
  assert (amended.retroactiveCoverCheckedAt == Some checkedAt)

  -- And so does the premium-default path, which rewrites unrelated fields.
  noticedCid <- submit insurer do
    exerciseCmd amendedCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  Some noticed <- queryContractId insurer noticedCid
  assert (noticed.retroactiveCoverCheckedAt == Some checkedAt)

-- ---------------------------------------------------------------------------
-- m. 1456: routing a payout between the mortgagee and the insured
-- ---------------------------------------------------------------------------
--
-- m. 1456(1) continues the sınırlı ayni hak over the sigorta tazminatı, so a
-- payout from the coverage the charge sits on is owed to the bank up to its
-- remaining claim. What is NOT automated is the excess: m. 1456(2) forbids
-- paying the sigortalı without izin and offers no surplus carve-out, so the
-- remainder is recorded for a human rather than routed.

-- The same frost coverage, with a bank's charge on it.
chargedCoverage : Decimal -> Coverage
chargedCoverage claim = frostCoverage with
  payoutDestination = [PDR_Insured, PDR_Mortgagee]
  mortgageeClaimAmount = Some claim
  attachedAt = None
  attachmentLiftedAt = None

-- A -2.0 reading pays 25% of 100000 = 25000 on this fixture.
mildTrigger : Party -> ContractId PolicyToken -> Text -> Script EvaluateTriggerResult
mildTrigger oracleOperator cid ref = do
  now <- getTime
  reachEventEnd (addRelTime now (days 1))
  submit oracleOperator do
    exerciseCmd cid PolicyToken_EvaluateTrigger with
      selfContractId = show cid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = ref
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

claimOn : PolicyToken -> Optional Decimal
claimOn p = case find (\c -> c.coverageCode == "FROST") p.coverages of
  Some c -> c.mortgageeClaimAmount
  None -> None

-- A payout smaller than the claim goes WHOLLY to the bank. One leg, no
-- remainder, and nothing for a human to look at.
test_payoutBelowClaimGoesEntirelyToMortgagee : Script ()
test_payoutBelowClaimGoesEntirelyToMortgagee = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [chargedCoverage 40000.0]

  result <- mildTrigger oracleOperator policyCid "below-claim"
  assert result.trigger.matched
  assert (result.trigger.payoutAmount == 25000.0)

  [leg] <- pure result.payouts
  assert (leg.recipient == PDR_Mortgagee)
  assert (leg.amount == 25000.0)
  assert (isNone result.unroutedRemainder)

  Some payout <- queryContractId insurer leg.cid
  assert (payout.recipient == PDR_Mortgagee)
  assert (payout.amount == 25000.0)
  assert (payout.mortgagee == Some bank)
  -- The bank can actually see what it is owed. A party that is neither
  -- signatory nor observer cannot fetch the contract at all.
  Some seenByBank <- queryContractId bank leg.cid
  assert (seenByBank.amount == 25000.0)

  -- The claim decrements by what was routed, exactly as remainingLimit does.
  Some newPolicyCid <- pure result.newPolicyCid
  Some reminted <- queryContractId insurer newPolicyCid
  assert (claimOn reminted == Some 15000.0)

-- A payout larger than the claim pays the bank its claim and stops. The
-- excess is NOT a second contract -- it is recorded and left for a human.
test_payoutAboveClaimLeavesRemainderForReview : Script ()
test_payoutAboveClaimLeavesRemainderForReview = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [chargedCoverage 10000.0]

  result <- mildTrigger oracleOperator policyCid "above-claim"
  [leg] <- pure result.payouts
  assert (leg.recipient == PDR_Mortgagee)
  assert (leg.amount == 10000.0)

  -- Exactly ONE PayoutApproved exists. The insured's share is not one.
  Some remainder <- pure result.unroutedRemainder
  assert (remainder.amount == 15000.0)
  Some review <- queryContractId insurer remainder.reviewCid
  assert (review.amount == 15000.0)
  assert (review.coverageCode == "FROST")
  -- A remainder has no source payout -- it never became one.
  assert (review.sourcePayoutContractId == "")

  Some newPolicyCid <- pure result.newPolicyCid
  Some reminted <- queryContractId insurer newPolicyCid
  assert (claimOn reminted == Some 0.0)

-- No charge on the coverage means no ayni hak to continue over the
-- indemnity, so this is the ordinary path and is untouched.
test_unchargedCoverageStillPaysTheInsured : Script ()
test_unchargedCoverageStillPaysTheInsured = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  -- A mortgagee on the POLICY, but no claim on this coverage.
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [frostCoverage]

  result <- mildTrigger oracleOperator policyCid "uncharged"
  [leg] <- pure result.payouts
  assert (leg.recipient == PDR_Insured)
  assert (leg.amount == 25000.0)
  assert (isNone result.unroutedRemainder)

  Some payout <- queryContractId insurer leg.cid
  -- The bank is not an observer of a leg that is not its own.
  assert (isNone payout.mortgagee)
  bankView <- queryContractId bank leg.cid
  assert (isNone bankView)

-- The claim runs down across successive payouts and stops routing once it is
-- gone. Ordering must not decide what the arithmetic was not allowed to: the
-- payout after exhaustion is the same surplus by another name, and goes to
-- review rather than to the insured.
test_claimDecrementsAcrossPayoutsThenStops : Script ()
test_claimDecrementsAcrossPayoutsThenStops = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [chargedCoverage 30000.0]

  -- First: 25000 of a 30000 claim.
  r1 <- mildTrigger oracleOperator policyCid "first"
  [leg1] <- pure r1.payouts
  assert (leg1.recipient == PDR_Mortgagee && leg1.amount == 25000.0)
  assert (isNone r1.unroutedRemainder)
  Some cid2 <- pure r1.newPolicyCid
  Some p2 <- queryContractId insurer cid2
  assert (claimOn p2 == Some 5000.0)

  -- Second: 25% of the REMAINING limit (75000), so 18750 -- the tier pays a
  -- percentage of what is left, not of the sum insured. Only 5000 of the
  -- claim survives, so 13750 is unrouted.
  r2 <- mildTrigger oracleOperator cid2 "second"
  [leg2] <- pure r2.payouts
  assert (leg2.recipient == PDR_Mortgagee && leg2.amount == 5000.0)
  Some rem2 <- pure r2.unroutedRemainder
  assert (rem2.amount == 13750.0)
  Some cid3 <- pure r2.newPolicyCid
  Some p3 <- queryContractId insurer cid3
  assert (claimOn p3 == Some 0.0)

  -- Third: the claim is exhausted. No leg at all, and the whole payout is
  -- unrouted -- NOT quietly redirected to the insured.
  r3 <- mildTrigger oracleOperator cid3 "third"
  assert (null r3.payouts)
  Some rem3 <- pure r3.unroutedRemainder
  assert (rem3.amount == 14062.50)
  Some cid4 <- pure r3.newPolicyCid
  Some p4 <- queryContractId insurer cid4
  -- Still Some 0.0, never back to None: "charged and exhausted" is a
  -- different fact from "never charged", and they route differently.
  assert (claimOn p4 == Some 0.0)

-- A mortgagee leg settles through the same path as any other payout, and a
-- settlement claiming to have paid someone else is refused.
test_mortgageeLegSettlesAndOnlyAsItsOwnRecipient : Script ()
test_mortgageeLegSettlesAndOnlyAsItsOwnRecipient = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [chargedCoverage 40000.0]
  result <- mildTrigger oracleOperator policyCid "settle"
  [leg] <- pure result.payouts
  now <- getTime

  -- The coverage permits both roles, so payoutDestination alone would let
  -- this through. The recipient check is what stops it.
  submitMustFail insurer do
    exerciseCmd leg.cid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured

  _ <- submit insurer do
    exerciseCmd leg.cid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Mortgagee
  pure ()

-- A mortgagee leg can fail and be resolved on its own, independently of
-- anything else the trigger produced.
test_mortgageeLegFailsAndResolvesIndependently : Script ()
test_mortgageeLegFailsAndResolvesIndependently = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [chargedCoverage 10000.0]
  result <- mildTrigger oracleOperator policyCid "fail"
  [leg] <- pure result.payouts
  Some remainder <- pure result.unroutedRemainder
  now <- getTime

  reviewCid <- submit insurer do
    exerciseCmd leg.cid PayoutApproved_MarkFailed with
      failureReason = "payee could not be reached"
      sourcePayoutContractId = "cid-placeholder"
  submit insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Other
      note = testTextDigest
      closedAt = now

  -- The remainder's own review item is untouched by that, and resolves
  -- separately. Two obligations, two outcomes.
  Some stillOpen <- queryContractId insurer remainder.reviewCid
  assert (stillOpen.amount == 15000.0)
  _ <- submit insurer do
    exerciseCmd remainder.reviewCid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Other
      note = testTextDigest
      closedAt = now
  pure ()

-- The whole of the above is inert on a policy with no mortgagee at all.
test_policyWithNoMortgageeIsUnchanged : Script ()
test_policyWithNoMortgageeIsUnchanged = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None
    [frostCoverage]

  result <- mildTrigger oracleOperator policyCid "no-mortgagee"
  [leg] <- pure result.payouts
  assert (leg.recipient == PDR_Insured)
  assert (leg.amount == 25000.0)
  assert (isNone result.unroutedRemainder)
  Some payout <- queryContractId insurer leg.cid
  assert (isNone payout.mortgagee)

-- ensure: a leg is owed to exactly one recipient, and the mortgagee party is
-- present on precisely the legs that are the mortgagee's.
test_payoutRecipientAndMortgageeMustAgree : Script ()
test_payoutRecipientAndMortgageeMustAgree = script do
  (insurer, policyholder, _, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  now <- getTime
  let base = PayoutApproved with
        insurer
        policyholder
        oracleOperator
        policyId = "TEST-RECIPIENT"
        coverageCode = "FROST"
        sourcePolicyContractId = "n/a"
        amount = 1000.0
        recipient = PDR_Insured
        mortgagee = None
        currency = "TRY"
        payoutPercentage = 25.0
        tierLabel = "t"
        isFullSettlement = False
        payoutDestination = [PDR_Insured, PDR_Mortgagee]
        approvedAt = now
        eventStart = now
        eventEnd = addRelTime now (days 1)
        evidenceDigest = testEvidenceDigest

  -- a mortgagee leg with nobody to pay
  submitMustFail (actAs [insurer, oracleOperator]) do
    createCmd base with recipient = PDR_Mortgagee, mortgagee = None
  -- a mortgagee party on a leg that is not the mortgagee's
  submitMustFail (actAs [insurer, oracleOperator]) do
    createCmd base with recipient = PDR_Insured, mortgagee = Some bank
  -- a recipient the coverage does not permit
  submitMustFail (actAs [insurer, oracleOperator]) do
    createCmd base with recipient = PDR_Beneficiary, payoutDestination = [PDR_Insured]

  -- control: both consistent shapes create. Every submit here acts as BOTH
  -- signatories, because PayoutApproved is signed by insurer AND
  -- oracleOperator -- the submitMustFail cases above would otherwise pass on
  -- a missing authorization and prove nothing about the ensure clause.
  _ <- submit (actAs [insurer, oracleOperator]) do createCmd base
  _ <- submit (actAs [insurer, oracleOperator]) do
    createCmd base with recipient = PDR_Mortgagee, mortgagee = Some bank
  pure ()

-- ---------------------------------------------------------------------------
-- m. 1431(4): policyholder substitution
-- ---------------------------------------------------------------------------
--
-- The only mechanism in this system that changes who a party is. Three
-- externally reported facts in one order -- enforcement fruitless, insurer's
-- notification, the sigortali's undertaking -- and then "sozlesme bu
-- kisilerle devam eder": the contract continues WITH the sigortali.

-- A policy genuinely taken for another's account: the sigortali is a party
-- distinct from the sigorta ettiren, which is what m. 1454 makes possible and
-- what m. 1431(4) needs.
mintForAnothersAccount : Party -> Party -> Party -> Party -> Script (ContractId PolicyToken)
mintForAnothersAccount insurer policyholder insured oracleOperator =
  mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]

-- Drives the two facts that must precede an assumption.
reachNotified : Party -> ContractId PolicyToken -> Script (ContractId PolicyToken)
reachNotified insurer cid = do
  now <- getTime
  fruitless <- submit insurer do
    exerciseCmd cid PolicyToken_RecordEnforcementFruitless with
      fruitlessAt = addRelTime now (days (-20))
      route = ER_Takip
  submit insurer do
    exerciseCmd fruitless PolicyToken_RecordSubstitutionNotice with
      notifiedAt = addRelTime now (days (-10))

test_substitutionNeedsBothPrecedingFacts : Script ()
test_substitutionNeedsBothPrecedingFacts = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintForAnothersAccount insurer policyholder insured oracleOperator
  now <- getTime

  -- Nothing reported yet: the assumption is refused.
  submitMustFail insurer do
    exerciseCmd policyCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now
  -- And so is the notification, which has its own predecessor.
  submitMustFail insurer do
    exerciseCmd policyCid PolicyToken_RecordSubstitutionNotice with
      notifiedAt = now

  -- Fruitlessness alone is still not enough.
  fruitlessCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordEnforcementFruitless with
      fruitlessAt = addRelTime now (days (-20))
      route = ER_Takip
  Some afterFruitless <- queryContractId insurer fruitlessCid
  assert (afterFruitless.enforcementRoute == Some ER_Takip)
  assert (isNone afterFruitless.substitutionNotifiedAt)
  submitMustFail insurer do
    exerciseCmd fruitlessCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now

  -- Both reported: it goes through.
  notifiedCid <- submit insurer do
    exerciseCmd fruitlessCid PolicyToken_RecordSubstitutionNotice with
      notifiedAt = addRelTime now (days (-10))
  substitutedCid <- submit insurer do
    exerciseCmd notifiedCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now
  Some after <- queryContractId insurer substitutedCid
  assert (after.substitutedAt == Some now)

test_substitutionMovesTheParty : Script ()
test_substitutionMovesTheParty = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintForAnothersAccount insurer policyholder insured oracleOperator
  notifiedCid <- reachNotified insurer policyCid
  now <- getTime

  substitutedCid <- submit insurer do
    exerciseCmd notifiedCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now
  Some after <- queryContractId insurer substitutedCid

  -- "sozlesme bu kisilerle devam eder": the contract continues WITH the
  -- sigortali, so the counterparty is now that person.
  assert (after.policyholder == insured)
  assert (after.insured == insured)
  -- And who was superseded is on the record.
  assert (after.supersededPolicyholder == Some policyholder)
  -- The premium is exactly as unpaid as it was: an undertaking is not a
  -- payment, and nothing here records an amount.
  assert (after.defaultState == DS_None)

  -- The superseded party is no longer an observer -- it is no longer a party.
  oldPartyView <- queryContractId policyholder substitutedCid
  assert (isNone oldPartyView)
  -- The new one can see the contract it is now party to.
  Some newPartyView <- queryContractId insured substitutedCid
  assert (newPartyView.policyholder == insured)

test_substitutionCannotHappenTwiceOrOnOwnAccount : Script ()
test_substitutionCannotHappenTwiceOrOnOwnAccount = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime

  -- A policy on its own account was never "baskasi lehine yapilan" and has
  -- nobody to substitute in. Refused at the very first fact.
  ownAccountCid <- mintTestPolicy insurer policyholder policyholder oracleOperator None None [frostCoverage]
  submitMustFail insurer do
    exerciseCmd ownAccountCid PolicyToken_RecordEnforcementFruitless with
      fruitlessAt = addRelTime now (days (-20))
      route = ER_Takip
  submitMustFail insurer do
    exerciseCmd ownAccountCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now

  -- Once substituted, the paragraph is spent: the two roles are held by one
  -- person, so there is no distinct sigortali left to substitute in.
  policyCid <- mintForAnothersAccount insurer policyholder insured oracleOperator
  notifiedCid <- reachNotified insurer policyCid
  substitutedCid <- submit insurer do
    exerciseCmd notifiedCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now
  submitMustFail insurer do
    exerciseCmd substitutedCid PolicyToken_RecordEnforcementFruitless with
      fruitlessAt = now
      route = ER_Dava
  submitMustFail insurer do
    exerciseCmd substitutedCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now

-- THE FREEZE. m. 1431(4)'s "sozlesme bu kisilerle devam eder" cannot coexist
-- with m. 1434(3)'s "sozlesme feshedilmis olur", so a substitution during a
-- running notice period stops that termination completing. The clock is not
-- reset and not cleared -- the notice facts stay exactly where they were.
test_substitutionFreezesARunningTermination : Script ()
test_substitutionFreezesARunningTermination = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintForAnothersAccount insurer policyholder insured oracleOperator
  now <- getTime

  noticedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = addRelTime now (days (-30))
      noticeRecordedAt = addRelTime now (days (-30))
  Some noticed <- queryContractId insurer noticedCid
  assert (noticed.defaultState == DS_GracePeriod)

  -- A control FIRST: without a substitution this policy terminates normally.
  -- Otherwise the refusal below would prove nothing about substitution.
  _ <- submit insurer do
    exerciseCmd noticedCid PolicyToken_Terminate with
      terminationInstant = now
      unrunDays = 100
      mortgageeContinuationEndsAt = None

  -- The real case, on a fresh policy taken to the same point.
  policyCid2 <- mintForAnothersAccount insurer policyholder insured oracleOperator
  noticedCid2 <- submit insurer do
    exerciseCmd policyCid2 PolicyToken_ServeNotice with
      noticeServiceDate = addRelTime now (days (-30))
      noticeRecordedAt = addRelTime now (days (-30))
  notifiedCid2 <- reachNotified insurer noticedCid2
  substitutedCid <- submit insurer do
    exerciseCmd notifiedCid2 PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now

  Some after <- queryContractId insurer substitutedCid
  -- The default axis is untouched: the premium is still unpaid.
  assert (after.defaultState == DS_GracePeriod)
  -- The notice facts are untouched too -- frozen, not reset.
  assert (after.noticeServiceDate == Some (addRelTime now (days (-30))))
  assert (after.noticeCount == 1)

  -- And the termination cannot complete.
  submitMustFail insurer do
    exerciseCmd substitutedCid PolicyToken_Terminate with
      terminationInstant = now
      unrunDays = 100
      mortgageeContinuationEndsAt = None

-- The first-premium mechanism reaches substitution by its own route, and a
-- contract that has already ended cannot be taken over at all.
test_substitutionAndTheFirstPremiumMechanism : Script ()
test_substitutionAndTheFirstPremiumMechanism = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintForAnothersAccount insurer policyholder insured oracleOperator
  now <- getTime

  dueCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordPremiumDueDate with
      dueDate = addRelTime now (days (-60))
  Some due <- queryContractId insurer dueCid
  assert (due.defaultState == DS_FirstPremiumUnpaid)

  -- Substitution is reachable out of this mechanism too: enforcement
  -- presupposes a due and unpaid premium, and both mechanisms produce one.
  notifiedCid <- reachNotified insurer dueCid
  substitutedCid <- submit insurer do
    exerciseCmd notifiedCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now
  Some after <- queryContractId insurer substitutedCid
  assert (after.policyholder == insured)
  -- Untouched, again: the first premium is still unpaid.
  assert (after.defaultState == DS_FirstPremiumUnpaid)

  -- But once the contract has ended there is nothing left to continue.
  policyCid2 <- mintForAnothersAccount insurer policyholder insured oracleOperator
  dueCid2 <- submit insurer do
    exerciseCmd policyCid2 PolicyToken_RecordPremiumDueDate with
      dueDate = addRelTime now (days (-60))
  notifiedCid2 <- reachNotified insurer dueCid2
  withdrawnCid <- submit insurer do
    exerciseCmd notifiedCid2 PolicyToken_WithdrawForFirstPremium with
      withdrawnAt = now
      path = WP_InsurerWithdrew
  submitMustFail insurer do
    exerciseCmd withdrawnCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now

-- The same for a contract terminated under m. 1434(3), and for reporting
-- enforcement fruitless on a contract that has ended either way.
test_endedContractRefusesFruitlessEnforcementAndSubstitution : Script ()
test_endedContractRefusesFruitlessEnforcementAndSubstitution = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintForAnothersAccount insurer policyholder insured oracleOperator
  now <- getTime

  -- control: during the notice period the contract has not ended, so both
  -- preceding facts can be reported on it
  noticedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = addRelTime now (days (-30))
      noticeRecordedAt = addRelTime now (days (-30))
  notifiedCid <- reachNotified insurer noticedCid
  terminatedCid <- submit insurer do
    exerciseCmd notifiedCid PolicyToken_Terminate with
      terminationInstant = now
      unrunDays = 100
      mortgageeContinuationEndsAt = None

  -- Terminated: every fact the takeover needs is recorded, and it is still
  -- refused -- there is no contract left to continue.
  submitMustFail insurer do
    exerciseCmd terminatedCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = now
  submitMustFail insurer do
    exerciseCmd terminatedCid PolicyToken_RecordEnforcementFruitless with
      fruitlessAt = now
      route = ER_Dava

  -- Withdrawn under m. 1434(2): enforcement cannot be reported fruitless.
  policyCid2 <- mintForAnothersAccount insurer policyholder insured oracleOperator
  dueCid2 <- submit insurer do
    exerciseCmd policyCid2 PolicyToken_RecordPremiumDueDate with
      dueDate = addRelTime now (days (-60))
  withdrawnCid <- submit insurer do
    exerciseCmd dueCid2 PolicyToken_WithdrawForFirstPremium with
      withdrawnAt = now
      path = WP_InsurerWithdrew
  submitMustFail insurer do
    exerciseCmd withdrawnCid PolicyToken_RecordEnforcementFruitless with
      fruitlessAt = now
      route = ER_Takip

-- ensure: the three facts cannot be written onto a token out of order, so
-- the sequence cannot be bypassed by creating one directly.
test_substitutionEnsureGuards : Script ()
test_substitutionEnsureGuards = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  let base = PolicyToken with
        policyNo = "TEST-SUBST-ENSURE"
        version = 1
        predecessorRef = None
        insurer
        policyholder
        insured
        beneficiary = None
        beneficiaryDescriptorHash = None
        coverageBeganAt = Some now
        coverageStartBasis = Some CSB_AgreedWithoutPayment
        retroactiveCoverCheckedAt = None
        enforcementFruitlessAt = None
        enforcementRoute = None
        substitutionNotifiedAt = None
        substitutedAt = None
        supersededPolicyholder = None
        premiumDueDate = None
        enforcementCommencedAt = None
        withdrawnAt = None
        withdrawalPath = None
        mortgagee = None
        oracleOperator
        coverages = [frostCoverage]
        termStart = time (date 2026 Jan 1) 12 0 0
        expiry = time (date 2026 Dec 31) 12 0 0
        coverageValidThrough = time (date 2026 Dec 31) 12 0 0
        noticeServiceDate = None
        noticeRecordedAt = None
        noticeCount = 0
        noticeServiceDates = []
        twoNoticeElectionAt = None
        twoNoticeEffectiveAt = None
        terminationInstant = None
        unrunDays = None
        mortgageeNotifiedAt = None
        mortgageeContinuationEndsAt = None
        mortgageeElection = None
        mortgageeInfoRequestedAt = None
        mortgageeInfoProvidedAt = None
        status = PS_Active
        defaultState = DS_None
        documentHash = None
        amendmentReason = None

  -- an instant with no route, and a route with no instant
  submitMustFail insurer do
    createCmd base with enforcementFruitlessAt = Some now
  submitMustFail insurer do
    createCmd base with enforcementRoute = Some ER_Takip
  -- a notification with no fruitlessness before it
  submitMustFail insurer do
    createCmd base with substitutionNotifiedAt = Some now
  -- a substitution with no notification before it
  submitMustFail insurer do
    createCmd base with
      enforcementFruitlessAt = Some now
      enforcementRoute = Some ER_Takip
      substitutedAt = Some now
      supersededPolicyholder = Some policyholder
      policyholder = insured
  -- a substitution that did not move the party
  submitMustFail insurer do
    createCmd base with
      enforcementFruitlessAt = Some now
      enforcementRoute = Some ER_Takip
      substitutionNotifiedAt = Some now
      substitutedAt = Some now
      supersededPolicyholder = Some policyholder
  -- a superseded party with no substitution instant
  submitMustFail insurer do
    createCmd base with supersededPolicyholder = Some policyholder

  -- control: the full, ordered, consistent shape creates
  ok <- submit insurer do
    createCmd base with
      enforcementFruitlessAt = Some now
      enforcementRoute = Some ER_Takip
      substitutionNotifiedAt = Some now
      substitutedAt = Some now
      supersededPolicyholder = Some policyholder
      policyholder = insured
  Some created <- queryContractId insurer ok
  assert (created.policyholder == created.insured)

-- ---------------------------------------------------------------------------
-- m. 1456(6): the mortgagee's information request, and the insurer's response
-- ---------------------------------------------------------------------------
--
-- "Sigortaci, ISTEM UZERINE, sinirli ayni hak sahibi oldugunu bildiren kisiye
-- sigorta korumasi ile sigorta bedelinin miktari hakkinda BILGI VERIR."
--
-- The information was never missing -- a named mortgagee observes this token
-- and can read the cover and the sum insured whenever it likes. What these
-- record is the ACT: a request was made, and it was answered.

mintWithBank : Party -> Party -> Party -> Party -> Party -> Script (ContractId PolicyToken)
mintWithBank insurer policyholder insured oracleOperator bank =
  mintTestPolicy insurer policyholder insured oracleOperator None (Some bank) [frostCoverage]

test_mortgageeInfoRequestAndResponse : Script ()
test_mortgageeInfoRequestAndResponse = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintWithBank insurer policyholder insured oracleOperator bank
  now <- getTime

  -- A response with nothing to respond to is refused.
  submitMustFail insurer do
    exerciseCmd policyCid PolicyToken_RecordMortgageeInfoProvided with
      providedAt = now

  requestedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordMortgageeInfoRequest with
      requestedAt = addRelTime now (days (-5))
  Some requested <- queryContractId insurer requestedCid
  assert (requested.mortgageeInfoRequestedAt == Some (addRelTime now (days (-5))))
  assert (isNone requested.mortgageeInfoProvidedAt)
  -- The bank can see that its own request was recorded: it already observes
  -- this token, which is how it reads the cover and the sum insured too.
  Some seenByBank <- queryContractId bank requestedCid
  assert (isSome seenByBank.mortgageeInfoRequestedAt)

  providedCid <- submit insurer do
    exerciseCmd requestedCid PolicyToken_RecordMortgageeInfoProvided with
      providedAt = addRelTime now (days (-4))
  Some provided <- queryContractId insurer providedCid
  assert (provided.mortgageeInfoProvidedAt == Some (addRelTime now (days (-4))))
  -- The request date stays: it is the fact the duty runs from.
  assert (provided.mortgageeInfoRequestedAt == Some (addRelTime now (days (-5))))

  -- Answering twice is refused -- there is nothing outstanding.
  submitMustFail insurer do
    exerciseCmd providedCid PolicyToken_RecordMortgageeInfoProvided with
      providedAt = now

test_mortgageeInfoSecondRequestRefusedWhileOutstanding : Script ()
test_mortgageeInfoSecondRequestRefusedWhileOutstanding = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintWithBank insurer policyholder insured oracleOperator bank
  now <- getTime

  requestedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordMortgageeInfoRequest with
      requestedAt = addRelTime now (days (-5))
  -- A second request while the first is unanswered would overwrite the date
  -- the duty runs from, and the unanswered one is the point of recording it.
  submitMustFail insurer do
    exerciseCmd requestedCid PolicyToken_RecordMortgageeInfoRequest with
      requestedAt = addRelTime now (days (-3))

  -- Once answered, the bank may ask again -- there is no limit in the text
  -- and no reason to invent one.
  providedCid <- submit insurer do
    exerciseCmd requestedCid PolicyToken_RecordMortgageeInfoProvided with
      providedAt = addRelTime now (days (-4))
  againCid <- submit insurer do
    exerciseCmd providedCid PolicyToken_RecordMortgageeInfoRequest with
      requestedAt = addRelTime now (days (-2))
  Some again <- queryContractId insurer againCid
  -- Outstanding again: the later request leaves the older response behind it,
  -- which is exactly how the state is expressed.
  assert (again.mortgageeInfoRequestedAt == Some (addRelTime now (days (-2))))
  assert (again.mortgageeInfoProvidedAt == Some (addRelTime now (days (-4))))
  submitMustFail insurer do
    exerciseCmd againCid PolicyToken_RecordMortgageeInfoRequest with
      requestedAt = now
  -- And it can be answered again.
  _ <- submit insurer do
    exerciseCmd againCid PolicyToken_RecordMortgageeInfoProvided with
      providedAt = now
  pure ()

test_mortgageeInfoNeedsAMortgageeAndAnOrderedPair : Script ()
test_mortgageeInfoNeedsAMortgageeAndAnOrderedPair = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  now <- getTime

  -- No mortgagee: nobody can have declared a real right, so there is no duty
  -- and no request to record.
  noBankCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  submitMustFail insurer do
    exerciseCmd noBankCid PolicyToken_RecordMortgageeInfoRequest with
      requestedAt = now

  -- A response cannot predate the request it answers.
  policyCid <- mintWithBank insurer policyholder insured oracleOperator bank
  requestedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordMortgageeInfoRequest with
      requestedAt = addRelTime now (days (-5))
  submitMustFail insurer do
    exerciseCmd requestedCid PolicyToken_RecordMortgageeInfoProvided with
      providedAt = addRelTime now (days (-6))
  -- Control: on or after the request, it goes through.
  _ <- submit insurer do
    exerciseCmd requestedCid PolicyToken_RecordMortgageeInfoProvided with
      providedAt = addRelTime now (days (-5))
  pure ()

-- m. 1456(6) is not part of the premium-default flow. (4) and (5) fire
-- because something went wrong; (6) can be asked at any time for no reason,
-- and tying it to a default state would refuse the ordinary case.
test_mortgageeInfoIsIndependentOfTheDefaultFlow : Script ()
test_mortgageeInfoIsIndependentOfTheDefaultFlow = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintWithBank insurer policyholder insured oracleOperator bank
  now <- getTime

  -- On an ordinary policy with nothing wrong with it.
  Some before <- queryContractId insurer policyCid
  assert (before.defaultState == DS_None)
  requestedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordMortgageeInfoRequest with
      requestedAt = addRelTime now (days (-5))
  providedCid <- submit insurer do
    exerciseCmd requestedCid PolicyToken_RecordMortgageeInfoProvided with
      providedAt = addRelTime now (days (-4))
  Some after <- queryContractId insurer providedCid
  -- Neither axis moved. This duty is an information duty and nothing else.
  assert (after.defaultState == DS_None)
  assert (after.status == PS_Active)
  assert (isNone after.mortgageeNotifiedAt)

  -- The m. 1456(4) notice is still refused, because no notice has been
  -- served -- the two are separate mechanisms and remain so.
  submitMustFail insurer do
    exerciseCmd providedCid PolicyToken_RecordMortgageeNotice with
      notifiedAt = now

test_mortgageeInfoEnsureGuards : Script ()
test_mortgageeInfoEnsureGuards = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  now <- getTime
  let base = PolicyToken with
        policyNo = "TEST-INFO-ENSURE"
        version = 1
        predecessorRef = None
        insurer
        policyholder
        insured
        beneficiary = None
        beneficiaryDescriptorHash = None
        coverageBeganAt = Some now
        coverageStartBasis = Some CSB_AgreedWithoutPayment
        retroactiveCoverCheckedAt = None
        enforcementFruitlessAt = None
        enforcementRoute = None
        substitutionNotifiedAt = None
        substitutedAt = None
        supersededPolicyholder = None
        premiumDueDate = None
        enforcementCommencedAt = None
        withdrawnAt = None
        withdrawalPath = None
        mortgagee = Some bank
        oracleOperator
        coverages = [frostCoverage]
        termStart = time (date 2026 Jan 1) 12 0 0
        expiry = time (date 2026 Dec 31) 12 0 0
        coverageValidThrough = time (date 2026 Dec 31) 12 0 0
        noticeServiceDate = None
        noticeRecordedAt = None
        noticeCount = 0
        noticeServiceDates = []
        twoNoticeElectionAt = None
        twoNoticeEffectiveAt = None
        terminationInstant = None
        unrunDays = None
        mortgageeNotifiedAt = None
        mortgageeContinuationEndsAt = None
        mortgageeElection = None
        mortgageeInfoRequestedAt = None
        mortgageeInfoProvidedAt = None
        status = PS_Active
        defaultState = DS_None
        documentHash = None
        amendmentReason = None

  -- a response with no request before it
  submitMustFail insurer do
    createCmd base with mortgageeInfoProvidedAt = Some now
  -- a request on a policy with no mortgagee
  submitMustFail insurer do
    createCmd base with mortgagee = None, mortgageeInfoRequestedAt = Some now

  -- control: a request alone creates, and so does an answered pair
  _ <- submit insurer do
    createCmd base with mortgageeInfoRequestedAt = Some now
  ok <- submit insurer do
    createCmd base with
      mortgageeInfoRequestedAt = Some (addRelTime now (days (-5)))
      mortgageeInfoProvidedAt = Some (addRelTime now (days (-4)))
  Some created <- queryContractId insurer ok
  assert (isSome created.mortgageeInfoProvidedAt)
  -- And the OUTSTANDING shape is legal: a later request with an older
  -- response behind it is the state, not a violation.
  outstanding <- submit insurer do
    createCmd base with
      mortgageeInfoRequestedAt = Some (addRelTime now (days (-2)))
      mortgageeInfoProvidedAt = Some (addRelTime now (days (-4)))
  Some out <- queryContractId insurer outstanding
  assert (out.mortgageeInfoProvidedAt < out.mortgageeInfoRequestedAt)

-- ---------------------------------------------------------------------------
-- m. 1434(4): the two-notice termination right
-- ---------------------------------------------------------------------------
--
-- The THIRD way a contract ends for non-payment, and not to be conflated with
-- the other two. (2) is withdrawal; (3) is automatic termination at the end
-- of a notice period. This one is discretionary -- "feshedebilir" -- and its
-- effect is deferred to "sigorta doneminin sonunda".
--
-- Reachable only where (3) did NOT fire: where payment arrived inside the ten
-- days. That is the chronically late payer, and it is why every fixture here
-- serves a notice and then reinstates.

-- Serve a notice and pay it off, leaving the count incremented and the policy
-- out of default -- exactly the state m. 1434(4) is about.
noticeThenPay : Party -> ContractId PolicyToken -> Time -> Script (ContractId PolicyToken)
noticeThenPay insurer cid serviceDate = do
  noticedCid <- submit insurer do
    exerciseCmd cid PolicyToken_ServeNotice with
      noticeServiceDate = serviceDate
      noticeRecordedAt = serviceDate
  submit insurer do
    exerciseCmd noticedCid PolicyToken_Reinstate

test_twoNoticesInOnePeriodMakeTheRightAvailable : Script ()
test_twoNoticesInOnePeriodMakeTheRightAvailable = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let periodStart = addRelTime now (days (-60))
      periodEnd = addRelTime now (days 30)

  -- ONE notice is not enough.
  oneCid <- noticeThenPay insurer policyCid (addRelTime now (days (-50)))
  Some afterOne <- queryContractId insurer oneCid
  assert (afterOne.noticeCount == 1)
  assert (afterOne.noticeServiceDates == [addRelTime now (days (-50))])
  assert (afterOne.defaultState == DS_None)
  submitMustFail insurer do
    exerciseCmd oneCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = periodStart
      insurancePeriodEnd = periodEnd

  -- TWO makes it available.
  twoCid <- noticeThenPay insurer oneCid (addRelTime now (days (-20)))
  Some afterTwo <- queryContractId insurer twoCid
  assert (afterTwo.noticeCount == 2)
  assert (length afterTwo.noticeServiceDates == 2)

  electedCid <- submit insurer do
    exerciseCmd twoCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = periodStart
      insurancePeriodEnd = periodEnd
  Some elected <- queryContractId insurer electedCid
  assert (elected.defaultState == DS_TwoNoticeElected)
  assert (elected.twoNoticeElectionAt == Some now)
  assert (elected.twoNoticeEffectiveAt == Some periodEnd)
  -- The contract RUNS ON. Nothing about the election shortens it.
  assert (elected.coverageValidThrough == afterTwo.coverageValidThrough)

-- Two notices OUTSIDE the named period do not make the right available. This
-- is the check the dates list exists for: a count alone cannot answer it.
test_twoNoticesOutsideThePeriodDoNotCount : Script ()
test_twoNoticesOutsideThePeriodDoNotCount = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  oneCid <- noticeThenPay insurer policyCid (addRelTime now (days (-400)))
  twoCid <- noticeThenPay insurer oneCid (addRelTime now (days (-380)))
  Some both <- queryContractId insurer twoCid
  assert (both.noticeCount == 2)

  -- Both fell in an earlier period. The count says two; the dates say not in
  -- THIS one.
  submitMustFail insurer do
    exerciseCmd twoCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = addRelTime now (days (-60))
      insurancePeriodEnd = addRelTime now (days 30)

  -- Control: naming the period they actually fell in, it goes through.
  _ <- submit insurer do
    exerciseCmd twoCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = addRelTime now (days (-410))
      insurancePeriodEnd = addRelTime now (days 30)
  pure ()

test_twoNoticeEffectLandsOnlyAtThePeriodEnd : Script ()
test_twoNoticeEffectLandsOnlyAtThePeriodEnd = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let periodEnd = addRelTime now (days 30)
  oneCid <- noticeThenPay insurer policyCid (addRelTime now (days (-50)))
  twoCid <- noticeThenPay insurer oneCid (addRelTime now (days (-20)))
  electedCid <- submit insurer do
    exerciseCmd twoCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = addRelTime now (days (-60))
      insurancePeriodEnd = periodEnd

  -- Early is refused. The effect is deferred, not immediate.
  submitMustFail insurer do
    exerciseCmd electedCid PolicyToken_ApplyTwoNoticeTermination with
      appliedAt = addRelTime now (days 29)

  -- A loss in the interval is PAYABLE: cover runs in full until the period
  -- end, exactly as during a notice period under (3).
  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd electedCid PolicyToken_EvaluateTrigger with
      selfContractId = show electedCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "in-the-interval"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched
  Some paidCid <- pure result.newPolicyCid
  Some paid <- queryContractId insurer paidCid
  assert (paid.defaultState == DS_TwoNoticeElected)

  -- At the period end it lands, and cover ends THERE -- not at appliedAt.
  landedCid <- submit insurer do
    exerciseCmd paidCid PolicyToken_ApplyTwoNoticeTermination with
      appliedAt = addRelTime now (days 40)
  Some landed <- queryContractId insurer landedCid
  assert (landed.defaultState == DS_TwoNoticeTerminated)
  assert (landed.coverageValidThrough == periodEnd)

  -- After it lands, a loss is outside cover. v22: judged by the event's time
  -- against coverageValidThrough (the period end), not by the state.
  reachEventEnd (addRelTime periodEnd (days 1))
  submitMustFail oracleOperator do
    exerciseCmd landedCid PolicyToken_EvaluateTrigger with
      selfContractId = show landedCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "after-the-end"
      currency = "TRY"
      eventStart = periodEnd
      eventEnd = addRelTime periodEnd (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  -- Straddling the period end: refused as well.
  reachEventEnd (addRelTime periodEnd (hours 1))
  submitMustFail oracleOperator do
    exerciseCmd landedCid PolicyToken_EvaluateTrigger with
      selfContractId = show landedCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "across-the-end"
      currency = "TRY"
      eventStart = addRelTime periodEnd (hours (-1))
      eventEnd = addRelTime periodEnd (hours 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  -- v22: an event that ended before the period end is evaluated
  -- although the token is already DS_TwoNoticeTerminated.
  reachEventEnd (periodEnd)
  lateResult <- submit oracleOperator do
    exerciseCmd landedCid PolicyToken_EvaluateTrigger with
      selfContractId = show landedCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "before-the-end"
      currency = "TRY"
      eventStart = addRelTime periodEnd (days (-1))
      eventEnd = periodEnd
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert lateResult.trigger.matched
  Some lateCid <- pure lateResult.newPolicyCid
  Some late <- queryContractId insurer lateCid
  assert (late.defaultState == DS_TwoNoticeTerminated)

  -- And the token can finally burn by the shared archive route.
  _ <- submit insurer do
    exerciseCmd lateCid PolicyToken_ArchiveForNonPayment with
      reason = "m. 1434(4) termination at the end of the insurance period"
  pure ()

-- The interaction the single default axis forces, and the reason election is
-- refused rather than allowed to overwrite.
test_twoNoticeElectionRefusedWhileANoticePeriodRuns : Script ()
test_twoNoticeElectionRefusedWhileANoticePeriodRuns = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  oneCid <- noticeThenPay insurer policyCid (addRelTime now (days (-50)))

  -- A second notice, left RUNNING this time.
  runningCid <- submit insurer do
    exerciseCmd oneCid PolicyToken_ServeNotice with
      noticeServiceDate = addRelTime now (days (-5))
      noticeRecordedAt = addRelTime now (days (-5))
  Some running <- queryContractId insurer runningCid
  assert (running.defaultState == DS_GracePeriod)
  assert (running.noticeCount == 2)

  -- The right exists on the text -- two ihtars have been SENT -- but
  -- recording it would overwrite DS_GracePeriod and disable (3). Refused,
  -- because that would decide that (4) beats (3) and the text does not.
  submitMustFail insurer do
    exerciseCmd runningCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = addRelTime now (days (-60))
      insurancePeriodEnd = addRelTime now (days 30)

  -- Once the default resolves by payment, it is available.
  paidCid <- submit insurer do
    exerciseCmd runningCid PolicyToken_Reinstate
  _ <- submit insurer do
    exerciseCmd paidCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = addRelTime now (days (-60))
      insurancePeriodEnd = addRelTime now (days 30)
  pure ()

test_twoNoticeElectionRefusedAfterAThirdParagraphTermination : Script ()
test_twoNoticeElectionRefusedAfterAThirdParagraphTermination = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  oneCid <- noticeThenPay insurer policyCid (addRelTime now (days (-50)))

  -- The second notice runs its ten days unpaid, so (3) ends the contract.
  runningCid <- submit insurer do
    exerciseCmd oneCid PolicyToken_ServeNotice with
      noticeServiceDate = addRelTime now (days (-20))
      noticeRecordedAt = addRelTime now (days (-20))
  terminatedCid <- submit insurer do
    exerciseCmd runningCid PolicyToken_Terminate with
      terminationInstant = addRelTime now (days (-10))
      unrunDays = 100
      mortgageeContinuationEndsAt = None
  Some terminated <- queryContractId insurer terminatedCid
  assert (terminated.defaultState == DS_Terminated)

  -- There is no contract left to terminate at the period end. This is the
  -- case that makes (4) usually unreachable: where (3) fires, it is moot.
  submitMustFail insurer do
    exerciseCmd terminatedCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = addRelTime now (days (-60))
      insurancePeriodEnd = addRelTime now (days 30)

-- Substitution does NOT reset the count. The paragraph's subject is the
-- contract's payment history within a period, and the count attaches to the
-- contract. The contrary reading -- that a new party should not inherit the
-- predecessor's record -- is an open legal question, deliberately not encoded.
test_substitutionDoesNotResetTheNoticeCount : Script ()
test_substitutionDoesNotResetTheNoticeCount = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  oneCid <- noticeThenPay insurer policyCid (addRelTime now (days (-50)))
  twoCid <- noticeThenPay insurer oneCid (addRelTime now (days (-20)))

  fruitlessCid <- submit insurer do
    exerciseCmd twoCid PolicyToken_RecordEnforcementFruitless with
      fruitlessAt = addRelTime now (days (-15))
      route = ER_Takip
  notifiedCid <- submit insurer do
    exerciseCmd fruitlessCid PolicyToken_RecordSubstitutionNotice with
      notifiedAt = addRelTime now (days (-12))
  substitutedCid <- submit insurer do
    exerciseCmd notifiedCid PolicyToken_SubstitutePolicyholder with
      substitutedAtInstant = addRelTime now (days (-11))
  Some substituted <- queryContractId insurer substitutedCid
  assert (substituted.policyholder == insured)
  -- Both survive the change of party, untouched.
  assert (substituted.noticeCount == 2)
  assert (length substituted.noticeServiceDates == 2)

  -- So the right is still available against the new sigorta ettiren.
  _ <- submit insurer do
    exerciseCmd substitutedCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = addRelTime now (days (-60))
      insurancePeriodEnd = addRelTime now (days 30)
  pure ()

-- The election needs a period that is a period and has not ended, and the
-- effect needs an election pending to land.
test_twoNoticeElectionAndApplicationArgumentGuards : Script ()
test_twoNoticeElectionAndApplicationArgumentGuards = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  -- Both notices on one instant, so a period that starts where it ends still
  -- holds two of them and only the period's own shape is at fault.
  let served = addRelTime now (days 10)
  oneCid <- noticeThenPay insurer policyCid served
  twoCid <- noticeThenPay insurer oneCid served

  -- a period that does not start before it ends
  submitMustFail insurer do
    exerciseCmd twoCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = served
      insurancePeriodEnd = served
  -- a period that has already ended when the election is made
  submitMustFail insurer do
    exerciseCmd twoCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = served
      insurancePeriodStart = now
      insurancePeriodEnd = served
  -- no election pending: nothing to apply
  submitMustFail insurer do
    exerciseCmd twoCid PolicyToken_ApplyTwoNoticeTermination with
      appliedAt = addRelTime now (days 40)

  -- control: a proper period elects and its effect lands once
  electedCid <- submit insurer do
    exerciseCmd twoCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = now
      insurancePeriodEnd = addRelTime now (days 30)
  landedCid <- submit insurer do
    exerciseCmd electedCid PolicyToken_ApplyTwoNoticeTermination with
      appliedAt = addRelTime now (days 40)
  -- Landed, the election is no longer pending, so it cannot land twice.
  submitMustFail insurer do
    exerciseCmd landedCid PolicyToken_ApplyTwoNoticeTermination with
      appliedAt = addRelTime now (days 41)

test_twoNoticeEnsureGuards : Script ()
test_twoNoticeEnsureGuards = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  let base = PolicyToken with
        policyNo = "TEST-TWONOTICE-ENSURE"
        version = 1
        predecessorRef = None
        insurer
        policyholder
        insured
        beneficiary = None
        beneficiaryDescriptorHash = None
        coverageBeganAt = Some now
        coverageStartBasis = Some CSB_AgreedWithoutPayment
        retroactiveCoverCheckedAt = None
        enforcementFruitlessAt = None
        enforcementRoute = None
        substitutionNotifiedAt = None
        substitutedAt = None
        supersededPolicyholder = None
        premiumDueDate = None
        enforcementCommencedAt = None
        withdrawnAt = None
        withdrawalPath = None
        mortgagee = None
        oracleOperator
        coverages = [frostCoverage]
        termStart = time (date 2026 Jan 1) 12 0 0
        expiry = time (date 2026 Dec 31) 12 0 0
        coverageValidThrough = time (date 2026 Dec 31) 12 0 0
        noticeServiceDate = None
        noticeRecordedAt = None
        noticeCount = 0
        noticeServiceDates = []
        twoNoticeElectionAt = None
        twoNoticeEffectiveAt = None
        terminationInstant = None
        unrunDays = None
        mortgageeNotifiedAt = None
        mortgageeContinuationEndsAt = None
        mortgageeElection = None
        mortgageeInfoRequestedAt = None
        mortgageeInfoProvidedAt = None
        status = PS_Active
        defaultState = DS_None
        documentHash = None
        amendmentReason = None

  -- the count and the dates must agree
  submitMustFail insurer do
    createCmd base with noticeCount = 2, noticeServiceDates = [now]
  submitMustFail insurer do
    createCmd base with noticeCount = 0, noticeServiceDates = [now]
  -- election and effect are set together
  submitMustFail insurer do
    createCmd base with twoNoticeElectionAt = Some now
  -- and the effect must land after the election
  submitMustFail insurer do
    createCmd base with
      twoNoticeElectionAt = Some now
      twoNoticeEffectiveAt = Some (addRelTime now (days (-1)))
  -- neither m. 1434(4) state exists without the election that produced it
  submitMustFail insurer do
    createCmd base with defaultState = DS_TwoNoticeElected
  submitMustFail insurer do
    createCmd base with defaultState = DS_TwoNoticeTerminated

  -- control: a coherent elected token creates
  ok <- submit insurer do
    createCmd base with
      noticeCount = 2
      noticeServiceDates = [addRelTime now (days (-50)), addRelTime now (days (-20))]
      noticeServiceDate = Some (addRelTime now (days (-20)))
      noticeRecordedAt = Some (addRelTime now (days (-20)))
      twoNoticeElectionAt = Some now
      twoNoticeEffectiveAt = Some (addRelTime now (days 30))
      defaultState = DS_TwoNoticeElected
  Some created <- queryContractId insurer ok
  assert (created.defaultState == DS_TwoNoticeElected)
  assert (created.noticeCount == length created.noticeServiceDates)

-- ---------------------------------------------------------------------------
-- m. 1457: attachment of the insured property
-- ---------------------------------------------------------------------------
--
-- "Sigortali mal haczedilirse, sigortaci, zamaninda bilgilendirilmek sartiyla,
-- sigorta tazminatini icra mudurlugune odeyerek borcundan kurtulur."
--
-- The fourth recipient, and the only one nobody designates. Recorded per
-- COVERAGE, which is an approximation the article does not make -- it
-- attaches to the property -- and the same approximation v17 made for the
-- mortgagee's charge.

attachedCoverage : Coverage
attachedCoverage = frostCoverage with payoutDestination = [PDR_Insured]

chargedCoverageFor : Decimal -> Coverage
chargedCoverageFor claim = frostCoverage with
  payoutDestination = [PDR_Insured, PDR_Mortgagee]
  mortgageeClaimAmount = Some claim

attachTrigger : Party -> ContractId PolicyToken -> Text -> Script EvaluateTriggerResult
attachTrigger oracleOperator cid ref = do
  now <- getTime
  reachEventEnd (addRelTime now (days 1))
  submit oracleOperator do
    exerciseCmd cid PolicyToken_EvaluateTrigger with
      selfContractId = show cid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = ref
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

test_attachmentRoutesToTheEnforcementOffice : Script ()
test_attachmentRoutesToTheEnforcementOffice = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [attachedCoverage]
  now <- getTime

  -- Before any attachment, the ordinary path.
  before <- attachTrigger oracleOperator policyCid "before-attachment"
  [beforeLeg] <- pure before.payouts
  assert (beforeLeg.recipient == PDR_Insured)
  assert (isNone before.unroutedRemainder)
  Some afterPayout <- pure before.newPolicyCid

  attachedCid <- submit insurer do
    exerciseCmd afterPayout PolicyToken_RecordAttachment with
      coverageCode = "FROST"
      attachedAt = addRelTime now (days (-5))
  Some attached <- queryContractId insurer attachedCid
  let Some cov = find (\c -> c.coverageCode == "FROST") attached.coverages
  assert (cov.attachedAt == Some (addRelTime now (days (-5))))
  assert (isNone cov.attachmentLiftedAt)

  -- A payout AFTER the attachment goes to the icra mudurlugu.
  result <- attachTrigger oracleOperator attachedCid "after-attachment"
  [leg] <- pure result.payouts
  assert (leg.recipient == PDR_EnforcementOffice)
  assert (leg.amount == result.trigger.payoutAmount)
  assert (isNone result.unroutedRemainder)

  Some payout <- queryContractId insurer leg.cid
  assert (payout.recipient == PDR_EnforcementOffice)
  -- The exemption in action: PDR_EnforcementOffice is NOT in this coverage's
  -- payoutDestination, and could not have been -- nobody designates an icra
  -- mudurlugu when the policy is written.
  assert (payout.payoutDestination == [PDR_Insured])
  assert (isNone payout.mortgagee)

test_attachmentAndChargeTogetherRouteNothing : Script ()
test_attachmentAndChargeTogetherRouteNothing = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [chargedCoverageFor 40000.0]
  now <- getTime

  attachedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordAttachment with
      coverageCode = "FROST"
      attachedAt = addRelTime now (days (-5))

  result <- attachTrigger oracleOperator attachedCid "competing"
  -- NOTHING routes. The Code gives no priority rule between m. 1456's charge
  -- and m. 1457's attachment, and the ranking question is Icra ve Iflas
  -- Kanunu territory that is not in this repository.
  assert (null result.payouts)
  Some unrouted <- pure result.unroutedRemainder
  assert (unrouted.reason == UNR_CompetingClaims)
  assert (unrouted.amount == result.trigger.payoutAmount)

  Some review <- queryContractId insurer unrouted.reviewCid
  assert (review.amount == result.trigger.payoutAmount)
  assert (review.coverageCode == "FROST")

  -- The claim is NOT decremented: nothing was routed to the bank.
  Some newCid <- pure result.newPolicyCid
  Some reminted <- queryContractId insurer newCid
  let Some cov = find (\c -> c.coverageCode == "FROST") reminted.coverages
  assert (cov.mortgageeClaimAmount == Some 40000.0)

-- A charged coverage whose payoutDestination leaves out PDR_Mortgagee is
-- refused at the trigger even when it is also attached. There nothing routes
-- and no PayoutApproved is created, so PayoutBridge's recipient ensure is
-- never reached: the trigger's own routing assertion is the only refusal.
test_attachedChargedCoverageMustPermitTheMortgagee : Script ()
test_attachedChargedCoverageMustPermitTheMortgagee = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  now <- getTime
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [frostCoverage with mortgageeClaimAmount = Some 40000.0]
  -- Minted here, before the ledger clock moves to the event's end, so its
  -- cover starts with the other's (v22).
  controlCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [chargedCoverageFor 40000.0]

  attachedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordAttachment with
      coverageCode = "FROST"
      attachedAt = addRelTime now (days (-5))
  reachEventEnd (addRelTime now (days 1))
  submitMustFail oracleOperator do
    exerciseCmd attachedCid PolicyToken_EvaluateTrigger with
      selfContractId = show attachedCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "competing-without-mortgagee-destination"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

  -- control: the same attachment and reading on a coverage that permits
  -- PDR_Mortgagee goes through and routes nothing
  controlAttachedCid <- submit insurer do
    exerciseCmd controlCid PolicyToken_RecordAttachment with
      coverageCode = "FROST"
      attachedAt = addRelTime now (days (-5))
  result <- submit oracleOperator do
    exerciseCmd controlAttachedCid PolicyToken_EvaluateTrigger with
      selfContractId = show controlAttachedCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "competing-control"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert (null result.payouts)
  assert (isSome result.unroutedRemainder)

test_liftingRestoresNormalRoutingAndReattachmentWorks : Script ()
test_liftingRestoresNormalRoutingAndReattachmentWorks = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [attachedCoverage]
  now <- getTime

  attachedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordAttachment with
      coverageCode = "FROST"
      attachedAt = addRelTime now (days (-30))
  -- Attaching twice is refused: there is one attachment or none.
  submitMustFail insurer do
    exerciseCmd attachedCid PolicyToken_RecordAttachment with
      coverageCode = "FROST"
      attachedAt = addRelTime now (days (-20))
  -- And a lifting cannot predate the attachment it ends.
  submitMustFail insurer do
    exerciseCmd attachedCid PolicyToken_RecordAttachmentLifted with
      coverageCode = "FROST"
      liftedAt = addRelTime now (days (-40))
  -- Nor name a coverage the policy does not have.
  submitMustFail insurer do
    exerciseCmd attachedCid PolicyToken_RecordAttachmentLifted with
      coverageCode = "NOT-A-COVERAGE"
      liftedAt = addRelTime now (days (-20))

  liftedCid <- submit insurer do
    exerciseCmd attachedCid PolicyToken_RecordAttachmentLifted with
      coverageCode = "FROST"
      liftedAt = addRelTime now (days (-20))
  -- Lifting twice is refused -- nothing is under attachment.
  submitMustFail insurer do
    exerciseCmd liftedCid PolicyToken_RecordAttachmentLifted with
      coverageCode = "FROST"
      liftedAt = addRelTime now (days (-15))

  -- Routing is normal again for payouts arising afterwards.
  restored <- attachTrigger oracleOperator liftedCid "after-lifting"
  [restoredLeg] <- pure restored.payouts
  assert (restoredLeg.recipient == PDR_Insured)
  Some afterRestored <- pure restored.newPolicyCid

  -- And it can be re-imposed. Both dates survive: a lifting OLDER than the
  -- attachment in front of it is exactly how "attached again" is expressed.
  reattachedCid <- submit insurer do
    exerciseCmd afterRestored PolicyToken_RecordAttachment with
      coverageCode = "FROST"
      attachedAt = addRelTime now (days (-10))
  Some reattached <- queryContractId insurer reattachedCid
  let Some cov = find (\c -> c.coverageCode == "FROST") reattached.coverages
  assert (cov.attachedAt == Some (addRelTime now (days (-10))))
  assert (cov.attachmentLiftedAt == Some (addRelTime now (days (-20))))

  again <- attachTrigger oracleOperator reattachedCid "after-reattachment"
  [againLeg] <- pure again.payouts
  assert (againLeg.recipient == PDR_EnforcementOffice)

-- An attachment is per coverage, and only the coverage named is affected.
test_attachmentIsScopedToItsCoverage : Script ()
test_attachmentIsScopedToItsCoverage = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let glass = frostCoverage with
        coverageCode = "GLASS"
        payoutDestination = [PDR_Insured]
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None
    [attachedCoverage, glass]
  now <- getTime

  attachedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordAttachment with
      coverageCode = "FROST"
      attachedAt = addRelTime now (days (-5))

  -- An unknown coverage is refused rather than silently ignored.
  submitMustFail insurer do
    exerciseCmd attachedCid PolicyToken_RecordAttachment with
      coverageCode = "NOT-A-COVERAGE"
      attachedAt = now

  reachEventEnd (addRelTime now (days 1))
  glassResult <- submit oracleOperator do
    exerciseCmd attachedCid PolicyToken_EvaluateTrigger with
      selfContractId = show attachedCid
      coverageCode = "GLASS"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "glass-unattached"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  [glassLeg] <- pure glassResult.payouts
  assert (glassLeg.recipient == PDR_Insured)

test_enforcementOfficeSettlesAsItsOwnRecipient : Script ()
test_enforcementOfficeSettlesAsItsOwnRecipient = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [attachedCoverage]
  now <- getTime
  attachedCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordAttachment with
      coverageCode = "FROST"
      attachedAt = addRelTime now (days (-5))
  result <- attachTrigger oracleOperator attachedCid "settle"
  [leg] <- pure result.payouts

  -- The v17 recipient check still governs: a settlement claiming to have paid
  -- the insured does not close a payout owed to the enforcement office.
  submitMustFail insurer do
    exerciseCmd leg.cid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured

  _ <- submit insurer do
    exerciseCmd leg.cid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_EnforcementOffice
  pure ()

-- ensure: the enforcement office is exempt from the payoutDestination check,
-- and nothing else is.
test_enforcementOfficeExemptionIsNarrow : Script ()
test_enforcementOfficeExemptionIsNarrow = script do
  (insurer, policyholder, _, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  now <- getTime
  let base = PayoutApproved with
        insurer
        policyholder
        oracleOperator
        policyId = "TEST-ATTACHMENT"
        coverageCode = "FROST"
        sourcePolicyContractId = "n/a"
        amount = 1000.0
        recipient = PDR_Insured
        mortgagee = None
        currency = "TRY"
        payoutPercentage = 25.0
        tierLabel = "t"
        isFullSettlement = False
        payoutDestination = [PDR_Insured]
        approvedAt = now
        eventStart = now
        eventEnd = addRelTime now (days 1)
        evidenceDigest = testEvidenceDigest

  -- The exemption: owed to the enforcement office though the policy never
  -- designated it, because nobody designates one.
  _ <- submit (actAs [insurer, oracleOperator]) do
    createCmd base with recipient = PDR_EnforcementOffice
  -- Still refused for every other role.
  submitMustFail (actAs [insurer, oracleOperator]) do
    createCmd base with recipient = PDR_Beneficiary
  submitMustFail (actAs [insurer, oracleOperator]) do
    createCmd base with recipient = PDR_Mortgagee, mortgagee = Some bank
  pure ()

-- ---------------------------------------------------------------------------
-- v22: the event interval, ledger time, metric, cell commitment,
-- evidence digest, payout basis, linear tiers, oracleOperator /= insurer
-- ---------------------------------------------------------------------------

-- A trigger on the FROST coverage with every v22 argument explicit, so each
-- test below changes only the one it is about.
frostTrigger : ContractId PolicyToken -> Decimal -> Time -> Time -> PolicyToken_EvaluateTrigger
frostTrigger cid observed evStart evEnd = PolicyToken_EvaluateTrigger with
  selfContractId = show cid
  coverageCode = "FROST"
  observedValue = observed
  metric = "TEMPERATURE_C"
  attestationRef = "v22"
  currency = "TRY"
  eventStart = evStart
  eventEnd = evEnd
  cellCommitment = testCellCommitment
  evidenceDigest = testEvidenceDigest

-- The event interval [eventStart, eventEnd) must lie inside cover:
-- cover start inclusive, coverageValidThrough exclusive (eventEnd may equal
-- it), and the interval must not be empty or inverted.
test_eventIntervalMustLieInsideCover : Script ()
test_eventIntervalMustLieInsideCover = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some tok <- queryContractId insurer policyCid
  Some coverStart <- pure tok.coverageBeganAt
  let validThrough = tok.coverageValidThrough
  -- v22: every window below has ended on the ledger clock.
  reachEventEnd (addRelTime validThrough (hours 1))

  -- starts before cover began
  submitMustFail oracleOperator do
    exerciseCmd policyCid (frostTrigger policyCid (-2.0) (addRelTime coverStart (hours (-1))) (addRelTime coverStart (hours 1)))
  -- ends after coverageValidThrough
  submitMustFail oracleOperator do
    exerciseCmd policyCid (frostTrigger policyCid (-2.0) (addRelTime validThrough (hours (-1))) (addRelTime validThrough (hours 1)))
  -- empty interval
  submitMustFail oracleOperator do
    exerciseCmd policyCid (frostTrigger policyCid (-2.0) coverStart coverStart)
  -- inverted interval
  submitMustFail oracleOperator do
    exerciseCmd policyCid (frostTrigger policyCid (-2.0) (addRelTime coverStart (days 1)) coverStart)

  -- Both edges exactly on the boundaries: the start is inclusive, the end
  -- may equal coverageValidThrough.
  result <- submit oracleOperator do
    exerciseCmd policyCid (frostTrigger policyCid (-2.0) coverStart validThrough)
  assert result.trigger.matched

-- A policy whose cover has not begun is refused whatever the interval.
test_eventIntervalRefusedWhenCoverNotBegun : Script ()
test_eventIntervalRefusedWhenCoverNotBegun = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintWithoutCover insurer policyholder insured oracleOperator
  now <- getTime
  submitMustFail oracleOperator do
    exerciseCmd policyCid (frostTrigger policyCid (-2.0) now (addRelTime now (days 1)))

-- The trigger's metric must be the coverage's metric.
test_metricMustMatchTheCoverage : Script ()
test_metricMustMatchTheCoverage = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let trig = frostTrigger policyCid (-2.0) now (addRelTime now (days 1))
  reachEventEnd (addRelTime now (days 1))
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with metric = "TEMPERATURE_F"
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with metric = ""
  result <- submit oracleOperator do exerciseCmd policyCid trig
  assert result.trigger.matched

-- A coverage cannot be minted with an empty metric.
test_emptyMetricRejectedAtMint : Script ()
test_emptyMetricRejectedAtMint = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some tok <- queryContractId insurer policyCid
  submitMustFail insurer do
    createCmd tok with
      policyNo = "V22-EMPTY-METRIC"
      coverages = [frostCoverage with metric = ""]

-- The trigger's cell commitment must be the coverage's, and the
-- coverage's must be in the "sha256:" form.
test_cellCommitmentMustMatchTheCoverage : Script ()
test_cellCommitmentMustMatchTheCoverage = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let trig = frostTrigger policyCid (-2.0) now (addRelTime now (days 1))
  reachEventEnd (addRelTime now (days 1))
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with cellCommitment = testEvidenceDigest
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with cellCommitment = ""

  Some tok <- queryContractId insurer policyCid
  submitMustFail insurer do
    createCmd tok with
      policyNo = "V22-BAD-CELL"
      coverages = [frostCoverage with cellCommitment = "metno:39.9,32.8"]
  submitMustFail insurer do
    createCmd tok with
      policyNo = "V22-EMPTY-CELL"
      coverages = [frostCoverage with cellCommitment = ""]

  result <- submit oracleOperator do exerciseCmd policyCid trig
  assert result.trigger.matched

-- The evidence digest must be "sha256:" + 64 lowercase hex characters.
test_evidenceDigestMustBeWellFormed : Script ()
test_evidenceDigestMustBeWellFormed = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let trig = frostTrigger policyCid (-2.0) now (addRelTime now (days 1))
      hex64 = "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
  reachEventEnd (addRelTime now (days 1))
  -- empty
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with evidenceDigest = ""
  -- no prefix
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with evidenceDigest = hex64
  -- wrong prefix
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with evidenceDigest = "sha512:" <> hex64
  -- uppercase hex
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with evidenceDigest = "sha256:" <> "FEDCBA9876543210FEDCBA9876543210FEDCBA9876543210FEDCBA9876543210"
  -- one character short, and one too many
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with evidenceDigest = "sha256:" <> "edcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with evidenceDigest = "sha256:" <> hex64 <> "0"
  -- a non-hex character
  submitMustFail oracleOperator do
    exerciseCmd policyCid trig with evidenceDigest = "sha256:" <> "gedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

  -- Well-formed: accepted, and it lands on the payout with the interval.
  result <- submit oracleOperator do exerciseCmd policyCid trig
  [leg] <- pure result.payouts
  Some payout <- queryContractId insurer leg.cid
  assert (payout.evidenceDigest == testEvidenceDigest)
  assert (payout.eventStart == now)
  assert (payout.eventEnd == addRelTime now (days 1))

-- approvedAt, and flaggedAt on a remainder review item, are the
-- transaction's ledger time; the caller supplies no instant.
test_approvalInstantIsLedgerTime : Script ()
test_approvalInstantIsLedgerTime = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  let t0 = time (date 2026 Mar 1) 12 0 0
  setTime t0
  -- A charged coverage whose claim is below the payout, so one trigger
  -- creates both a PayoutApproved and a ManualReviewRequired.
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank) [chargedCoverage 10000.0]
  let t1 = time (date 2026 Mar 5) 8 30 0
  setTime t1
  ledgerNow <- getTime
  assert (ledgerNow == t1)
  result <- submit oracleOperator do
    exerciseCmd policyCid (frostTrigger policyCid (-2.0) t0 (addRelTime t0 (days 1)))
  [leg] <- pure result.payouts
  Some payout <- queryContractId insurer leg.cid
  assert (payout.approvedAt == t1)
  Some remainder <- pure result.unroutedRemainder
  Some review <- queryContractId insurer remainder.reviewCid
  assert (review.flaggedAt == t1)

-- Under PB_SumInsured the tier percentage is of the sum insured, so a
-- second event in the same tier pays the same as the first; the remaining
-- limit still caps it.
test_sumInsuredBasisSecondEventAndCap : Script ()
test_sumInsuredBasisSecondEventAndCap = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None
    [frostCoverage with payoutBasis = PB_SumInsured]
  now <- getTime
  let ev = addRelTime now (days 1)
  reachEventEnd ev

  first <- submit oracleOperator do exerciseCmd policyCid (frostTrigger policyCid (-2.0) now ev)
  assert (first.trigger.payoutAmount == 25000.0)
  Some cid2 <- pure first.newPolicyCid
  second <- submit oracleOperator do exerciseCmd cid2 (frostTrigger cid2 (-2.0) now ev)
  -- 25% of the 100000 sum insured, not of the 75000 left.
  assert (second.trigger.payoutAmount == 25000.0)
  assert (second.trigger.payoutPct == 25.0)
  Some cid3 <- pure second.newPolicyCid
  Some tok3 <- queryContractId insurer cid3
  let Some cov3 = find (\c -> c.coverageCode == "FROST") tok3.coverages
  assert (cov3.remainingLimit == 50000.0)

  -- 100% of the sum insured is 100000; the remaining 50000 caps it.
  third <- submit oracleOperator do exerciseCmd cid3 (frostTrigger cid3 (-5.0) now ev)
  assert (third.trigger.payoutAmount == 50000.0)
  assert third.trigger.isFullSettlement
  assert (isNone third.newPolicyCid)

-- PB_RemainingLimit keeps today's behaviour -- the second event pays
-- the percentage of what the first left.
test_remainingLimitBasisSecondEvent : Script ()
test_remainingLimitBasisSecondEvent = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None
    [frostCoverage with payoutBasis = PB_RemainingLimit]
  now <- getTime
  let ev = addRelTime now (days 1)
  reachEventEnd ev
  first <- submit oracleOperator do exerciseCmd policyCid (frostTrigger policyCid (-2.0) now ev)
  assert (first.trigger.payoutAmount == 25000.0)
  Some cid2 <- pure first.newPolicyCid
  second <- submit oracleOperator do exerciseCmd cid2 (frostTrigger cid2 (-2.0) now ev)
  assert (second.trigger.payoutAmount == 18750.0)

-- Test fixture for linear tiers. The bounds and end percentages are TEST values chosen to
-- make the arithmetic legible; they are not a product proposal.
linearTier : PayoutTier
linearTier = PayoutTier with
  tierOrder = 1
  label = "Linear frost (-10C to -2C)"
  minValue = Some (-10.0)
  maxValue = Some (-2.0)
  payoutPct = 100.0
  shape = TS_Linear
  pctAtMin = Some 100.0
  pctAtMax = Some 20.0

linearCoverage : Coverage
linearCoverage = frostCoverage with payoutTiers = [linearTier]

-- A linear tier interpolates between its two end percentages across its
-- two bounds; the floor to 2 dp and the remaining-limit cap are the step
-- tier's.
test_linearTierInterpolates : Script ()
test_linearTierInterpolates = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  -- v22: each token's cover starts at the ledger clock when it is minted,
  -- and its event must have ended on that clock before it is evaluated.
  let payOn obs = do
        cid <- mintTestPolicy insurer policyholder insured oracleOperator None None [linearCoverage]
        now <- getTime
        let ev = addRelTime now (days 1)
        reachEventEnd ev
        submit oracleOperator do exerciseCmd cid (frostTrigger cid obs now ev)

  -- at the upper bound: pctAtMax
  atMax <- payOn (-2.0)
  assert (atMax.trigger.payoutPct == 20.0)
  assert (atMax.trigger.payoutAmount == 20000.0)
  -- in the middle: 100 + (-6 - -10) * (20 - 100) / 8 = 60
  mid <- payOn (-6.0)
  assert (mid.trigger.payoutPct == 60.0)
  assert (mid.trigger.payoutAmount == 60000.0)
  -- at the lower bound: pctAtMin, which closes the policy
  atMin <- payOn (-10.0)
  assert (atMin.trigger.payoutPct == 100.0)
  assert (atMin.trigger.payoutAmount == 100000.0)
  assert atMin.trigger.isFullSettlement
  -- outside the bounds: no match
  outside <- payOn (-1.0)
  assert (not outside.trigger.matched)

  -- floorTo2dp on an interpolated percentage: 100 + (-2.000003 - -10) * -10
  -- = 20.00003 %, of 100000 = 20000.03
  odd <- payOn (-2.000003)
  assert (odd.trigger.payoutAmount == 20000.03)

-- The basis applies to the interpolated percentage.
test_linearTierWithSumInsuredBasis : Script ()
test_linearTierWithSumInsuredBasis = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None
    [linearCoverage with payoutBasis = PB_SumInsured]
  now <- getTime
  let ev = addRelTime now (days 1)
  reachEventEnd ev
  first <- submit oracleOperator do exerciseCmd policyCid (frostTrigger policyCid (-6.0) now ev)
  assert (first.trigger.payoutAmount == 60000.0)
  Some cid2 <- pure first.newPolicyCid
  -- 60% of the 100000 sum insured is 60000; 40000 is left and caps it.
  second <- submit oracleOperator do exerciseCmd cid2 (frostTrigger cid2 (-6.0) now ev)
  assert (second.trigger.payoutAmount == 40000.0)
  assert (isNone second.newPolicyCid)

-- A linear tier needs both bounds and both end percentages, the end
-- percentages inside [0, 100], and a step tier carries no end percentages.
test_linearTierShapeIsEnforcedAtMint : Script ()
test_linearTierShapeIsEnforcedAtMint = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some tok <- queryContractId insurer policyCid
  let mintWith tier n = createCmd tok with
        policyNo = "V22-TIER-" <> n
        coverages = [frostCoverage with payoutTiers = [tier]]

  -- an open bound on either side
  submitMustFail insurer do mintWith (linearTier with minValue = None) "1"
  submitMustFail insurer do mintWith (linearTier with maxValue = None) "2"
  -- inverted or equal bounds
  submitMustFail insurer do mintWith (linearTier with minValue = Some (-2.0), maxValue = Some (-10.0)) "3"
  submitMustFail insurer do mintWith (linearTier with minValue = Some (-2.0), maxValue = Some (-2.0)) "4"
  -- a missing end percentage
  submitMustFail insurer do mintWith (linearTier with pctAtMin = None) "5"
  submitMustFail insurer do mintWith (linearTier with pctAtMax = None) "6"
  -- an end percentage outside [0, 100]
  submitMustFail insurer do mintWith (linearTier with pctAtMin = Some 100.01) "7"
  submitMustFail insurer do mintWith (linearTier with pctAtMax = Some (-0.01)) "8"
  -- a step tier carrying end percentages
  let [step, _] = frostTiers
  submitMustFail insurer do mintWith (step with pctAtMin = Some 10.0) "9"
  submitMustFail insurer do mintWith (step with pctAtMax = Some 10.0) "10"

  -- controls: the linear fixture and its edges at 0 and 100 are accepted
  _ <- submit insurer do mintWith linearTier "11"
  _ <- submit insurer do mintWith (linearTier with pctAtMin = Some 0.0, pctAtMax = Some 100.0) "12"
  pure ()

-- oracleOperator /= insurer, on both templates, on the ledger itself.
test_oracleOperatorMustDifferFromInsurer : Script ()
test_oracleOperatorMustDifferFromInsurer = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some tok <- queryContractId insurer policyCid
  submitMustFail insurer do
    createCmd tok with
      policyNo = "V22-SAME-PARTY"
      oracleOperator = insurer
  -- control: the same token with distinct parties mints
  _ <- submit insurer do createCmd tok with policyNo = "V22-DISTINCT"

  let payout = PayoutApproved with
        insurer
        policyholder
        oracleOperator = insurer
        policyId = "V22-SAME-PARTY"
        coverageCode = "FROST"
        sourcePolicyContractId = "n/a"
        amount = 1000.0
        recipient = PDR_Insured
        mortgagee = None
        currency = "TRY"
        payoutPercentage = 25.0
        tierLabel = "t"
        isFullSettlement = False
        payoutDestination = [PDR_Insured]
        approvedAt = now
        eventStart = now
        eventEnd = addRelTime now (days 1)
        evidenceDigest = testEvidenceDigest
  -- One signatory suffices when the two are equal, which is exactly why the
  -- ensure is needed on PayoutApproved as well.
  submitMustFail insurer do createCmd payout
  -- control: with a distinct oracle party (both signing) it is created
  _ <- submit (actAs [insurer, oracleOperator]) do createCmd payout with oracleOperator
  pure ()

-- ---------------------------------------------------------------------------
-- v22: settlement and closure records, ledger time for failures and
-- archives, the refusals that go with them
-- ---------------------------------------------------------------------------

-- A stand-in in the "sha256:" form the records check, for the salted digest
-- of a bank reference or a closing note. Its content means nothing.
testTextDigest : Text
testTextDigest = "sha256:" <> "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"

-- EvaluateTrigger refuses an event that has not ended on the ledger clock.
-- Moves the clock forward to `t` when it is behind it; never backwards.
reachEventEnd : Time -> Script ()
reachEventEnd t = do
  now <- getTime
  if now < t then setTime t else pure ()

-- ConfirmSettlement leaves a PayoutSettled behind and returns it; the
-- record carries the payout's facts, the insurer's declared instant, the
-- digest and the ledger time, and is seen by the payout's observers only.
test_confirmSettlementLeavesARecord : Script ()
test_confirmSettlementLeavesARecord = script do
  (insurer, policyholder, _, oracleOperator, payoutCid) <- approvedPayout
  Some payout <- queryContractId insurer payoutCid
  let declared = time (date 2026 Feb 1) 9 0 0
      t1 = time (date 2026 Feb 3) 10 0 0
  setTime t1
  recordCid <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = declared
      paidRole = PDR_Insured
  Some record <- queryContractId insurer recordCid
  assert (record.insurer == insurer)
  assert (record.policyholder == policyholder)
  assert (record.oracleOperator == oracleOperator)
  assert (isNone record.mortgagee)
  assert (record.policyId == payout.policyId)
  assert (record.coverageCode == "FROST")
  assert (record.sourcePayoutContractId == Some payoutCid)
  assert (record.amount == payout.amount)
  assert (record.currency == payout.currency)
  assert (record.recipient == PDR_Insured)
  assert (record.eventStart == payout.eventStart)
  assert (record.eventEnd == payout.eventEnd)
  assert (record.evidenceDigest == payout.evidenceDigest)
  assert (record.settledAt == declared)
  assert (record.bankReferenceDigest == testTextDigest)
  assert (record.recordedAt == t1)
  -- The payout's observers see it; the oracle party, a plain field here,
  -- does not.
  Some _ <- queryContractId policyholder recordCid
  notSeen <- queryContractId oracleOperator recordCid
  assert (isNone notSeen)

-- On a mortgagee leg the bank, an observer of its payout, observes the
-- settlement record too.
test_mortgageeLegSettlementRecordIsSeenByTheBank : Script ()
test_mortgageeLegSettlementRecordIsSeenByTheBank = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [chargedCoverage 40000.0]
  result <- mildTrigger oracleOperator policyCid "settle-record"
  [leg] <- pure result.payouts
  now <- getTime
  recordCid <- submit insurer do
    exerciseCmd leg.cid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Mortgagee
  Some seenByBank <- queryContractId bank recordCid
  assert (seenByBank.mortgagee == Some bank)
  assert (seenByBank.recipient == PDR_Mortgagee)
  Some _ <- queryContractId policyholder recordCid
  pure ()

-- The bank reference reaches the record only as a salted
-- digest; plain text is refused, and the existing refusals still hold.
test_settlementRecordTakesADigestOnly : Script ()
test_settlementRecordTakesADigestOnly = script do
  (insurer, _, _, _, payoutCid) <- approvedPayout
  now <- getTime
  submitMustFail insurer do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = "TR12 0006 1005 1978 6457 8413 26"
      settledAt = now
      paidRole = PDR_Insured
  submitMustFail insurer do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = "sha256:" <> "00112233445566778899AABBCCDDEEFF00112233445566778899AABBCCDDEEFF"
      settledAt = now
      paidRole = PDR_Insured
  _ <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured
  pure ()

-- Exit 1 of a review item that came from a failed payout leaves a
-- PayoutSettled carrying the source payout's facts.
test_resolveSettledLeavesARecord : Script ()
test_resolveSettledLeavesARecord = script do
  (insurer, policyholder, _, oracleOperator, payoutCid) <- approvedPayout
  Some payout <- queryContractId insurer payoutCid
  reviewCid <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_MarkFailed with
      failureReason = testTextDigest
      sourcePayoutContractId = "cid-placeholder"
  let declared = time (date 2026 Apr 1) 9 0 0
      t1 = time (date 2026 Apr 2) 9 0 0
  setTime t1
  -- the bank reference reaches the record only as a digest here too
  submitMustFail insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveSettled with
      bankReference = "BANK-REF-LATE"
      settledAt = declared
      paidRole = PDR_Insured
  recordCid <- submit insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = declared
      paidRole = PDR_Insured
  Some record <- queryContractId insurer recordCid
  assert (record.sourcePayoutContractId == Some payoutCid)
  assert (record.oracleOperator == oracleOperator)
  assert (record.amount == payout.amount)
  assert (record.recipient == PDR_Insured)
  assert (record.eventStart == payout.eventStart)
  assert (record.eventEnd == payout.eventEnd)
  assert (record.evidenceDigest == payout.evidenceDigest)
  assert (record.settledAt == declared)
  assert (record.recordedAt == t1)
  Some _ <- queryContractId policyholder recordCid
  gone <- queryContractId insurer reviewCid
  assert (isNone gone)

-- Exit 2 leaves a PayoutClosedUnpaid with the reason code, the note's
-- digest, the insurer's declared closing instant and the ledger time.
test_resolveUnpaidLeavesARecord : Script ()
test_resolveUnpaidLeavesARecord = script do
  (insurer, policyholder, _, oracleOperator, payoutCid) <- approvedPayout
  Some payout <- queryContractId insurer payoutCid
  reviewCid <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_MarkFailed with
      failureReason = testTextDigest
      sourcePayoutContractId = "cid-placeholder"
  let declared = time (date 2026 May 1) 9 0 0
      t1 = time (date 2026 May 2) 9 0 0
  setTime t1
  -- the note reaches the record only as a digest
  submitMustFail insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Litigation
      note = "referred to arbitration, file 2026/114"
      closedAt = declared
  recordCid <- submit insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Litigation
      note = testTextDigest
      closedAt = declared
  Some record <- queryContractId insurer recordCid
  assert (record.sourcePayoutContractId == Some payoutCid)
  assert (record.oracleOperator == oracleOperator)
  assert (record.amount == payout.amount)
  assert (record.recipient == Some PDR_Insured)
  assert (record.unpaidReason == UR_Litigation)
  assert (record.noteDigest == testTextDigest)
  assert (record.eventStart == payout.eventStart)
  assert (record.eventEnd == payout.eventEnd)
  assert (record.evidenceDigest == payout.evidenceDigest)
  assert (record.closedAt == declared)
  assert (record.recordedAt == t1)
  Some _ <- queryContractId policyholder recordCid
  notSeen <- queryContractId oracleOperator recordCid
  assert (isNone notSeen)

-- A review item that never came from a payout -- the m. 1456(2) surplus --
-- closes with a record that says so: no source payout, no recipient.
test_remainderReviewItemClosesWithARecord : Script ()
test_remainderReviewItemClosesWithARecord = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [chargedCoverage 10000.0]
  result <- mildTrigger oracleOperator policyCid "surplus-record"
  Some remainder <- pure result.unroutedRemainder
  Some review <- queryContractId insurer remainder.reviewCid
  now <- getTime
  recordCid <- submit insurer do
    exerciseCmd remainder.reviewCid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Other
      note = testTextDigest
      closedAt = now
  Some record <- queryContractId insurer recordCid
  assert (isNone record.sourcePayoutContractId)
  assert (isNone record.recipient)
  assert (isNone record.mortgagee)
  assert (record.amount == 15000.0)
  assert (record.eventStart == review.eventStart)
  assert (record.evidenceDigest == testEvidenceDigest)
  -- The bank observes neither the review item nor its closing record.
  notSeen <- queryContractId bank recordCid
  assert (isNone notSeen)

-- Only the insurer can create either record, the two parties must
-- differ, and the digest must be well formed. The only choice either record
-- has is the implicit Archive, which its signatory alone can exercise.
test_recordTemplatesAuthorityAndEnsure : Script ()
test_recordTemplatesAuthorityAndEnsure = script do
  (insurer, policyholder, _, oracleOperator) <- setupParties
  now <- getTime
  let settled = PayoutSettled with
        insurer
        policyholder
        mortgagee = None
        oracleOperator
        policyId = "V22-RECORD"
        coverageCode = "FROST"
        sourcePayoutContractId = None
        amount = 1000.0
        currency = "TRY"
        recipient = PDR_Insured
        eventStart = now
        eventEnd = addRelTime now (days 1)
        evidenceDigest = testEvidenceDigest
        settledAt = now
        bankReferenceDigest = testTextDigest
        recordedAt = now
      closed = PayoutClosedUnpaid with
        insurer
        policyholder
        mortgagee = None
        oracleOperator
        policyId = "V22-RECORD"
        coverageCode = "FROST"
        sourcePayoutContractId = None
        amount = 1000.0
        currency = "TRY"
        recipient = Some PDR_Insured
        eventStart = now
        eventEnd = addRelTime now (days 1)
        evidenceDigest = testEvidenceDigest
        unpaidReason = UR_Other
        noteDigest = testTextDigest
        closedAt = now
        recordedAt = now

  -- nobody but the insurer
  submitMustFail policyholder do createCmd settled
  submitMustFail oracleOperator do createCmd settled
  submitMustFail policyholder do createCmd closed
  submitMustFail oracleOperator do createCmd closed
  -- the oracle party equal to the insurer
  submitMustFail insurer do createCmd settled with oracleOperator = insurer
  submitMustFail insurer do createCmd closed with oracleOperator = insurer
  -- a digest that is not one
  submitMustFail insurer do createCmd settled with bankReferenceDigest = "BANK-REF-1"
  submitMustFail insurer do createCmd closed with noteDigest = "a note"

  -- controls, and Archive: the policyholder cannot, the insurer can
  settledCid <- submit insurer do createCmd settled
  closedCid <- submit insurer do createCmd closed
  submitMustFail policyholder do archiveCmd settledCid
  submitMustFail policyholder do archiveCmd closedCid
  submit insurer do archiveCmd settledCid
  submit insurer do archiveCmd closedCid

-- MarkFailed's flaggedAt is the ledger time; the caller supplies none.
test_markFailedFlaggedAtIsLedgerTime : Script ()
test_markFailedFlaggedAtIsLedgerTime = script do
  (insurer, _, _, oracleOperator, payoutCid) <- approvedPayout
  Some payout <- queryContractId insurer payoutCid
  let t1 = time (date 2026 Jun 7) 14 15 0
  setTime t1
  reviewCid <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_MarkFailed with
      failureReason = testTextDigest
      sourcePayoutContractId = "cid-placeholder"
  Some review <- queryContractId insurer reviewCid
  assert (review.flaggedAt == t1)
  -- and the facts a closing record will need travel with the item
  assert (review.oracleOperator == oracleOperator)
  assert (review.recipient == Some PDR_Insured)
  assert (review.sourcePayoutCid == Some payoutCid)
  assert (review.eventStart == payout.eventStart)
  assert (review.evidenceDigest == payout.evidenceDigest)

-- An expiry archive is refused before the token's expiry, passes at or
-- after it, and returns two instants: the contract's end (the expiry) and
-- the record's closing (the ledger time).
test_archiveForExpiryWaitsForExpiryAndReturnsTwoInstants : Script ()
test_archiveForExpiryWaitsForExpiryAndReturnsTwoInstants = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some tok <- queryContractId insurer policyCid
  setTime (addRelTime tok.expiry (hours (-1)))
  submitMustFail insurer do
    exerciseCmd policyCid PolicyToken_ArchiveForExpiry with reason = "policy term expired"
  let closing = addRelTime tok.expiry (days 3)
  setTime closing
  instants <- submit insurer do
    exerciseCmd policyCid PolicyToken_ArchiveForExpiry with reason = "policy term expired"
  assert (instants.contractEndedAt == tok.expiry)
  assert (instants.recordClosedAt == closing)
  gone <- queryContractId insurer policyCid
  assert (isNone gone)

-- Exactly at the expiry instant the archive passes.
test_archiveForExpiryAtTheExpiryInstant : Script ()
test_archiveForExpiryAtTheExpiryInstant = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some tok <- queryContractId insurer policyCid
  setTime tok.expiry
  instants <- submit insurer do
    exerciseCmd policyCid PolicyToken_ArchiveForExpiry with reason = "policy term expired"
  assert (instants.contractEndedAt == tok.expiry)
  assert (instants.recordClosedAt == tok.expiry)

-- A non-payment archive under m. 1434(3) is refused before the
-- termination instant, and its contract end is that instant.
test_archiveForNonPaymentWaitsForTheTerminationInstant : Script ()
test_archiveForNonPaymentWaitsForTheTerminationInstant = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let termInstant = time (date 2026 Sep 15) 12 0 0
  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  terminatedCid <- submit insurer do
    exerciseCmd inNoticeCid PolicyToken_Terminate with
      terminationInstant = termInstant
      unrunDays = 107
      mortgageeContinuationEndsAt = None
  setTime (addRelTime termInstant (hours (-1)))
  submitMustFail insurer do
    exerciseCmd terminatedCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"
  let closing = addRelTime termInstant (days 2)
  setTime closing
  instants <- submit insurer do
    exerciseCmd terminatedCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"
  assert (instants.contractEndedAt == termInstant)
  assert (instants.recordClosedAt == closing)

-- Under m. 1434(4) the contract end is twoNoticeEffectiveAt. The
-- termination lands on its own frozen instant, so a token can be
-- DS_TwoNoticeTerminated while the ledger clock is still before it; the
-- archive is refused until the clock reaches it.
test_archiveForNonPaymentWaitsForTheTwoNoticeEnd : Script ()
test_archiveForNonPaymentWaitsForTheTwoNoticeEnd = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let periodEnd = addRelTime now (days 30)
  oneCid <- noticeThenPay insurer policyCid (addRelTime now (days (-50)))
  twoCid <- noticeThenPay insurer oneCid (addRelTime now (days (-20)))
  electedCid <- submit insurer do
    exerciseCmd twoCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = addRelTime now (days (-60))
      insurancePeriodEnd = periodEnd
  landedCid <- submit insurer do
    exerciseCmd electedCid PolicyToken_ApplyTwoNoticeTermination with
      appliedAt = addRelTime now (days 40)
  Some landed <- queryContractId insurer landedCid
  assert (landed.defaultState == DS_TwoNoticeTerminated)
  submitMustFail insurer do
    exerciseCmd landedCid PolicyToken_ArchiveForNonPayment with
      reason = "m. 1434(4)"
  setTime periodEnd
  instants <- submit insurer do
    exerciseCmd landedCid PolicyToken_ArchiveForNonPayment with
      reason = "m. 1434(4)"
  assert (instants.contractEndedAt == periodEnd)
  assert (instants.recordClosedAt == periodEnd)

-- Amend is refused on a contract that ended under m. 1434(4). This
-- closes a gap: since v22 the trigger judges a terminated token by
-- coverageValidThrough, and an Amend with newExpiry would have moved it back
-- to the new expiry and reopened cover on a contract that has ended.
test_amendRefusedAfterTwoNoticeTermination : Script ()
test_amendRefusedAfterTwoNoticeTermination = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let periodEnd = addRelTime now (days 30)
  oneCid <- noticeThenPay insurer policyCid (addRelTime now (days (-50)))
  twoCid <- noticeThenPay insurer oneCid (addRelTime now (days (-20)))
  electedCid <- submit insurer do
    exerciseCmd twoCid PolicyToken_ElectTwoNoticeTermination with
      electedAt = now
      insurancePeriodStart = addRelTime now (days (-60))
      insurancePeriodEnd = periodEnd
  landedCid <- submit insurer do
    exerciseCmd electedCid PolicyToken_ApplyTwoNoticeTermination with
      appliedAt = addRelTime now (days 40)
  Some landed <- queryContractId insurer landedCid
  assert (landed.coverageValidThrough == periodEnd)

  submitMustFail insurer do
    exerciseCmd landedCid amendNothing with
      newExpiry = Some landed.expiry
  submitMustFail insurer do
    exerciseCmd landedCid amendNothing
  -- Cover is not reopened: the token is untouched, and an event after the
  -- period end is still outside cover.
  Some still <- queryContractId insurer landedCid
  assert (still.coverageValidThrough == periodEnd)
  let afterEnd = addRelTime periodEnd (days 1)
  reachEventEnd (addRelTime afterEnd (days 1))
  submitMustFail oracleOperator do
    exerciseCmd landedCid (frostTrigger landedCid (-2.0) afterEnd (addRelTime afterEnd (days 1)))

-- Amend is refused after a m. 1434(2) withdrawal as well.
test_amendRefusedAfterFirstPremiumWithdrawal : Script ()
test_amendRefusedAfterFirstPremiumWithdrawal = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  unpaidCid <- inFirstPremiumDefault insurer policyCid (addRelTime now (days (-30)))
  -- control: Amend works on the same token before the withdrawal
  amendedCid <- submit insurer do
    exerciseCmd unpaidCid amendNothing
  withdrawnCid <- submit insurer do
    exerciseCmd amendedCid PolicyToken_WithdrawForFirstPremium with
      withdrawnAt = now
      path = WP_InsurerWithdrew
  submitMustFail insurer do
    exerciseCmd withdrawnCid amendNothing
  submitMustFail insurer do
    exerciseCmd withdrawnCid amendNothing with
      reason = ER_SumInsuredIncrease
      sumInsuredChanges = [("FROST", 150000.0)]

-- A first-premium payment dated after the ledger clock is refused; one
-- dated at it passes.
test_firstPremiumPaidInTheFutureIsRefused : Script ()
test_firstPremiumPaidInTheFutureIsRefused = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintWithoutCover insurer policyholder insured oracleOperator
  let t1 = time (date 2026 Mar 10) 12 0 0
  setTime t1
  submitMustFail insurer do
    exerciseCmd policyCid PolicyToken_RecordFirstPremiumPaid with
      paidAt = addRelTime t1 (seconds 1)
  submitMustFail insurer do
    exerciseCmd policyCid PolicyToken_RecordFirstPremiumPaid with
      paidAt = addRelTime t1 (days 1)
  paidCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordFirstPremiumPaid with
      paidAt = t1
  Some paid <- queryContractId insurer paidCid
  assert (paid.coverageBeganAt == Some t1)

-- Decision (2026-09-23): a linear tier whose computed amount is 0.00 is
-- no match -- nothing is created and the token is untouched -- whether the
-- percentage itself is 0 or a small one floors to 0.00.
test_linearTierZeroAmountIsNoMatch : Script ()
test_linearTierZeroAmountIsNoMatch = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let zeroAtMax = linearTier with pctAtMin = Some 100.0, pctAtMax = Some 0.0, payoutPct = 100.0
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None
    [frostCoverage with payoutTiers = [zeroAtMax]]
  now <- getTime
  let ev = addRelTime now (days 1)
  reachEventEnd ev
  -- the percentage at the upper bound is exactly 0
  atZero <- submit oracleOperator do exerciseCmd policyCid (frostTrigger policyCid (-2.0) now ev)
  assert (not atZero.trigger.matched)
  assert (atZero.trigger.payoutAmount == 0.0)
  assert (null atZero.payouts)
  assert (isNone atZero.newPolicyCid)
  assert (isNone atZero.unroutedRemainder)
  -- 100 - 12.5 * 7.9999999 = 0.00000125 %, of 100000 = 0.00125 -> 0.00
  tiny <- submit oracleOperator do exerciseCmd policyCid (frostTrigger policyCid (-2.0000001) now ev)
  assert (not tiny.trigger.matched)
  assert (null tiny.payouts)
  -- the token is untouched (the trigger is nonconsuming and nothing re-minted)
  Some tok <- queryContractId insurer policyCid
  assert (tok.status == PS_Active)
  assert (tok.version == 1)
  -- control: inside the tier with a positive amount it pays
  paid <- submit oracleOperator do exerciseCmd policyCid (frostTrigger policyCid (-6.0) now ev)
  assert paid.trigger.matched
  assert (paid.trigger.payoutAmount == 50000.0)

-- A linear tier's payoutPct is the highest rate it can pay,
-- max pctAtMin pctAtMax, whichever end that is.
test_linearTierPayoutPctIsTheHigherEnd : Script ()
test_linearTierPayoutPctIsTheHigherEnd = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some tok <- queryContractId insurer policyCid
  let mintWith tier n = createCmd tok with
        policyNo = "V22-PCT-" <> n
        coverages = [frostCoverage with payoutTiers = [tier]]
  -- linearTier: pctAtMin 100, pctAtMax 20
  submitMustFail insurer do mintWith (linearTier with payoutPct = 0.0) "1"
  submitMustFail insurer do mintWith (linearTier with payoutPct = 20.0) "2"
  submitMustFail insurer do mintWith (linearTier with payoutPct = 99.99) "3"
  _ <- submit insurer do mintWith (linearTier with payoutPct = 100.0) "4"
  -- rising the other way: pctAtMin 10, pctAtMax 60
  let rising = linearTier with pctAtMin = Some 10.0, pctAtMax = Some 60.0
  submitMustFail insurer do mintWith (rising with payoutPct = 10.0) "5"
  _ <- submit insurer do mintWith (rising with payoutPct = 60.0) "6"
  pure ()

-- An event window that has not ended on the ledger clock is not
-- evaluated; one that ended exactly at it is.
test_unfinishedEventWindowIsRefused : Script ()
test_unfinishedEventWindowIsRefused = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some tok <- queryContractId insurer policyCid
  Some coverStart <- pure tok.coverageBeganAt
  let t1 = addRelTime coverStart (days 2)
  setTime t1
  submitMustFail oracleOperator do
    exerciseCmd policyCid (frostTrigger policyCid (-2.0) coverStart (addRelTime t1 (seconds 1)))
  submitMustFail oracleOperator do
    exerciseCmd policyCid (frostTrigger policyCid (-2.0) (addRelTime t1 (hours (-1))) (addRelTime t1 (days 1)))
  result <- submit oracleOperator do
    exerciseCmd policyCid (frostTrigger policyCid (-2.0) coverStart t1)
  assert result.trigger.matched

-- Housekeeping: the two m. 1431(4) record choices re-mint at version + 1,
-- as every other re-mint in the file does.
test_substitutionFactsIncrementTheVersion : Script ()
test_substitutionFactsIncrementTheVersion = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintForAnothersAccount insurer policyholder insured oracleOperator
  now <- getTime
  fruitlessCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_RecordEnforcementFruitless with
      fruitlessAt = addRelTime now (days (-20))
      route = ER_Takip
  Some fruitless <- queryContractId insurer fruitlessCid
  assert (fruitless.version == 2)
  notifiedCid <- submit insurer do
    exerciseCmd fruitlessCid PolicyToken_RecordSubstitutionNotice with
      notifiedAt = addRelTime now (days (-10))
  Some notified <- queryContractId insurer notifiedCid
  assert (notified.version == 3)

-- ---------------------------------------------------------------------------
-- v22: the records keep PayoutApproved's recipient/mortgagee rule,
-- ResolveSettled checks the role an item carries, a zero after the cap is no
-- match for every tier shape
-- ---------------------------------------------------------------------------

-- A mortgagee on a record exactly when its recipient is the mortgagee,
-- the same rule PayoutApproved's ensure holds, on both record templates.
test_recordsKeepTheRecipientMortgageeRule : Script ()
test_recordsKeepTheRecipientMortgageeRule = script do
  (insurer, policyholder, _, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  now <- getTime
  let settled = PayoutSettled with
        insurer
        policyholder
        mortgagee = None
        oracleOperator
        policyId = "V22-V2B-RECORD"
        coverageCode = "FROST"
        sourcePayoutContractId = None
        amount = 1000.0
        currency = "TRY"
        recipient = PDR_Insured
        eventStart = now
        eventEnd = addRelTime now (days 1)
        evidenceDigest = testEvidenceDigest
        settledAt = now
        bankReferenceDigest = testTextDigest
        recordedAt = now
      closed = PayoutClosedUnpaid with
        insurer
        policyholder
        mortgagee = None
        oracleOperator
        policyId = "V22-V2B-RECORD"
        coverageCode = "FROST"
        sourcePayoutContractId = None
        amount = 1000.0
        currency = "TRY"
        recipient = Some PDR_Insured
        eventStart = now
        eventEnd = addRelTime now (days 1)
        evidenceDigest = testEvidenceDigest
        unpaidReason = UR_Other
        noteDigest = testTextDigest
        closedAt = now
        recordedAt = now

  -- a mortgagee recipient with no mortgagee party
  submitMustFail insurer do createCmd settled with recipient = PDR_Mortgagee
  submitMustFail insurer do createCmd closed with recipient = Some PDR_Mortgagee
  -- a mortgagee party on a leg that is not the mortgagee's
  submitMustFail insurer do createCmd settled with mortgagee = Some bank
  submitMustFail insurer do createCmd closed with mortgagee = Some bank
  -- and on an unrouted amount, which has no recipient at all
  submitMustFail insurer do createCmd closed with recipient = None, mortgagee = Some bank

  -- controls: the consistent combinations are created
  _ <- submit insurer do createCmd settled
  _ <- submit insurer do createCmd settled with recipient = PDR_Mortgagee, mortgagee = Some bank
  _ <- submit insurer do createCmd closed
  _ <- submit insurer do createCmd closed with recipient = Some PDR_Mortgagee, mortgagee = Some bank
  _ <- submit insurer do createCmd closed with recipient = None
  pure ()

-- An item MarkFailed raised carries its payout's recipient, and
-- ResolveSettled refuses a paidRole other than that one.
test_resolveSettledChecksTheRoleItCarries : Script ()
test_resolveSettledChecksTheRoleItCarries = script do
  (insurer, _, _, _, payoutCid) <- approvedPayout
  reviewCid <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_MarkFailed with
      failureReason = testTextDigest
      sourcePayoutContractId = "cid-placeholder"
  now <- getTime
  submitMustFail insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Beneficiary
  submitMustFail insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_EnforcementOffice
  recordCid <- submit insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured
  Some record <- queryContractId insurer recordCid
  assert (record.recipient == PDR_Insured)

-- The same on a mortgagee leg: the insured is refused, the mortgagee
-- passes and the bank sees the record.
test_resolveSettledChecksTheMortgageeRoleItCarries : Script ()
test_resolveSettledChecksTheMortgageeRoleItCarries = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
    [chargedCoverage 40000.0]
  result <- mildTrigger oracleOperator policyCid "v2b-mortgagee-review"
  [leg] <- pure result.payouts
  reviewCid <- submit insurer do
    exerciseCmd leg.cid PayoutApproved_MarkFailed with
      failureReason = testTextDigest
      sourcePayoutContractId = "cid-placeholder"
  now <- getTime
  submitMustFail insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured
  recordCid <- submit insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Mortgagee
  Some seenByBank <- queryContractId bank recordCid
  assert (seenByBank.recipient == PDR_Mortgagee)
  assert (seenByBank.mortgagee == Some bank)

-- An item the trigger raised for an unrouted amount carries no
-- recipient, and ResolveSettled records the reported role unchecked, as
-- before -- the record's own ensure still holds it to the
-- recipient/mortgagee rule. Such an item carries the policy's
-- mortgagee party, so the mortgagee role is accepted again.
test_resolveSettledOnAnUnroutedItemIsNotRoleChecked : Script ()
test_resolveSettledOnAnUnroutedItemIsNotRoleChecked = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  let resolveAs role = do
        policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
          [chargedCoverage 10000.0]
        result <- mildTrigger oracleOperator policyCid "v2b-unrouted"
        Some remainder <- pure result.unroutedRemainder
        now <- getTime
        pure (remainder.reviewCid, ManualReviewRequired_ResolveSettled with
                bankReference = testTextDigest
                settledAt = now
                paidRole = role)
  -- neither role is checked against anything on the item
  (cid1, arg1) <- resolveAs PDR_Insured
  r1 <- submit insurer do exerciseCmd cid1 arg1
  Some rec1 <- queryContractId insurer r1
  assert (rec1.recipient == PDR_Insured)
  (cid2, arg2) <- resolveAs PDR_EnforcementOffice
  r2 <- submit insurer do exerciseCmd cid2 arg2
  Some rec2 <- queryContractId insurer r2
  assert (rec2.recipient == PDR_EnforcementOffice)
  -- The mortgagee role now leaves a mortgagee record with the bank on it
  (cid3, arg3) <- resolveAs PDR_Mortgagee
  r3 <- submit insurer do exerciseCmd cid3 arg3
  Some rec3 <- queryContractId insurer r3
  assert (rec3.recipient == PDR_Mortgagee)
  assert (rec3.mortgagee == Some bank)

-- Fixture: FROST plus a second coverage, so FROST can be exhausted while
-- the policy stays open.
secondCoverage : Coverage
secondCoverage = frostCoverage with coverageCode = "FROST-2"

-- FROST (with the given tiers and basis) is exhausted by `severe`, then
-- `inTier`, a value its tiers match, is evaluated: no match, nothing created,
-- the token untouched. Under PB_SumInsured the cap is what makes the amount
-- 0.00; under PB_RemainingLimit the basis is already 0.
exhaustedThenMatch : [PayoutTier] -> PayoutBasis -> Decimal -> Decimal -> Script ()
exhaustedThenMatch tiers basis severe inTier = do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None
    [(frostCoverage with payoutTiers = tiers, payoutBasis = basis), secondCoverage]
  now <- getTime
  let ev = addRelTime now (days 1)
  reachEventEnd ev
  -- 100% of FROST exhausts it; FROST-2 keeps the policy open
  first <- submit oracleOperator do exerciseCmd policyCid (frostTrigger policyCid severe now ev)
  Some cid2 <- pure first.newPolicyCid
  Some before <- queryContractId insurer cid2
  let Some exhausted = find (\c -> c.coverageCode == "FROST") before.coverages
  assert (exhausted.remainingLimit == 0.0)

  second <- submit oracleOperator do exerciseCmd cid2 (frostTrigger cid2 inTier now ev)
  assert (not second.trigger.matched)
  assert (second.trigger.payoutAmount == 0.0)
  assert (null second.payouts)
  assert (isNone second.newPolicyCid)
  assert (isNone second.unroutedRemainder)
  Some after <- queryContractId insurer cid2
  assert (after == before)

-- A step tier on an exhausted coverage. Before this rule the matched value
-- reached PayoutApproved's `amount > 0.0` ensure and the trigger failed.
test_exhaustedCoverageStepTierIsNoMatch : Script ()
test_exhaustedCoverageStepTierIsNoMatch = script do
  -- severe frost 100%, then the 25% mild tier
  exhaustedThenMatch frostTiers PB_SumInsured (-5.0) (-1.0)
  exhaustedThenMatch frostTiers PB_RemainingLimit (-5.0) (-1.0)

-- The same on a linear tier.
test_exhaustedCoverageLinearTierIsNoMatch : Script ()
test_exhaustedCoverageLinearTierIsNoMatch = script do
  -- pctAtMin 100% at the lower bound, then 60% in the middle
  exhaustedThenMatch [linearTier] PB_SumInsured (-10.0) (-6.0)
  exhaustedThenMatch [linearTier] PB_RemainingLimit (-10.0) (-6.0)

-- ---------------------------------------------------------------------------
-- v22: an unrouted review item on a charged coverage carries the
-- policy's mortgagee party without showing the item to it, so a human can
-- settle it to the mortgagee
-- ---------------------------------------------------------------------------

-- Fixture: a fresh charged policy with `bank` as its mortgagee, and the
-- review item the trigger raised on it -- the competing-claims kind (charge
-- plus attachment) or the surplus kind (charge only).
unroutedChargedItem
  : Party -> Party -> Party -> Party -> Party -> Bool -> Text
  -> Script (ContractId ManualReviewRequired)
unroutedChargedItem insurer policyholder insured oracleOperator bank competing ref = do
  now <- getTime
  result <- if competing then do
      policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
        [chargedCoverageFor 40000.0]
      attachedCid <- submit insurer do
        exerciseCmd policyCid PolicyToken_RecordAttachment with
          coverageCode = "FROST"
          attachedAt = addRelTime now (days (-5))
      attachTrigger oracleOperator attachedCid ref
    else do
      policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank)
        [chargedCoverage 10000.0]
      mildTrigger oracleOperator policyCid ref
  Some remainder <- pure result.unroutedRemainder
  assert (remainder.reason == (if competing then UNR_CompetingClaims else UNR_MortgageeSurplus))
  pure remainder.reviewCid

-- On either kind of item the item carries the bank but the bank does
-- not see it; settled to the mortgagee, the bank sees the record; settled to
-- the insured, as before, and the bank sees nothing; closed unpaid, as
-- before, and the bank sees nothing.
unroutedChargedItemSettles : Bool -> Text -> Script ()
unroutedChargedItemSettles competing ref = do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  bank <- allocateParty "Bank"
  let item = unroutedChargedItem insurer policyholder insured oracleOperator bank competing

  toBank <- item (ref <> "-mortgagee")
  Some review <- queryContractId insurer toBank
  assert (review.mortgagee == Some bank)
  assert (isNone review.recipient)
  hidden <- queryContractId bank toBank
  assert (isNone hidden)
  now <- getTime
  recordCid <- submit insurer do
    exerciseCmd toBank ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Mortgagee
  Some seenByBank <- queryContractId bank recordCid
  assert (seenByBank.recipient == PDR_Mortgagee)
  assert (seenByBank.mortgagee == Some bank)

  toInsured <- item (ref <> "-insured")
  hidden2 <- queryContractId bank toInsured
  assert (isNone hidden2)
  insuredCid <- submit insurer do
    exerciseCmd toInsured ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured
  Some insuredRecord <- queryContractId insurer insuredCid
  assert (insuredRecord.recipient == PDR_Insured)
  assert (isNone insuredRecord.mortgagee)
  notSeen <- queryContractId bank insuredCid
  assert (isNone notSeen)

  unpaid <- item (ref <> "-unpaid")
  closedCid <- submit insurer do
    exerciseCmd unpaid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Other
      note = testTextDigest
      closedAt = now
  Some closed <- queryContractId insurer closedCid
  assert (isNone closed.recipient)
  assert (isNone closed.mortgagee)
  notSeen2 <- queryContractId bank closedCid
  assert (isNone notSeen2)

test_competingClaimsItemSettlesToTheMortgagee : Script ()
test_competingClaimsItemSettlesToTheMortgagee = script do
  unroutedChargedItemSettles True "v2c-competing"

test_surplusItemSettlesToTheMortgagee : Script ()
test_surplusItemSettlesToTheMortgagee = script do
  unroutedChargedItemSettles False "v2c-surplus"

-- Submits `cmds` and expects it through when `allowed`, refused otherwise.
expectAllowed : Bool -> Party -> Commands a -> Script ()
expectAllowed allowed party cmds =
  if allowed
  then do
    _ <- submit party cmds
    pure ()
  else submitMustFail party cmds

-- Six choices act only on a policy whose claim axis is active or partially
-- paid. Every other status is refused by each of them; the two allowed
-- statuses, on the same token otherwise, are the control.
test_claimAxisStatusGuards : Script ()
test_claimAxisStatusGuards = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  -- One shape every one of the six can act on: cover begun, two notices in
  -- the period named below, enforcement reported fruitless and the
  -- sigortali notified, on a policy taken for another's account.
  let base = PolicyToken with
        policyNo = "TEST-STATUS-GUARDS"
        version = 1
        predecessorRef = None
        insurer
        policyholder
        insured
        beneficiary = None
        beneficiaryDescriptorHash = None
        mortgagee = None
        oracleOperator
        coverages = [frostCoverage]
        termStart = time (date 2026 Jan 1) 12 0 0
        expiry = time (date 2026 Dec 31) 12 0 0
        coverageValidThrough = time (date 2026 Dec 31) 12 0 0
        noticeServiceDate = Some (addRelTime now (days (-20)))
        noticeRecordedAt = Some (addRelTime now (days (-20)))
        noticeCount = 2
        noticeServiceDates = [addRelTime now (days (-50)), addRelTime now (days (-20))]
        twoNoticeElectionAt = None
        twoNoticeEffectiveAt = None
        coverageBeganAt = Some now
        coverageStartBasis = Some CSB_AgreedWithoutPayment
        retroactiveCoverCheckedAt = None
        enforcementFruitlessAt = Some (addRelTime now (days (-20)))
        enforcementRoute = Some ER_Takip
        substitutionNotifiedAt = Some (addRelTime now (days (-10)))
        substitutedAt = None
        supersededPolicyholder = None
        premiumDueDate = None
        enforcementCommencedAt = None
        withdrawnAt = None
        withdrawalPath = None
        terminationInstant = None
        unrunDays = None
        mortgageeNotifiedAt = None
        mortgageeContinuationEndsAt = None
        mortgageeElection = None
        mortgageeInfoRequestedAt = None
        mortgageeInfoProvidedAt = None
        status = PS_Active
        defaultState = DS_None
        documentHash = None
        amendmentReason = None
  reachEventEnd (addRelTime now (days 1))

  _ <- forA
    [ (PS_Active, True), (PS_PartiallyPaid, True)
    , (PS_Expired, False), (PS_Cancelled, False)
    , (PS_ClaimedAndClosed, False), (PS_ManualReview, False) ] $ \(s, allowed) -> do
    let shaped = base with status = s

    triggerCid <- submit insurer do createCmd shaped
    expectAllowed allowed oracleOperator do
      exerciseCmd triggerCid PolicyToken_EvaluateTrigger with
        selfContractId = show triggerCid
        coverageCode = "FROST"
        observedValue = -2.0
        metric = "TEMPERATURE_C"
        attestationRef = "status-guard"
        currency = "TRY"
        eventStart = now
        eventEnd = addRelTime now (days 1)
        cellCommitment = testCellCommitment
        evidenceDigest = testEvidenceDigest

    electCid <- submit insurer do createCmd shaped
    expectAllowed allowed insurer do
      exerciseCmd electCid PolicyToken_ElectTwoNoticeTermination with
        electedAt = now
        insurancePeriodStart = addRelTime now (days (-60))
        insurancePeriodEnd = addRelTime now (days 30)

    serveCid <- submit insurer do createCmd shaped
    expectAllowed allowed insurer do
      exerciseCmd serveCid PolicyToken_ServeNotice with
        noticeServiceDate = now
        noticeRecordedAt = now

    fruitlessCid <- submit insurer do createCmd shaped
    expectAllowed allowed insurer do
      exerciseCmd fruitlessCid PolicyToken_RecordEnforcementFruitless with
        fruitlessAt = now
        route = ER_Dava

    substituteCid <- submit insurer do createCmd shaped
    expectAllowed allowed insurer do
      exerciseCmd substituteCid PolicyToken_SubstitutePolicyholder with
        substitutedAtInstant = now

    amendCid <- submit insurer do createCmd shaped
    expectAllowed allowed insurer do
      exerciseCmd amendCid amendNothing with
        reason = ER_Correction
  pure ()
