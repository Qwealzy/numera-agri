-- ensure must reject a coverage's mortgageeClaimAmount being Some when
-- the policy has no mortgagee party at all -- a claim with no mortgagee to
-- pay it is invalid. The reverse (mortgagee present, this coverage has no
-- claim on it) is explicitly valid and exercised elsewhere
-- (frostCoverage's mortgageeClaimAmount is always None).
test_mortgageeClaimEnsureRejectsClaimWithoutMortgagee : Script ()
test_mortgageeClaimEnsureRejectsClaimWithoutMortgagee = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let claimedCoverage = frostCoverage with mortgageeClaimAmount = Some 50000.0
  submitMustFail insurer do
