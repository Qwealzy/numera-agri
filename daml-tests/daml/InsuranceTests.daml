      coverageBeganAt = None
      coverageStartBasis = None
      retroactiveCoverCheckedAt = None
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee = None
      oracleOperator
      coverages = [claimedCoverage]
      termStart = time (date 2026 Jan 1) 12 0 0
      expiry = time (date 2026 Dec 31) 12 0 0
      coverageValidThrough = time (date 2026 Dec 31) 12 0 0
      noticeServiceDate = None
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
