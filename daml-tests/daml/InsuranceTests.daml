-- ensure must reject coverageValidThrough landing after expiry -- coverage
-- can never outlast the policy term itself.
test_coverageValidThroughEnsureRejectsAfterExpiry : Script ()
test_coverageValidThroughEnsureRejectsAfterExpiry = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  submitMustFail insurer do
    createCmd PolicyToken with
      policyNo = "TEST-POLICY-COVERAGE-AFTER-EXPIRY"
      version = 1
      predecessorRef = None
      insurer
      policyholder
      insured
      beneficiary = None
      beneficiaryDescriptorHash = None
      coverageBeganAt = None
      coverageStartBasis = None
      retroactiveCoverCheckedAt = None
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee = None
      oracleOperator
      coverages = [frostCoverage]
      termStart = time (date 2026 Jan 1) 12 0 0
      expiry = time (date 2026 Dec 31) 12 0 0
      coverageValidThrough = time (date 2026 Dec 31) 12 0 1
      noticeServiceDate = None
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
      defaultState = DS_None
      documentHash = None
      amendmentReason = None

-- Authorization boundary this whole design leans on: the insurer must NOT
-- be able to exercise EvaluateTrigger itself (nor can the policyholder,
-- who is only an observer). If either of these ever starts succeeding, the
-- conflict-of-interest control documented in PolicyToken.daml has silently
-- broken -- an insurer able to self-trigger can effectively approve its
-- own payout.
test_insurerCannotSelfTrigger : Script ()
test_insurerCannotSelfTrigger = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]

  reachEventEnd (addRelTime now (days 1))
  submitMustFail insurer do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-attack-insurer"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

  reachEventEnd (addRelTime now (days 1))
  submitMustFail policyholder do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-attack-policyholder"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

  -- oracleOperator, the correct controller, still works -- proves the
  -- failures above are an authorization boundary, not a broken fixture.
  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-control"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched

  pure ()

-- Every observer role -- policyholder, insured, beneficiary, mortgagee --
-- must be able to exercise no choice at all, against either controller
-- boundary (oracleOperator's EvaluateTrigger and insurer's
-- ArchiveForNonPayment). Positive controls for both controllers already
-- exist in test_insurerCannotSelfTrigger (oracleOperator) and
-- test_archiveForNonPayment (insurer) -- without those, these failures
-- alone would prove nothing. Also doubles as the positive-mint proof that
-- a real mortgagee party plus a coverage claiming against it (mortgagee =
-- Some, mortgageeClaimAmount = Some) is valid -- the case
-- test_mortgageeClaimEnsureRejectsClaimWithoutMortgagee's rejection is the
-- mirror of.
test_observerRolesCannotExerciseAnyChoice : Script ()
test_observerRolesCannotExerciseAnyChoice = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  beneficiary <- allocateParty "Beneficiary"
  mortgagee <- allocateParty "Mortgagee"
  let coverageWithClaim = frostCoverage with mortgageeClaimAmount = Some 50000.0
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator
    (Some beneficiary) (Some mortgagee) [coverageWithClaim]
  now <- getTime

  reachEventEnd (addRelTime now (days 1))
  submitMustFail policyholder do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-attack-policyholder"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  reachEventEnd (addRelTime now (days 1))
  submitMustFail insured do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-attack-insured"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  reachEventEnd (addRelTime now (days 1))
  submitMustFail beneficiary do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-attack-beneficiary"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  reachEventEnd (addRelTime now (days 1))
  submitMustFail mortgagee do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-attack-mortgagee"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

  submitMustFail policyholder do
    exerciseCmd policyCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"
  submitMustFail insured do
    exerciseCmd policyCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"
  submitMustFail beneficiary do
    exerciseCmd policyCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"
  submitMustFail mortgagee do
    exerciseCmd policyCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"

  pure ()

-- The premium-default burn path. Unlike EvaluateTrigger there's no
-- conflict-of-interest concern here -- the insurer choosing to walk away
-- from an unpaid policy is exactly the intended incentive -- so `insurer`
-- alone is the controller. oracleOperator must NOT be able to burn a
-- policy itself; it only feeds readings.
test_archiveForNonPayment : Script ()
test_archiveForNonPayment = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  -- This is phase TWO of termination, so the policy must first be
  -- put through notice -> terminate. The ledger guard is proven separately
  -- in test_archiveForNonPaymentRequiresTermination.
  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  terminatedCid <- submit insurer do
    exerciseCmd inNoticeCid PolicyToken_Terminate with
      terminationInstant = now
      unrunDays = 90
      mortgageeContinuationEndsAt = None

  submitMustFail oracleOperator do
    exerciseCmd terminatedCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"

  submitMustFail policyholder do
    exerciseCmd terminatedCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"

  submit insurer do
    exerciseCmd terminatedCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"

  remaining <- queryContractId insurer terminatedCid
  assert (isNone remaining)

-- The natural-expiry burn path (endDate/expiry reached, no
-- outstanding claim). Same controller = insurer reasoning as non-payment
-- above. reason is only carried through here --
-- its content isn't asserted on, only that the choice still requires
-- `insurer` alone with the new arguments in place.
test_archiveForExpiry : Script ()
test_archiveForExpiry = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  -- v22: the archive waits for expiry on the ledger clock.
  Some tok <- queryContractId insurer policyCid
  setTime tok.expiry

  submitMustFail oracleOperator do
    exerciseCmd policyCid PolicyToken_ArchiveForExpiry with
      reason = "policy term expired"

  submitMustFail policyholder do
    exerciseCmd policyCid PolicyToken_ArchiveForExpiry with
      reason = "policy term expired"

  submit insurer do
    exerciseCmd policyCid PolicyToken_ArchiveForExpiry with
      reason = "policy term expired"

  remaining <- queryContractId insurer policyCid
  assert (isNone remaining)

-- Expiry must archive a multi-coverage policy outright --
-- no re-mint, no special-casing per coverage. Complements
-- test_archiveForExpiry (single coverage) by proving the same choice works
-- unchanged when there's more than one coverage to carry nothing forward
-- for.
test_archiveForExpiryArchivesMultiCoveragePolicy : Script ()
test_archiveForExpiryArchivesMultiCoveragePolicy = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let fireCoverage = Coverage with
        coverageCode = "FIRE"
        sumInsured = 100000.0
        remainingLimit = 100000.0
        payoutTiers = frostTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
      glassCoverage = Coverage with
        coverageCode = "GLASS"
        sumInsured = 20000.0
        remainingLimit = 20000.0
        payoutTiers = frostTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [fireCoverage, glassCoverage]
  -- v22: the archive waits for expiry on the ledger clock.
  Some tok <- queryContractId insurer policyCid
  setTime tok.expiry

  submit insurer do
    exerciseCmd policyCid PolicyToken_ArchiveForExpiry with
      reason = "policy term expired"

  remaining <- queryContractId insurer policyCid
  assert (isNone remaining)

-- A partially-paid policy (one coverage already drawn
-- down by a real payout, not just minted with a lower remainingLimit)
-- must still expire the same way -- the unused limit on the untouched
-- coverage lapses with it, since there is no re-mint for it to survive in.
test_archiveForExpiryArchivesPartiallyPaidPolicy : Script ()
test_archiveForExpiryArchivesPartiallyPaidPolicy = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let fireCoverage = Coverage with
        coverageCode = "FIRE"
        sumInsured = 100000.0
        remainingLimit = 100000.0
        payoutTiers = frostTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
      glassCoverage = Coverage with
        coverageCode = "GLASS"
        sumInsured = 20000.0
        remainingLimit = 20000.0
        payoutTiers = frostTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
  policyCid1 <- mintTestPolicy insurer policyholder insured oracleOperator None None [fireCoverage, glassCoverage]
  now <- getTime

  -- Mild frost on FIRE: 25% payout, re-mints with FIRE.remainingLimit
  -- reduced and GLASS untouched at its full 20000 -- this is the "still
  -- has limit left on GLASS" partially-paid state the task asks for.
  reachEventEnd (addRelTime now (days 1))
  triggerResult <- submit oracleOperator do
    exerciseCmd policyCid1 PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid1
      coverageCode = "FIRE"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-partial-fire"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert triggerResult.trigger.matched
  Some policyCid2 <- pure triggerResult.newPolicyCid
  Some partiallyPaid <- queryContractId insurer policyCid2
  assert (partiallyPaid.status == PS_PartiallyPaid)

  -- v22: the archive waits for expiry on the ledger clock.
  setTime partiallyPaid.expiry
  submit insurer do
    exerciseCmd policyCid2 PolicyToken_ArchiveForExpiry with
      reason = "policy term expired"

  remaining <- queryContractId insurer policyCid2
  assert (isNone remaining)   -- gone regardless of GLASS's still-unused limit

-- Notice served leaves coverage fully in force --
-- coverageValidThrough must be byte-for-byte untouched, only status and
-- the two notice fields change. Also the authorization proof for
-- PolicyToken_ServeNotice: every observer role must fail, insurer alone
-- must succeed.
test_serveNoticeLeavesCoverageValidThroughUntouched : Script ()
test_serveNoticeLeavesCoverageValidThroughUntouched = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  beneficiary <- allocateParty "Beneficiary"
  mortgagee <- allocateParty "Mortgagee"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator
    (Some beneficiary) (Some mortgagee) [frostCoverage]
  now <- getTime
  let serviceDate = time (date 2026 Sep 1) 12 0 0
  Some original <- queryContractId insurer policyCid  -- pre-notice, for comparison

  submitMustFail policyholder do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = serviceDate
      noticeRecordedAt = now
  submitMustFail insured do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = serviceDate
      noticeRecordedAt = now
  submitMustFail oracleOperator do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = serviceDate
      noticeRecordedAt = now
  submitMustFail beneficiary do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = serviceDate
      noticeRecordedAt = now
  submitMustFail mortgagee do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = serviceDate
      noticeRecordedAt = now

  newCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = serviceDate
      noticeRecordedAt = now

  Some inGrace <- queryContractId insurer newCid
  assert (inGrace.defaultState == DS_GracePeriod)
  assert (inGrace.status == PS_Active)   -- claim axis untouched by notice
  assert (inGrace.coverageValidThrough == original.coverageValidThrough)  -- untouched
  assert (inGrace.coverageValidThrough == inGrace.expiry)  -- still equal, nothing moved yet
  assert (inGrace.noticeServiceDate == Some serviceDate)
  assert (inGrace.noticeRecordedAt == Some now)
  assert (inGrace.version == 2)
  old <- queryContractId insurer policyCid
  assert (isNone old)

-- A loss during the grace period is exactly as payable as
-- one against an ordinary active policy -- this is the whole point of
-- keeping DS_GracePeriod distinct from DS_Terminated: cover during the
-- notice period is real.
test_triggerPaysDuringGracePeriod : Script ()
test_triggerPaysDuringGracePeriod = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  inGraceCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now

  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd inGraceCid PolicyToken_EvaluateTrigger with
      selfContractId = show inGraceCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-during-grace"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched
  assert (result.trigger.payoutAmount == 25000.0)
  Some newPolicyCid <- pure result.newPolicyCid
  Some paidWhileInGrace <- queryContractId insurer newPolicyCid
  assert (paidWhileInGrace.status == PS_PartiallyPaid)  -- pays and re-mints exactly as it would from PS_Active

-- PolicyToken_Terminate must be unreachable directly from
-- DS_None -- a contract cannot be terminated for non-payment without notice
-- having been served and recorded first.
test_terminateNotReachableDirectlyFromActive : Script ()
test_terminateNotReachableDirectlyFromActive = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  submitMustFail insurer do
    exerciseCmd policyCid PolicyToken_Terminate with
      terminationInstant = now
      unrunDays = 100
      mortgageeContinuationEndsAt = None

-- Termination itself. Reachable only from the notice period, sets
-- the coverage end AT the termination instant, records the unrun days, and
-- does NOT archive the token. Also the authorization proof: every observer
-- role must fail, insurer alone must succeed.
test_terminateObserverRolesCannotExerciseInsurerCan : Script ()
test_terminateObserverRolesCannotExerciseInsurerCan = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  beneficiary <- allocateParty "Beneficiary"
  mortgagee <- allocateParty "Mortgagee"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator
    (Some beneficiary) (Some mortgagee) [frostCoverage]
  now <- getTime
  let termInstant = time (date 2026 Sep 15) 12 0 0

  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now

  let terminate = PolicyToken_Terminate with
        terminationInstant = termInstant
        unrunDays = 107
        mortgageeContinuationEndsAt = None
  submitMustFail policyholder do exerciseCmd inNoticeCid terminate
  submitMustFail insured do exerciseCmd inNoticeCid terminate
  submitMustFail oracleOperator do exerciseCmd inNoticeCid terminate
  submitMustFail beneficiary do exerciseCmd inNoticeCid terminate
  submitMustFail mortgagee do exerciseCmd inNoticeCid terminate

  terminatedCid <- submit insurer do exerciseCmd inNoticeCid terminate

  -- The token is still LIVE: termination ends the contract, it does not
  -- burn the token (phase two does, once payouts are resolved).
  Some terminated <- queryContractId insurer terminatedCid
  assert (terminated.defaultState == DS_Terminated)
  assert (terminated.status == PS_Active)                 -- claim axis untouched
  assert (terminated.coverageValidThrough == termInstant) -- cover ends AT termination
  assert (terminated.terminationInstant == Some termInstant)
  assert (terminated.unrunDays == Some 107)
  assert (terminated.expiry == time (date 2026 Dec 31) 12 0 0)  -- expiry never moves
  assert (terminated.coverages == [frostCoverage])
  -- The in-notice version is archived: Terminate is consuming, and the
  -- live token is the new version at terminatedCid.
  gone <- queryContractId insurer inNoticeCid
  assert (isNone gone)

-- A trigger after termination is refused -- there is no contract
-- to claim under. The resulting `failed` outbox row is proven at the Node
-- layer in dispatcher.test.mjs.
test_triggerRejectedAfterTermination : Script ()
test_triggerRejectedAfterTermination = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let termInstant = time (date 2026 Sep 15) 12 0 0

  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  terminatedCid <- submit insurer do
    exerciseCmd inNoticeCid PolicyToken_Terminate with
      terminationInstant = termInstant
      unrunDays = 107
      mortgageeContinuationEndsAt = None

  reachEventEnd (addRelTime termInstant (days 1))
  submitMustFail oracleOperator do
    exerciseCmd terminatedCid PolicyToken_EvaluateTrigger with
      selfContractId = show terminatedCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-after-termination"
      currency = "TRY"
      eventStart = termInstant
      eventEnd = addRelTime termInstant (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

-- v22: termination is judged by the EVENT'S time, not by the state.
-- The token's coverageValidThrough is the termination instant, and the rule
-- is eventEnd <= coverageValidThrough: an event that ended before the
-- termination instant is evaluated although the evaluation comes after it;
-- one that runs past it is refused, even when it started inside cover.
test_triggerEvaluatedForEventBeforeTermination : Script ()
test_triggerEvaluatedForEventBeforeTermination = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let termInstant = time (date 2026 Sep 15) 12 0 0

  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  terminatedCid <- submit insurer do
    exerciseCmd inNoticeCid PolicyToken_Terminate with
      terminationInstant = termInstant
      unrunDays = 107
      mortgageeContinuationEndsAt = None
  let trig evStart evEnd = PolicyToken_EvaluateTrigger with
        selfContractId = show terminatedCid
        coverageCode = "FROST"
        observedValue = -2.0
        metric = "TEMPERATURE_C"
        attestationRef = "reading-around-termination"
        currency = "TRY"
        eventStart = evStart
        eventEnd = evEnd
        cellCommitment = testCellCommitment
        evidenceDigest = testEvidenceDigest
  -- v22: every window below has ended on the ledger clock.
  reachEventEnd (addRelTime termInstant (hours 1))

  -- Straddles the termination instant: refused.
  submitMustFail oracleOperator do
    exerciseCmd terminatedCid (trig (addRelTime termInstant (hours (-1))) (addRelTime termInstant (hours 1)))

  -- Ends exactly at the termination instant (the end is exclusive): evaluated
  -- and paid, on a DS_Terminated token.
  result <- submit oracleOperator do
    exerciseCmd terminatedCid (trig (addRelTime termInstant (days (-1))) termInstant)
  assert result.trigger.matched
  assert (result.trigger.payoutAmount == 25000.0)
  Some newCid <- pure result.newPolicyCid
  Some after <- queryContractId insurer newCid
  assert (after.defaultState == DS_Terminated)   -- the default axis is untouched
  assert (after.coverageValidThrough == termInstant)

-- The two-phase shape. A loss during the NOTICE period is payable,
-- the payout survives termination untouched, and the token cannot be
-- archived for non-payment until the contract is terminated.
test_payoutDuringNoticePeriodSurvivesTermination : Script ()
test_payoutDuringNoticePeriodSurvivesTermination = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  let termInstant = time (date 2026 Sep 15) 12 0 0

  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now

  -- A loss inside the notice period: cover is in full force, so it pays.
  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd inNoticeCid PolicyToken_EvaluateTrigger with
      selfContractId = show inNoticeCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "loss-during-notice"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched
  [payoutCidLeg] <- pure result.payouts
  let payoutCid = payoutCidLeg.cid
  Some paidCid <- pure result.newPolicyCid
  Some paid <- queryContractId insurer paidCid
  assert (paid.status == PS_PartiallyPaid)
  assert (paid.defaultState == DS_GracePeriod)   -- still in the notice period

  -- Terminating does not touch the payout: the insurer's obligation
  -- survives the end of the contract.
  terminatedCid <- submit insurer do
    exerciseCmd paidCid PolicyToken_Terminate with
      terminationInstant = termInstant
      unrunDays = 107
      mortgageeContinuationEndsAt = None
  stillOwed <- queryContractId insurer payoutCid
  assert (isSome stillOwed)
  assert (fmap (.amount) stillOwed == Some 25000.0)

  -- Phase two: the token is archived for non-payment only once terminated.
  -- (Whether the payouts are resolved is checked off-ledger -- separate
  -- contracts this template cannot see.)
  -- v22: and not before the termination instant on the ledger clock.
  setTime termInstant
  submit insurer do
    exerciseCmd terminatedCid PolicyToken_ArchiveForNonPayment with
      reason = "premium unpaid; notice period elapsed"
  burned <- queryContractId insurer terminatedCid
  assert (isNone burned)
  -- ...and the payout is STILL there after the policy token is gone.
  survives <- queryContractId insurer payoutCid
  assert (isSome survives)

-- ArchiveForNonPayment is guarded on the ledger, not only in the
-- sweeper that calls it -- a policy that was never terminated cannot be
-- burned for non-payment.
test_archiveForNonPaymentRequiresTermination : Script ()
test_archiveForNonPaymentRequiresTermination = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  submitMustFail insurer do
    exerciseCmd policyCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"

  -- In the notice period is still not enough: the contract has not ended.
  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  submitMustFail insurer do
    exerciseCmd inNoticeCid PolicyToken_ArchiveForNonPayment with
      reason = "premium not paid"

-- Reinstatement is NARROWED to the notice period. Payment inside
-- the period means the default never matured; a terminated contract has
-- ended and cannot be reinstated -- what would follow is a new contract.
test_reinstateRejectedAfterTermination : Script ()
test_reinstateRejectedAfterTermination = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  terminatedCid <- submit insurer do
    exerciseCmd inNoticeCid PolicyToken_Terminate with
      terminationInstant = time (date 2026 Sep 15) 12 0 0
      unrunDays = 107
      mortgageeContinuationEndsAt = None

  submitMustFail insurer do
    exerciseCmd terminatedCid PolicyToken_Reinstate

-- m. 1456(4) and (5): the mortgagee notification, the continuation
-- window opening at termination, and the election -- all recorded, none
-- acted on. A policy with no mortgagee cannot record any of them.
test_mortgageeNoticeWindowAndElectionAreRecorded : Script ()
test_mortgageeNoticeWindowAndElectionAreRecorded = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  mortgagee <- allocateParty "Mortgagee"
  now <- getTime
  let termInstant = time (date 2026 Sep 15) 12 0 0
      windowEnds  = time (date 2026 Sep 30) 12 0 0

  -- No mortgagee: nothing to notify.
  bare <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  bareNotice <- submit insurer do
    exerciseCmd bare PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  submitMustFail insurer do
    exerciseCmd bareNotice PolicyToken_RecordMortgageeNotice with notifiedAt = now

  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator
    None (Some mortgagee) [frostCoverage]
  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now

  notifiedCid <- submit insurer do
    exerciseCmd inNoticeCid PolicyToken_RecordMortgageeNotice with notifiedAt = now
  Some notified <- queryContractId insurer notifiedCid
  assert (notified.mortgageeNotifiedAt == Some now)

  terminatedCid <- submit insurer do
    exerciseCmd notifiedCid PolicyToken_Terminate with
      terminationInstant = termInstant
      unrunDays = 107
      mortgageeContinuationEndsAt = Some windowEnds
  Some terminated <- queryContractId insurer terminatedCid
  assert (terminated.mortgageeContinuationEndsAt == Some windowEnds)
  assert (terminated.mortgageeNotifiedAt == Some now)   -- carried through

  electedCid <- submit insurer do
    exerciseCmd terminatedCid PolicyToken_RecordMortgageeElection with
      election = ME_Continue
  Some elected <- queryContractId insurer electedCid
  assert (elected.mortgageeElection == Some ME_Continue)
  -- Recorded only: nothing in this system acts on ME_Continue.
  assert (elected.defaultState == DS_Terminated)

-- ensure: a continuation window cannot be recorded on a policy with no
-- mortgagee, and termination cannot claim negative unrun days.
test_terminationArgumentGuards : Script ()
test_terminationArgumentGuards = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  inNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now

  submitMustFail insurer do
    exerciseCmd inNoticeCid PolicyToken_Terminate with
      terminationInstant = now
      unrunDays = -1
      mortgageeContinuationEndsAt = None

  submitMustFail insurer do
    exerciseCmd inNoticeCid PolicyToken_Terminate with
      terminationInstant = now
      unrunDays = 10
      mortgageeContinuationEndsAt = Some now   -- no mortgagee on this policy

-- ensure: a coverage's amounts, and the termination facts, cannot be written
-- onto a token directly in a shape no choice would produce.
test_coverageAmountAndTerminationEnsureGuards : Script ()
test_coverageAmountAndTerminationEnsureGuards = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  let base = PolicyToken with
        policyNo = "TEST-AMOUNT-TERMINATION-ENSURE"
        version = 1
        predecessorRef = None
        insurer
        policyholder
        insured
        beneficiary = None
        beneficiaryDescriptorHash = None
        mortgagee = None
        oracleOperator
        coverages = [frostCoverage]
        termStart = time (date 2026 Jan 1) 12 0 0
        expiry = time (date 2026 Dec 31) 12 0 0
        coverageValidThrough = time (date 2026 Dec 31) 12 0 0
        noticeServiceDate = None
        noticeRecordedAt = None
        noticeCount = 0
        noticeServiceDates = []
        twoNoticeElectionAt = None
        twoNoticeEffectiveAt = None
        coverageBeganAt = None
        coverageStartBasis = None
        retroactiveCoverCheckedAt = None
        enforcementFruitlessAt = None
        enforcementRoute = None
        substitutionNotifiedAt = None
        substitutedAt = None
        supersededPolicyholder = None
        premiumDueDate = None
        enforcementCommencedAt = None
        withdrawnAt = None
        withdrawalPath = None
        terminationInstant = None
        unrunDays = None
        mortgageeNotifiedAt = None
        mortgageeContinuationEndsAt = None
        mortgageeElection = None
        mortgageeInfoRequestedAt = None
        mortgageeInfoProvidedAt = None
        status = PS_Active
        defaultState = DS_None
        documentHash = None
        amendmentReason = None

  -- a coverage with nothing insured
  submitMustFail insurer do
    createCmd base with
      coverages = [frostCoverage with sumInsured = 0.0, remainingLimit = 0.0]
  -- a remaining limit above the sum insured
  submitMustFail insurer do
    createCmd base with
      coverages = [frostCoverage with remainingLimit = 100001.0]

  -- a termination instant without unrun days, and unrun days without one
  submitMustFail insurer do
    createCmd base with
      terminationInstant = Some now
      defaultState = DS_Terminated
  submitMustFail insurer do
    createCmd base with unrunDays = Some 30
  -- the terminated state without the termination facts, and the facts
  -- without the state
  submitMustFail insurer do
    createCmd base with defaultState = DS_Terminated
  submitMustFail insurer do
    createCmd base with
      terminationInstant = Some now
      unrunDays = Some 30

  -- control: consistent amounts and consistent termination facts create
  _ <- submit insurer do
    createCmd base with
      coverages = [frostCoverage with remainingLimit = 40000.0]
  ok <- submit insurer do
    createCmd base with
      terminationInstant = Some now
      unrunDays = Some 30
      defaultState = DS_Terminated
  Some created <- queryContractId insurer ok
  assert (created.defaultState == DS_Terminated)

-- A PS_PartiallyPaid policy must stay PS_PartiallyPaid
-- through reinstatement, not come back PS_Active -- here the coverage list
-- itself already shows a reduced remainingLimit from before notice was ever
-- served, and reinstatement must not silently erase a real payout history.
-- Since the status axes were split, PolicyToken_Reinstate never touches
-- status (the inferActiveStatus helper this test first exercised was
-- deleted; see Types.daml).
test_reinstateRestoresPartiallyPaidStatus : Script ()
test_reinstateRestoresPartiallyPaidStatus = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  -- Mild frost first: 25% payout, re-mints at PS_PartiallyPaid.
  reachEventEnd (addRelTime now (days 1))
  triggerResult <- submit oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-before-notice"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  Some partiallyPaidCid <- pure triggerResult.newPolicyCid
  Some partiallyPaid <- queryContractId insurer partiallyPaidCid
  assert (partiallyPaid.status == PS_PartiallyPaid)

  inNoticeCid <- submit insurer do
    exerciseCmd partiallyPaidCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  -- Reinstatement is from the NOTICE PERIOD only. The suspend hop
  -- this test used to make no longer exists -- after the period elapses the
  -- contract is terminated, and a terminated contract is not reinstatable.
  reinstatedCid <- submit insurer do
    exerciseCmd inNoticeCid PolicyToken_Reinstate

  Some reinstated <- queryContractId insurer reinstatedCid
  assert (reinstated.defaultState == DS_None)
  assert (reinstated.status == PS_PartiallyPaid)   -- claim axis was never disturbed
  let Some reinstatedCov = find (\c -> c.coverageCode == "FROST") reinstated.coverages
  assert (reinstatedCov.remainingLimit == 75000.0)  -- the earlier payout is not undone

-- m. 1434(4) counts notices within one insurance period. Reinstatement must
-- NOT reset that count -- paying after the first notice is precisely the
-- situation the paragraph is about, so zeroing on payment would erase the
-- only fact that makes a second notice a second one. Counting is all that
-- happens here; nothing reads the number and acts on it.
test_secondNoticeInSamePeriodIsCounted : Script ()
test_secondNoticeInSamePeriodIsCounted = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  Some minted <- queryContractId insurer policyCid
  assert (minted.noticeCount == 0)

  firstNoticeCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  Some firstNotice <- queryContractId insurer firstNoticeCid
  assert (firstNotice.noticeCount == 1)

  paidCid <- submit insurer do
    exerciseCmd firstNoticeCid PolicyToken_Reinstate
  Some paid <- queryContractId insurer paidCid
  assert (paid.defaultState == DS_None)
  assert (paid.noticeCount == 1)   -- payment does not un-serve the notice

  secondNoticeCid <- submit insurer do
    exerciseCmd paidCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  Some secondNotice <- queryContractId insurer secondNoticeCid
  assert (secondNotice.noticeCount == 2)
  assert (secondNotice.defaultState == DS_GracePeriod)

-- ensure must reject noticeServiceDate/noticeRecordedAt disagreeing about
-- which one is Some -- these are only ever meant to be set together.
test_noticeFieldsEnsureRejectsMismatch : Script ()
test_noticeFieldsEnsureRejectsMismatch = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  submitMustFail insurer do
    createCmd PolicyToken with
      policyNo = "TEST-POLICY-NOTICE-FIELD-MISMATCH"
      version = 1
      predecessorRef = None
      insurer
      policyholder
      insured
      beneficiary = None
      beneficiaryDescriptorHash = None
      coverageBeganAt = None
      coverageStartBasis = None
      retroactiveCoverCheckedAt = None
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee = None
      oracleOperator
      coverages = [frostCoverage]
      termStart = time (date 2026 Jan 1) 12 0 0
      expiry = time (date 2026 Dec 31) 12 0 0
      coverageValidThrough = time (date 2026 Dec 31) 12 0 0
      noticeServiceDate = Some now
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
      defaultState = DS_None
      documentHash = None
      amendmentReason = None

-- ---------------------------------------------------------------------------
-- The two status axes are independent
-- ---------------------------------------------------------------------------

-- The defect the split fixes, proven at the ledger layer: a payout during
-- the grace period moves the CLAIM axis and must leave the DEFAULT axis
-- exactly where it was. Before the split these shared one field, so the
-- re-mint silently dropped the policy out of the default flow entirely.
test_payoutDuringGraceLeavesDefaultStateUntouched : Script ()
test_payoutDuringGraceLeavesDefaultStateUntouched = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  inGraceCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now

  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd inGraceCid PolicyToken_EvaluateTrigger with
      selfContractId = show inGraceCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-during-grace-axes"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched
  Some paidCid <- pure result.newPolicyCid
  Some paid <- queryContractId insurer paidCid

  assert (paid.status == PS_PartiallyPaid)          -- claim axis moved
  assert (paid.defaultState == DS_GracePeriod)      -- default axis did NOT
  -- ...and the policy is therefore still TERMINABLE, which is the whole
  -- point: a claim payout is not a premium payment.
  terminatedCid <- submit insurer do
    exerciseCmd paidCid PolicyToken_Terminate with
      terminationInstant = now
      unrunDays = 30
      mortgageeContinuationEndsAt = None
  Some terminated <- queryContractId insurer terminatedCid
  assert (terminated.defaultState == DS_Terminated)
  assert (terminated.status == PS_PartiallyPaid)    -- claim history survives

-- ---------------------------------------------------------------------------
-- Endorsements
-- ---------------------------------------------------------------------------

-- Default argument set for PolicyToken_Amend: changes nothing. Each test
-- overrides only the fields it is actually about, which keeps the
-- intent of each one readable.
amendNothing : PolicyToken_Amend
amendNothing = PolicyToken_Amend with
  reason = ER_Correction
  sumInsuredChanges = []
  coveragesToAdd = []
  coverageCodesToRemove = []
  newExpiry = None
  changeBeneficiary = False
  newBeneficiary = None
  changeMortgagee = False
  newMortgagee = None
  newDocumentHash = None

-- Raising a sum insured raises the remaining limit by the SAME delta. It
-- does not reset the remaining limit to the new sum insured -- a policy
-- that has already paid out keeps that history.
test_amendRaisingSumInsuredMovesRemainingByDelta : Script ()
test_amendRaisingSumInsuredMovesRemainingByDelta = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  -- Pay 25% first: 100000 sum insured, 75000 remaining.
  reachEventEnd (addRelTime now (days 1))
  triggerResult <- submit oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-before-endorsement"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  Some paidCid <- pure triggerResult.newPolicyCid

  amendedCid <- submit insurer do
    exerciseCmd paidCid amendNothing with
      reason = ER_SumInsuredIncrease
      sumInsuredChanges = [("FROST", 150000.0)]

  Some amended <- queryContractId insurer amendedCid
  let Some cov = find (\c -> c.coverageCode == "FROST") amended.coverages
  assert (cov.sumInsured == 150000.0)
  assert (cov.remainingLimit == 125000.0)   -- 75000 + 50000 delta, NOT 150000
  assert (amended.amendmentReason == Some ER_SumInsuredIncrease)
  assert (amended.version == 3)

-- Lowering a sum insured below what has already been paid out would drive
-- remainingLimit negative. That is refused by the template's own ensure
-- rather than silently clamped to zero -- clamping would quietly forgive
-- the difference, which is a money decision this choice cannot make.
test_amendReducingSumInsuredBelowPaidOutIsRejected : Script ()
test_amendReducingSumInsuredBelowPaidOutIsRejected = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  reachEventEnd (addRelTime now (days 1))
  triggerResult <- submit oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-before-reduction"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  Some paidCid <- pure triggerResult.newPolicyCid   -- 100000 insured, 75000 left

  -- Down to 10000 would mean 75000 + (10000 - 100000) = -15000 remaining.
  submitMustFail insurer do
    exerciseCmd paidCid amendNothing with
      reason = ER_SumInsuredReduction
      sumInsuredChanges = [("FROST", 10000.0)]

-- Adding and removing coverages in one endorsement.
test_amendAddsAndRemovesCoverages : Script ()
test_amendAddsAndRemovesCoverages = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let glassCoverage = Coverage with
        coverageCode = "GLASS"
        sumInsured = 20000.0
        remainingLimit = 20000.0
        payoutTiers = frostTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
      theftCoverage = Coverage with
        coverageCode = "THEFT"
        sumInsured = 30000.0
        remainingLimit = 30000.0
        payoutTiers = frostTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None
    [frostCoverage, glassCoverage]

  amendedCid <- submit insurer do
    exerciseCmd policyCid amendNothing with
      reason = ER_InsuredObjectChange
      coverageCodesToRemove = ["GLASS"]
      coveragesToAdd = [theftCoverage]

  Some amended <- queryContractId insurer amendedCid
  assert (map (.coverageCode) amended.coverages == ["FROST", "THEFT"])
  let Some frost = find (\c -> c.coverageCode == "FROST") amended.coverages
  assert (frost.remainingLimit == 100000.0)   -- untouched coverage preserved exactly

-- A coverage that has paid out carries claim history in the gap between its
-- sumInsured and remainingLimit. Dropping it from the list would erase
-- that, so it is refused outright.
test_amendCannotRemoveAPaidOutCoverage : Script ()
test_amendCannotRemoveAPaidOutCoverage = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  reachEventEnd (addRelTime now (days 1))
  triggerResult <- submit oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-before-removal"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  Some paidCid <- pure triggerResult.newPolicyCid

  submitMustFail insurer do
    exerciseCmd paidCid amendNothing with
      reason = ER_InsuredObjectChange
      coverageCodesToRemove = ["FROST"]

-- An endorsement can never empty the coverage list or duplicate a code.
test_amendCannotEmptyOrDuplicateCoverages : Script ()
test_amendCannotEmptyOrDuplicateCoverages = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]

  submitMustFail insurer do
    exerciseCmd policyCid amendNothing with
      reason = ER_InsuredObjectChange
      coverageCodesToRemove = ["FROST"]

  submitMustFail insurer do
    exerciseCmd policyCid amendNothing with
      reason = ER_InsuredObjectChange
      coveragesToAdd = [frostCoverage]   -- FROST already present

-- An endorsement names only coverages the policy has, and cannot add one
-- whose remaining limit is above its sum insured.
test_amendRefusesUnknownCodesAndAnOverfullCoverage : Script ()
test_amendRefusesUnknownCodesAndAnOverfullCoverage = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]

  submitMustFail insurer do
    exerciseCmd policyCid amendNothing with
      reason = ER_InsuredObjectChange
      coverageCodesToRemove = ["NOT-A-COVERAGE"]
  -- Refused rather than silently ignored: without the guard the change
  -- would simply match nothing and the endorsement would go through.
  submitMustFail insurer do
    exerciseCmd policyCid amendNothing with
      reason = ER_SumInsuredIncrease
      sumInsuredChanges = [("NOT-A-COVERAGE", 150000.0)]
  submitMustFail insurer do
    exerciseCmd policyCid amendNothing with
      reason = ER_InsuredObjectChange
      coveragesToAdd = [frostCoverage with coverageCode = "GLASS", remainingLimit = 100001.0]

  -- control: the same endorsements naming a real code, or adding a coherent
  -- coverage, go through
  amendedCid <- submit insurer do
    exerciseCmd policyCid amendNothing with
      reason = ER_SumInsuredIncrease
      sumInsuredChanges = [("FROST", 150000.0)]
      coveragesToAdd = [frostCoverage with coverageCode = "GLASS"]
  _ <- submit insurer do
    exerciseCmd amendedCid amendNothing with
      reason = ER_InsuredObjectChange
      coverageCodesToRemove = ["GLASS"]
  pure ()

-- A terminated contract has ended. There is nothing left to amend.
test_amendRejectedWhileTerminated : Script ()
test_amendRejectedWhileTerminated = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  inGraceCid <- submit insurer do
    exerciseCmd policyCid PolicyToken_ServeNotice with
      noticeServiceDate = now
      noticeRecordedAt = now
  terminatedCid <- submit insurer do
    exerciseCmd inGraceCid PolicyToken_Terminate with
      terminationInstant = now
      unrunDays = 30
      mortgageeContinuationEndsAt = None

  submitMustFail insurer do
    exerciseCmd terminatedCid amendNothing with
      reason = ER_SumInsuredIncrease
      sumInsuredChanges = [("FROST", 150000.0)]

-- Extending the term moves expiry and coverageValidThrough together --
-- letting them drift apart is exactly what the two-field split prevents.
-- Roles can be changed in the same endorsement.
test_amendExtendsTermAndChangesRoles : Script ()
test_amendExtendsTermAndChangesRoles = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  beneficiary <- allocateParty "NewBeneficiary"
  bank <- allocateParty "Bank"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None (Some bank) [frostCoverage]
  let extendedTo = time (date 2027 Jun 30) 12 0 0

  amendedCid <- submit insurer do
    exerciseCmd policyCid amendNothing with
      reason = ER_Correction
      newExpiry = Some extendedTo
      changeBeneficiary = True
      newBeneficiary = Some beneficiary

  Some amended <- queryContractId insurer amendedCid
  assert (amended.expiry == extendedTo)
  assert (amended.coverageValidThrough == extendedTo)   -- moved together
  assert (amended.beneficiary == Some beneficiary)
  assert (amended.mortgagee == Some bank)               -- untouched: changeMortgagee = False

-- Only the insurer may amend. Every observer role must fail.
test_amendObserverRolesCannotExercise : Script ()
test_amendObserverRolesCannotExercise = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  beneficiary <- allocateParty "Beneficiary"
  mortgagee <- allocateParty "Mortgagee"
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator
    (Some beneficiary) (Some mortgagee) [frostCoverage]
  let bump = amendNothing with
        reason = ER_SumInsuredIncrease
        sumInsuredChanges = [("FROST", 150000.0)]

  submitMustFail policyholder do exerciseCmd policyCid bump
  submitMustFail insured do exerciseCmd policyCid bump
  submitMustFail oracleOperator do exerciseCmd policyCid bump
  submitMustFail beneficiary do exerciseCmd policyCid bump
  submitMustFail mortgagee do exerciseCmd policyCid bump

  -- Positive control, so the failures above prove an authorization boundary
  -- rather than a broken fixture.
  _ <- submit insurer do exerciseCmd policyCid bump
  pure ()

-- ---------------------------------------------------------------------------
-- Renewal (tecditname)
-- ---------------------------------------------------------------------------

-- Renewal is the one lifecycle mechanism that does NOT archive the policy it
-- acts on: it mints a separate token for a new period and leaves the
-- predecessor running. There is no `Renew` choice to test -- the preconditions
-- (not in default, not already renewed, renewable status) are enforced in
-- dispatch/dispatcher.js against the SQL mirror, because the normal renewal
-- case is renewing an already-EXPIRED policy, which has no live token to
-- exercise anything against. See handleRenewal's own comment. What the Daml
-- layer owns, and what these tests cover, is the shape of the resulting
-- token: predecessorRef set, limits at full, predecessor untouched, and the
-- no-self-succession invariant.

-- Mints a renewal-shaped token: a NEW policyNo pointing back at a
-- predecessor, at full limits. Mirrors what handleRenewal builds.
mintRenewalPolicy
  : Party -> Party -> Party -> Party
  -> Text -> Text -> [Coverage]
  -> Script (ContractId PolicyToken)
mintRenewalPolicy insurer policyholder insured oracleOperator newPolicyNo predecessorNo coverages =
  submit insurer do
    createCmd PolicyToken with
      policyNo = newPolicyNo
      version = 1
      predecessorRef = Some predecessorNo
      insurer
      policyholder
      insured
      beneficiary = None
      beneficiaryDescriptorHash = None
      coverageBeganAt = None
      coverageStartBasis = None
      retroactiveCoverCheckedAt = None
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee = None
      oracleOperator
      coverages
      termStart = time (date 2027 Jan 1) 12 0 0
      expiry = time (date 2027 Dec 31) 12 0 0
      coverageValidThrough = time (date 2027 Dec 31) 12 0 0
      noticeServiceDate = None
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
      defaultState = DS_None
      documentHash = None
      amendmentReason = None

-- The core of renewal, and the exact inverse of PolicyToken_Amend: the new
-- period starts at its FULL limit regardless of what the old period
-- consumed. Amend moves remainingLimit by a delta so a drawn-down limit is
-- never silently restored; renewal restores it on purpose, because it is a
-- different period of cover.
test_renewalResetsLimitsRegardlessOfPredecessorConsumption : Script ()
test_renewalResetsLimitsRegardlessOfPredecessorConsumption = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  predecessorCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]

  -- Consume 25% of the predecessor's limit, so it is genuinely drawn down.
  reachEventEnd (addRelTime now (days 1))
  triggerResult <- submit oracleOperator do
    exerciseCmd predecessorCid PolicyToken_EvaluateTrigger with
      selfContractId = show predecessorCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-before-renewal"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  Some drawnDownCid <- pure triggerResult.newPolicyCid
  Some drawnDown <- queryContractId insurer drawnDownCid
  let Some oldCov = find (\c -> c.coverageCode == "FROST") drawnDown.coverages
  assert (oldCov.remainingLimit == 75000.0)   -- predecessor is at 75k of 100k

  -- The successor is minted at FULL limit -- nothing consults the 75000.
  successorCid <- mintRenewalPolicy insurer policyholder insured oracleOperator
    "TEST-POLICY-2" "TEST-POLICY-1" [frostCoverage]
  Some successor <- queryContractId insurer successorCid
  let Some newCov = find (\c -> c.coverageCode == "FROST") successor.coverages
  assert (newCov.remainingLimit == 100000.0)
  assert (newCov.remainingLimit == newCov.sumInsured)
  assert (successor.predecessorRef == Some "TEST-POLICY-1")
  assert (successor.version == 1)             -- a new period starts at version 1
  assert (successor.policyNo == "TEST-POLICY-2")

  -- ...and the predecessor is completely untouched and still live.
  Some stillLive <- queryContractId insurer drawnDownCid
  let Some stillDrawnDown = find (\c -> c.coverageCode == "FROST") stillLive.coverages
  assert (stillDrawnDown.remainingLimit == 75000.0)
  assert (stillLive.status == PS_PartiallyPaid)
  assert (stillLive.version == 2)
  assert (isNone stillLive.predecessorRef)

-- Both tokens are live at once during the overlap between the two terms.
-- That is correct and must not be treated as an error anywhere.
test_renewalLeavesBothTokensLiveSimultaneously : Script ()
test_renewalLeavesBothTokensLiveSimultaneously = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  _ <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  _ <- mintRenewalPolicy insurer policyholder insured oracleOperator
    "TEST-POLICY-2" "TEST-POLICY-1" [frostCoverage]

  active <- query @PolicyToken insurer
  assert (length active == 2)
  -- Same policyholder party on both -- the party is reused, never
  -- reallocated for a renewal.
  let holders = map (\(_, t) -> t.policyholder) active
  assert (all (== policyholder) holders)

-- A renewed policy keeps evaluating triggers on its own remaining limit,
-- entirely independently of its successor. Nothing about the renewal
-- interferes with the old period still being live cover.
test_predecessorStillTriggerableAfterRenewal : Script ()
test_predecessorStillTriggerableAfterRenewal = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  predecessorCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  _ <- mintRenewalPolicy insurer policyholder insured oracleOperator
    "TEST-POLICY-2" "TEST-POLICY-1" [frostCoverage]

  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd predecessorCid PolicyToken_EvaluateTrigger with
      selfContractId = show predecessorCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-on-predecessor-after-renewal"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched
  assert (result.trigger.payoutAmount == 25000.0)   -- off the predecessor's own limit

-- ensure: a policy cannot succeed itself. A predecessorRef equal to the
-- token's own policyNo would be a cycle in the supersession chain.
test_policyCannotBeItsOwnPredecessor : Script ()
test_policyCannotBeItsOwnPredecessor = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  submitMustFail insurer do
    createCmd PolicyToken with
      policyNo = "TEST-POLICY-SELF-SUCCESSION"
      version = 1
      predecessorRef = Some "TEST-POLICY-SELF-SUCCESSION"
      insurer
      policyholder
      insured
      beneficiary = None
      beneficiaryDescriptorHash = None
      coverageBeganAt = None
      coverageStartBasis = None
      retroactiveCoverCheckedAt = None
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee = None
      oracleOperator
      coverages = [frostCoverage]
      termStart = time (date 2026 Jan 1) 12 0 0
      expiry = time (date 2026 Dec 31) 12 0 0
      coverageValidThrough = time (date 2026 Dec 31) 12 0 0
      noticeServiceDate = None
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
      defaultState = DS_None
      documentHash = None
      amendmentReason = None

-- An endorsement carries predecessorRef through untouched -- amending a
-- renewed policy must not sever or rewrite its link to the period it
-- succeeded.
test_amendPreservesPredecessorRef : Script ()
test_amendPreservesPredecessorRef = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  successorCid <- mintRenewalPolicy insurer policyholder insured oracleOperator
    "TEST-POLICY-2" "TEST-POLICY-1" [frostCoverage]

  amendedCid <- submit insurer do
    exerciseCmd successorCid amendNothing with
      reason = ER_SumInsuredIncrease
      sumInsuredChanges = [("FROST", 150000.0)]

  Some amended <- queryContractId insurer amendedCid
  assert (amended.predecessorRef == Some "TEST-POLICY-1")
  assert (amended.policyNo == "TEST-POLICY-2")   -- identity unchanged by an endorsement
  assert (amended.version == 2)

-- ---------------------------------------------------------------------------
-- Closing the payout loop
-- ---------------------------------------------------------------------------

-- Drives a policy to a matched payout and returns the live PayoutApproved.
-- The frost fixture's severe tier pays 100%, which closes the policy and
-- leaves exactly one PayoutApproved behind.
approvedPayout : Script (Party, Party, Party, Party, ContractId PayoutApproved)
approvedPayout = do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-stage4"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  [payoutCidLeg] <- pure result.payouts
  let payoutCid = payoutCidLeg.cid
  pure (insurer, policyholder, insured, oracleOperator, payoutCid)

-- A reported settlement closes the payout, and the same payout cannot be
-- settled a second time -- the contract is gone.
test_settlementClosesPayoutAndCannotRepeat : Script ()
test_settlementClosesPayoutAndCannotRepeat = script do
  (insurer, _, _, _, payoutCid) <- approvedPayout
  now <- getTime

  submit insurer do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured

  gone <- queryContractId insurer payoutCid
  assert (isNone gone)   -- closed, not merely flagged

  submitMustFail insurer do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured

-- The ledger cannot verify money moved, but it refuses an assertion that
-- contradicts the policy: frostCoverage's payoutDestination is [PDR_Insured],
-- so a settlement claiming to have paid the mortgagee is rejected.
test_settlementRejectsRoleNotInPayoutDestination : Script ()
test_settlementRejectsRoleNotInPayoutDestination = script do
  (insurer, _, _, _, payoutCid) <- approvedPayout
  now <- getTime

  submitMustFail insurer do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Mortgagee

  submitMustFail insurer do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Beneficiary

  -- ...and an empty bank reference is refused too.
  submitMustFail insurer do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = ""
      settledAt = now
      paidRole = PDR_Insured

  -- Positive control: the allowed role still works, so the failures above
  -- are the role check and not a broken fixture.
  _ <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured
  pure ()

-- A failed payout produces a review item that carries the link back to the
-- payout it came from, and the coverage it came from. Previously only
-- policyId travelled, which is ambiguous once a policy has several payouts.
test_markFailedCarriesSourceAndCoverage : Script ()
test_markFailedCarriesSourceAndCoverage = script do
  (insurer, _, _, _, payoutCid) <- approvedPayout

  reviewCid <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_MarkFailed with
      failureReason = "payee account closed"
      sourcePayoutContractId = show payoutCid

  Some review <- queryContractId insurer reviewCid
  -- The Text link is stored exactly as the caller passed it (here
  -- `show payoutCid`); the choice no longer captures it as `show self`,
  -- because a ContractId renders differently inside a choice body than in
  -- script context -- on the participant as the literal "<contract-id>".
  -- An echo of the argument proves little, so the Text is only checked
  -- non-empty and the exact link is asserted on the typed sourcePayoutCid,
  -- which the choice sets from `self`. The live run in
  -- development shows the real recorded value matching the
  -- archived payout's own contract id.
  assert (review.sourcePayoutContractId /= "")
  assert (review.sourcePayoutCid == Some payoutCid)
  assert (review.coverageCode == "FROST")
  assert (review.reason == "payee account closed")
  assert (review.amount == 100000.0)
  gone <- queryContractId insurer payoutCid
  assert (isNone gone)

  -- A failure with no reason is refused.
  (insurer2, _, _, _, payoutCid2) <- approvedPayout
  submitMustFail insurer2 do
    exerciseCmd payoutCid2 PayoutApproved_MarkFailed with
      failureReason = ""
      sourcePayoutContractId = show payoutCid2
  -- Nor is one with no link back to the payout.
  submitMustFail insurer2 do
    exerciseCmd payoutCid2 PayoutApproved_MarkFailed with
      failureReason = "payee account closed"
      sourcePayoutContractId = ""
  -- control: the same payout with both fields given is marked failed
  _ <- submit insurer2 do
    exerciseCmd payoutCid2 PayoutApproved_MarkFailed with
      failureReason = "payee account closed"
      sourcePayoutContractId = show payoutCid2
  pure ()

-- Exit 1: the review item is closed as settled after all, recording the same
-- evidence the normal path records.
test_reviewItemResolvesSettled : Script ()
test_reviewItemResolvesSettled = script do
  (insurer, _, _, _, payoutCid) <- approvedPayout
  now <- getTime
  reviewCid <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_MarkFailed with
      failureReason = "payee account closed"
      sourcePayoutContractId = show payoutCid

  submit insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured

  gone <- queryContractId insurer reviewCid
  assert (isNone gone)

  -- No bank reference, no resolution.
  (insurer2, _, _, _, payoutCid2) <- approvedPayout
  reviewCid2 <- submit insurer2 do
    exerciseCmd payoutCid2 PayoutApproved_MarkFailed with
      failureReason = "dispute"
      sourcePayoutContractId = show payoutCid2
  submitMustFail insurer2 do
    exerciseCmd reviewCid2 ManualReviewRequired_ResolveSettled with
      bankReference = ""
      settledAt = now
      paidRole = PDR_Insured

-- Exit 2: the review item is closed unpaid, with an enumerated reason and a
-- mandatory note. Recording an outcome is not a legal conclusion about
-- whether the indemnity was lawfully extinguished.
test_reviewItemResolvesUnpaid : Script ()
test_reviewItemResolvesUnpaid = script do
  (insurer, _, _, _, payoutCid) <- approvedPayout
  now <- getTime
  reviewCid <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_MarkFailed with
      failureReason = "claimant contests the amount"
      sourcePayoutContractId = show payoutCid

  -- A note is mandatory: the enum alone cannot carry the circumstances.
  submitMustFail insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Disputed
      note = ""
      closedAt = now

  submit insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Litigation
      note = testTextDigest
      closedAt = now

  gone <- queryContractId insurer reviewCid
  assert (isNone gone)

-- Every one of the new choices is insurer-only. policyholder is an observer
-- on both templates and oracleOperator is a signatory on PayoutApproved --
-- neither may settle, fail, or resolve anything.
test_payoutChoicesAreInsurerOnly : Script ()
test_payoutChoicesAreInsurerOnly = script do
  (insurer, policyholder, _, oracleOperator, payoutCid) <- approvedPayout
  now <- getTime

  submitMustFail policyholder do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured
  submitMustFail oracleOperator do
    exerciseCmd payoutCid PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured
  submitMustFail policyholder do
    exerciseCmd payoutCid PayoutApproved_MarkFailed with
      failureReason = "ATTACK"
      sourcePayoutContractId = "x"
  submitMustFail oracleOperator do
    exerciseCmd payoutCid PayoutApproved_MarkFailed with
      failureReason = "ATTACK"
      sourcePayoutContractId = "x"

  -- Positive control for insurer on MarkFailed, which also gives us a
  -- review item to attack.
  reviewCid <- submit insurer do
    exerciseCmd payoutCid PayoutApproved_MarkFailed with
      failureReason = "payee not found"
      sourcePayoutContractId = show payoutCid

  submitMustFail policyholder do
    exerciseCmd reviewCid ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured
  submitMustFail oracleOperator do
    exerciseCmd reviewCid ManualReviewRequired_ResolveSettled with
      bankReference = testTextDigest
      settledAt = now
      paidRole = PDR_Insured
  submitMustFail policyholder do
    exerciseCmd reviewCid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Waived
      note = testTextDigest
      closedAt = now
  submitMustFail oracleOperator do
    exerciseCmd reviewCid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Waived
      note = testTextDigest
      closedAt = now

  -- Positive control: insurer can resolve, so the failures are an
  -- authorization boundary and not a broken fixture.
  _ <- submit insurer do
    exerciseCmd reviewCid ManualReviewRequired_ResolveUnpaid with
      unpaidReason = UR_Waived
      note = testTextDigest
      closedAt = now
  pure ()

-- ensure: a PayoutApproved cannot exist with no payout destination at all,
-- which would make the role check in ConfirmSettlement unsatisfiable.
test_payoutApprovedRequiresADestination : Script ()
test_payoutApprovedRequiresADestination = script do
  (insurer, policyholder, _, oracleOperator) <- setupParties
  now <- getTime
  -- PDR_EnforcementOffice is the one recipient exempt from the membership
  -- check, so with it an empty payoutDestination breaks only the
  -- `not (null payoutDestination)` clause.
  let base = PayoutApproved with
        insurer
        policyholder
        oracleOperator
        policyId = "TEST-POLICY-1"
        coverageCode = "FROST"
        sourcePolicyContractId = "n/a"
        amount = 1000.0
        recipient = PDR_EnforcementOffice
        mortgagee = None
        currency = "TRY"
        payoutPercentage = 25.0
        tierLabel = "t"
        isFullSettlement = False
        payoutDestination = [PDR_Insured]
        approvedAt = now
        eventStart = now
        eventEnd = addRelTime now (days 1)
        evidenceDigest = testEvidenceDigest
  -- Both signatories act, as in test_payoutRecipientAndMortgageeMustAgree:
  -- a submit by the insurer alone fails on authorization before the ensure
  -- clause is reached.
  submitMustFail (actAs [insurer, oracleOperator]) do
    createCmd base with payoutDestination = []
  -- ...and a leg must carry a positive amount.
  submitMustFail (actAs [insurer, oracleOperator]) do
    createCmd base with amount = 0.0

  -- control: the same record with a destination and an amount creates
  _ <- submit (actAs [insurer, oracleOperator]) do createCmd base
  pure ()

-- ---------------------------------------------------------------------------
-- Role intake: the three beneficiary states, and a mortgagee that is real
-- ---------------------------------------------------------------------------

-- m. 1494(2) attaches a consequence to naming NO beneficiary, so the ledger
-- has to tell "none" apart from "described but not named". These are the
-- three states, and the ensure clause makes them exclusive.
test_beneficiaryDescriptorMintsWithNoParty : Script ()
test_beneficiaryDescriptorMintsWithNoParty = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- submit insurer do
    createCmd PolicyToken with
      policyNo = "TEST-DESCRIPTIVE-BENEFICIARY"
      version = 1
      predecessorRef = None
      insurer
      policyholder
      insured
      beneficiary = None
      -- "my spouse at the time of loss" -- no Party can exist for this,
      -- because no specific person is identified yet. Only the hash is on
      -- the ledger; the text itself never is.
      beneficiaryDescriptorHash = Some "sha256-of-the-descriptive-designation"
      coverageBeganAt = None
      coverageStartBasis = None
      retroactiveCoverCheckedAt = None
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee = None
      oracleOperator
      coverages = [frostCoverage]
      termStart = time (date 2026 Jan 1) 12 0 0
      expiry = time (date 2026 Dec 31) 12 0 0
      coverageValidThrough = time (date 2026 Dec 31) 12 0 0
      noticeServiceDate = None
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
      defaultState = DS_None
      documentHash = None
      amendmentReason = None

  Some policy <- queryContractId insurer policyCid
  assert (isNone policy.beneficiary)
  assert (policy.beneficiaryDescriptorHash == Some "sha256-of-the-descriptive-designation")
  -- Distinguishable on the ledger from a policy with no beneficiary at all,
  -- which is the whole reason the field is here and not in SQL.
  plainCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  Some plain <- queryContractId insurer plainCid
  assert (isNone plain.beneficiary && isNone plain.beneficiaryDescriptorHash)

-- Named and described are alternatives, never both -- otherwise "which one
-- governs" is a question the contract cannot answer.
test_beneficiaryCannotBeBothNamedAndDescribed : Script ()
test_beneficiaryCannotBeBothNamedAndDescribed = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  namedBeneficiary <- allocateParty "NamedBeneficiary"
  submitMustFail insurer do
    createCmd PolicyToken with
      policyNo = "TEST-BOTH-BENEFICIARY-FORMS"
      version = 1
      predecessorRef = None
      insurer
      policyholder
      insured
      beneficiary = Some namedBeneficiary
      beneficiaryDescriptorHash = Some "sha256-of-something-else"
      coverageBeganAt = None
