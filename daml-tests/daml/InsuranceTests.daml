module InsuranceTests where

import Daml.Script
import DA.Date
import DA.Time (time, addRelTime, days, hours, seconds)
import DA.Optional (isNone, isSome)
import Insurance.Types
import Insurance.PolicyToken
import Insurance.PayoutBridge

-- Standard two-tier frost matrix straight from the product brief. The gap
-- between -4C and -2C is deliberately left unmapped -- see README.md --
-- test_mintAndFullLifecycle below asserts a reading in that gap matches
-- nothing rather than silently guessing.
frostTiers : [PayoutTier]
frostTiers =
  [ PayoutTier with
      tierOrder = 1
      label = "Mild frost (-2C to 0C)"
      minValue = Some (-2.0)
      maxValue = Some 0.0
      payoutPct = 25.0
      shape = TS_Step
      pctAtMin = None
      pctAtMax = None
  , PayoutTier with
      tierOrder = 2
      label = "Severe frost (below -4C)"
      minValue = None
      maxValue = Some (-4.0)
      payoutPct = 100.0
      shape = TS_Step
      pctAtMin = None
      pctAtMax = None
  ]

-- The default single-coverage fixture -- today's frost
-- product represented as the one-element coverage list it now has to be.
-- No special case, same shape a two-coverage policy uses.
frostCoverage : Coverage
frostCoverage = Coverage with
  coverageCode = "FROST"
  sumInsured = 100000.0
  remainingLimit = 100000.0
  payoutTiers = frostTiers
  payoutDestination = [PDR_Insured]
  mortgageeClaimAmount = None
  attachedAt = None
  attachmentLiftedAt = None
  metric = "TEMPERATURE_C"
  payoutBasis = PB_RemainingLimit
  cellCommitment = testCellCommitment

-- v22: stand-ins in the "sha256:" + 64 lowercase hex form the ledger checks.
-- Their content means nothing; the salted commitment and the evidence digest
-- are computed off-ledger, and the ledger checks only form and equality.
testCellCommitment : Text
testCellCommitment = "sha256:" <> "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

testEvidenceDigest : Text
testEvidenceDigest = "sha256:" <> "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

setupParties : Script (Party, Party, Party, Party)
setupParties = do
  insurer <- allocateParty "Insurer"
  policyholder <- allocateParty "Policyholder"
  insured <- allocateParty "Insured"
  oracleOperator <- allocateParty "OracleOperator"
  pure (insurer, policyholder, insured, oracleOperator)

mintTestPolicy
  : Party -> Party -> Party -> Party
  -> Optional Party -> Optional Party
  -> [Coverage]
  -> Script (ContractId PolicyToken)
mintTestPolicy insurer policyholder insured oracleOperator beneficiary mortgagee coverages = do
  -- From the LEDGER clock, not a literal: Daml Script's static time starts at
  -- 1970 while these fixtures use 2026 term dates, and any choice that
  -- COMPARES two of these instants (the m. 1421 direction guard does) needs
  -- them on the same timeline.
  coverStart <- getTime
  submit insurer do
    createCmd PolicyToken with
      policyNo = "TEST-POLICY-1"
      version = 1
      predecessorRef = None
      insurer
      policyholder
      insured
      beneficiary
      beneficiaryDescriptorHash = None
      -- m. 1421: minting no longer means the policy is live, so this shared
      -- helper says which it wants. Cover begins with the term here, on the
      -- "aksine sözleşme" basis -- the variation m. 1452(3) permits, being
      -- earlier than payment would have been. Tests about cover NOT having
      -- begun mint their own token; see the m. 1421 block.
      coverageBeganAt = Some coverStart
      coverageStartBasis = Some CSB_AgreedWithoutPayment
      retroactiveCoverCheckedAt = None
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee
      oracleOperator
      coverages
      termStart = time (date 2026 Jan 1) 12 0 0
      expiry = time (date 2026 Dec 31) 12 0 0
      coverageValidThrough = time (date 2026 Dec 31) 12 0 0
      noticeServiceDate = None
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
      defaultState = DS_None
      documentHash = None
      amendmentReason = None

-- Happy path across Modules 1-4's Daml half, single coverage:
--   mint -> a reading in the unmapped gap changes nothing (fails closed) ->
--   a mild-frost reading pays 25% and re-mints at a reduced remainingLimit
--   -> a severe-frost reading on the re-minted policy consumes
--   the rest, archives for good instead of re-minting a worthless 0-limit
--   NFT, and creates a PayoutApproved -> insurer confirms
--   settlement once the (simulated) EFT lands.
test_mintAndFullLifecycle : Script ()
test_mintAndFullLifecycle = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  now <- getTime

  policyCid1 <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]

  Some policy1 <- queryContractId insurer policyCid1
  let Some cov1 = find (\c -> c.coverageCode == "FROST") policy1.coverages
  assert (cov1.remainingLimit == 100000.0)
  assert (policy1.status == PS_Active)
  assert (policy1.version == 1)

  -- -3C: strictly between the two bands. Neither tier's inclusive bounds
  -- cover it, so nothing should match, archive, or re-mint.
  reachEventEnd (addRelTime now (days 1))
  noMatchResult <- submit oracleOperator do
    exerciseCmd policyCid1 PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid1
      coverageCode = "FROST"
      observedValue = -3.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-gap"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert (not noMatchResult.trigger.matched)
  assert (isNone noMatchResult.newPolicyCid)
  assert (null noMatchResult.payouts)
  Some stillThere <- queryContractId insurer policyCid1
  let Some covStillThere = find (\c -> c.coverageCode == "FROST") stillThere.coverages
  assert (covStillThere.remainingLimit == 100000.0)

  -- -2C: the inclusive boundary of the mild-frost tier -> 25% of 100000.
  reachEventEnd (addRelTime now (days 1))
  mildResult <- submit oracleOperator do
    exerciseCmd policyCid1 PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid1
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-mild"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert mildResult.trigger.matched
  assert (mildResult.trigger.payoutPct == 25.0)
  assert (mildResult.trigger.payoutAmount == 25000.0)
  assert (not mildResult.trigger.isFullSettlement)
  Some policyCid2 <- pure mildResult.newPolicyCid
  [payoutCid1Leg] <- pure mildResult.payouts
  let payoutCid1 = payoutCid1Leg.cid

  Some policy2 <- queryContractId insurer policyCid2
  let Some cov2 = find (\c -> c.coverageCode == "FROST") policy2.coverages
  assert (cov2.remainingLimit == 75000.0)
  assert (policy2.status == PS_PartiallyPaid)
  assert (policy2.version == 2)
  archivedCheck <- queryContractId insurer policyCid1
  assert (isNone archivedCheck)   -- old NFT is really gone, not just superseded

  partialPayout <- queryContractId insurer payoutCid1
  assert (isSome partialPayout)
  assert (fmap (.isFullSettlement) partialPayout == Some False)  -- policy still open

  -- -5C on what's left: 100% of the *remaining* 75000, not the original
  -- 100000 -- proves a second claim never re-bases off sumInsured.
  reachEventEnd (addRelTime now (days 1))
  severeResult <- submit oracleOperator do
    exerciseCmd policyCid2 PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid2
      coverageCode = "FROST"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-severe"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert severeResult.trigger.matched
  assert (severeResult.trigger.payoutAmount == 75000.0)
  assert (isNone severeResult.newPolicyCid)   -- fully settled: nothing left to re-mint
  [payoutCid2Leg] <- pure severeResult.payouts
  let payoutCid2 = payoutCid2Leg.cid

  finalPolicy <- queryContractId insurer policyCid2
  assert (isNone finalPolicy)
  finalPayout <- queryContractId insurer payoutCid2
  assert (fmap (.isFullSettlement) finalPayout == Some True)  -- policy now closed

  -- The insurer closes the loop by REPORTING a settlement it made
  -- through its own banking systems. settledAt is its reported date, not a
  -- clock reading, and paidRole must be one the coverage allows.
  settleTime <- getTime
  submit insurer do
    exerciseCmd payoutCid2 PayoutApproved_ConfirmSettlement with
      bankReference = testTextDigest
      settledAt = settleTime
      paidRole = PDR_Insured

  pure ()

-- An activation mints exactly one token -- no duplicate, no stray second
-- contract from any implicit re-create.
test_mintExactlyOneToken : Script ()
test_mintExactlyOneToken = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  _ <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  active <- query @PolicyToken insurer
  assert (length active == 1)

-- beneficiary and mortgagee are genuinely optional: a policy minted with
-- None for both must mint at all (ensure doesn't wrongly reject the
-- all-None case) and must evaluate triggers identically to one with them
-- populated -- their absence is not supposed to change any business
-- outcome.
test_mintWithNoneOptionalRoles : Script ()
test_mintWithNoneOptionalRoles = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime

  Some policy <- queryContractId insurer policyCid
  assert (isNone policy.beneficiary)
  assert (isNone policy.mortgagee)

  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FROST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-no-optional-roles"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched
  assert (result.trigger.payoutAmount == 25000.0)

-- A two-coverage policy: a payout on one coverage must leave the other
-- byte-for-byte unchanged -- the whole point of moving sumInsured/
-- remainingLimit/payoutTiers onto Coverage instead of the policy.
test_multiCoveragePayoutLeavesOtherCoverageUntouched : Script ()
test_multiCoveragePayoutLeavesOtherCoverageUntouched = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let fireCoverage = Coverage with
        coverageCode = "FIRE"
        sumInsured = 100000.0
        remainingLimit = 100000.0
        payoutTiers = frostTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
      glassCoverage = Coverage with
        coverageCode = "GLASS"
        sumInsured = 20000.0
        remainingLimit = 20000.0
        payoutTiers = frostTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [fireCoverage, glassCoverage]
  now <- getTime

  reachEventEnd (addRelTime now (days 1))
  result <- submit oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "FIRE"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-fire"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert result.trigger.matched
  assert (result.trigger.payoutAmount == 25000.0)
  Some newPolicyCid <- pure result.newPolicyCid
  Some newPolicy <- queryContractId insurer newPolicyCid
  let Some newFire = find (\c -> c.coverageCode == "FIRE") newPolicy.coverages
      Some newGlass = find (\c -> c.coverageCode == "GLASS") newPolicy.coverages
  assert (newFire.remainingLimit == 75000.0)
  assert (newGlass.remainingLimit == 20000.0)   -- untouched
  assert (newGlass.sumInsured == 20000.0)       -- untouched
  assert (newGlass.payoutTiers == frostTiers)   -- untouched
  assert (newPolicy.version == 2)

-- A trigger naming a coverage the policy does not have must be rejected
-- outright (assertMsg), never treated as a silent no-match.
test_triggerRejectsUnknownCoverage : Script ()
test_triggerRejectsUnknownCoverage = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  policyCid <- mintTestPolicy insurer policyholder insured oracleOperator None None [frostCoverage]
  now <- getTime
  reachEventEnd (addRelTime now (days 1))
  submitMustFail oracleOperator do
    exerciseCmd policyCid PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid
      coverageCode = "DOES-NOT-EXIST"
      observedValue = -2.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-unknown-coverage"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest

-- A policy with two coverages must stay open and re-mint when only one
-- coverage is exhausted, and close (no new token) only once every
-- coverage is at zero -- proven by exhausting them one at a time.
test_policyClosesOnlyWhenLastCoverageExhausted : Script ()
test_policyClosesOnlyWhenLastCoverageExhausted = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  let totalLossTiers =
        [ PayoutTier with
            tierOrder = 1
            label = "Total loss"
            minValue = None
            maxValue = Some (-4.0)
            payoutPct = 100.0
            shape = TS_Step
            pctAtMin = None
            pctAtMax = None
        ]
      fireCoverage = Coverage with
        coverageCode = "FIRE"
        sumInsured = 10000.0
        remainingLimit = 10000.0
        payoutTiers = totalLossTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
      glassCoverage = Coverage with
        coverageCode = "GLASS"
        sumInsured = 5000.0
        remainingLimit = 5000.0
        payoutTiers = totalLossTiers
        payoutDestination = [PDR_Insured]
        mortgageeClaimAmount = None
        attachedAt = None
        attachmentLiftedAt = None
        metric = "TEMPERATURE_C"
        payoutBasis = PB_RemainingLimit
        cellCommitment = testCellCommitment
  policyCid1 <- mintTestPolicy insurer policyholder insured oracleOperator None None [fireCoverage, glassCoverage]
  now <- getTime

  -- Exhausts FIRE fully -- GLASS still has limit, so the policy stays
  -- open and re-mints rather than closing.
  reachEventEnd (addRelTime now (days 1))
  fireResult <- submit oracleOperator do
    exerciseCmd policyCid1 PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid1
      coverageCode = "FIRE"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-fire-total"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert fireResult.trigger.matched
  assert (fireResult.trigger.payoutAmount == 10000.0)
  Some policyCid2 <- pure fireResult.newPolicyCid  -- policy still open
  [payoutCid1Leg] <- pure fireResult.payouts
  let payoutCid1 = payoutCid1Leg.cid
  payout1 <- queryContractId insurer payoutCid1
  assert (fmap (.isFullSettlement) payout1 == Some False)  -- policy-level: not closed

  -- Exhausts GLASS too -- every coverage is now at zero, so the policy
  -- must close: no new token.
  reachEventEnd (addRelTime now (days 1))
  glassResult <- submit oracleOperator do
    exerciseCmd policyCid2 PolicyToken_EvaluateTrigger with
      selfContractId = show policyCid2
      coverageCode = "GLASS"
      observedValue = -5.0
      metric = "TEMPERATURE_C"
      attestationRef = "reading-glass-total"
      currency = "TRY"
      eventStart = now
      eventEnd = addRelTime now (days 1)
      cellCommitment = testCellCommitment
      evidenceDigest = testEvidenceDigest
  assert glassResult.trigger.matched
  assert (isNone glassResult.newPolicyCid)
  [payoutCid2Leg] <- pure glassResult.payouts
  let payoutCid2 = payoutCid2Leg.cid
  payout2 <- queryContractId insurer payoutCid2
  assert (fmap (.isFullSettlement) payout2 == Some True)  -- policy-level: now closed
  remaining <- queryContractId insurer policyCid2
  assert (isNone remaining)

-- ensure must reject two coverages sharing a coverageCode -- codes are a
-- coverage's permanent identity, and must be unique within the policy.
test_duplicateCoverageCodeRejected : Script ()
test_duplicateCoverageCodeRejected = script do
  (insurer, policyholder, insured, oracleOperator) <- setupParties
  submitMustFail insurer do
    createCmd PolicyToken with
      policyNo = "TEST-POLICY-DUP-COVERAGE"
      version = 1
      predecessorRef = None
      insurer
      policyholder
      insured
      beneficiary = None
      beneficiaryDescriptorHash = None
      coverageBeganAt = None
      coverageStartBasis = None
      retroactiveCoverCheckedAt = None
      enforcementFruitlessAt = None
      enforcementRoute = None
      substitutionNotifiedAt = None
      substitutedAt = None
      supersededPolicyholder = None
      premiumDueDate = None
      enforcementCommencedAt = None
      withdrawnAt = None
      withdrawalPath = None
      mortgagee = None
      oracleOperator
      coverages = [frostCoverage, frostCoverage]
      termStart = time (date 2026 Jan 1) 12 0 0
      expiry = time (date 2026 Dec 31) 12 0 0
      coverageValidThrough = time (date 2026 Dec 31) 12 0 0
      noticeServiceDate = None
      noticeRecordedAt = None
      noticeCount = 0
      noticeServiceDates = []
      twoNoticeElectionAt = None
      twoNoticeEffectiveAt = None
      terminationInstant = None
      unrunDays = None
      mortgageeNotifiedAt = None
      mortgageeContinuationEndsAt = None
      mortgageeElection = None
      mortgageeInfoRequestedAt = None
      mortgageeInfoProvidedAt = None
      status = PS_Active
      defaultState = DS_None
      documentHash = None
      amendmentReason = None

