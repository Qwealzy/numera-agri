module Insurance.Types where

import DA.Optional (isNone)
import qualified DA.Text as T

-- One row of the parametric payout matrix. Bounds are inclusive;
-- None means unbounded on that side. Confirm inclusive/exclusive boundary
-- semantics with underwriting before relying on exact-threshold behavior --
-- this is a real money question at the boundary, not just a style choice.
data PayoutTier = PayoutTier
  with
    tierOrder : Int
    label     : Text
    minValue  : Optional Decimal
    maxValue  : Optional Decimal
    payoutPct : Decimal
    -- v22. TS_Step pays payoutPct, as before. TS_Linear interpolates
    -- between pctAtMin (at minValue) and pctAtMax (at maxValue); both bounds
    -- and both end percentages are then required, and payoutPct is not used
    -- in the amount: it must equal the larger end percentage, the highest
    -- rate the tier can pay (v22).
    -- A step tier carries no end percentages. Enforced by validTier below,
    -- through PolicyToken's ensure. Every value comes from the insurer.
    shape     : TierShape
    pctAtMin  : Optional Decimal
    pctAtMax  : Optional Decimal
  deriving (Eq, Show)

data TierShape
  = TS_Step
  | TS_Linear
  deriving (Eq, Show)

-- v22. What a tier percentage is a percentage OF, per coverage and with
-- no default. The remaining-limit cap applies under both.
data PayoutBasis
  = PB_RemainingLimit
  | PB_SumInsured
  deriving (Eq, Show)

-- Shared lifecycle vocabulary -- SQL's policy_status enum (sql/schema.sql)
-- must use the same states, spelled with the same words (Daml constructor
-- casing aside -- Daml constructors can't be lowercase). SQL additionally
-- has a 'pending_mint' state with no entry here, because a state before a
-- token exists has nothing on-chain to hold a status field in the first
-- place.
--
-- This type is CLAIM/TERM state only. The
-- premium-default states that used to live here (PS_GracePeriod,
-- PS_Suspended) moved to DefaultState below, because they are a second,
-- orthogonal axis -- see that type's comment for the defect that proved
-- it. PS_Cancelled and PS_ManualReview stay here: cancellation is a
-- terminal claim/term outcome, not a default state, and manual review is
-- an operational halt on the claim side.
data PolicyStatus
  = PS_Active
  | PS_PartiallyPaid
  | PS_Expired
  | PS_Cancelled
  | PS_ClaimedAndClosed
  | PS_ManualReview
  deriving (Eq, Show)

-- The premium-default axis, deliberately separate from
-- PolicyStatus above. These two are orthogonal -- a policy can be
-- partially paid AND in its grace period at the same time, and one field
-- cannot express that.
--
-- This is not a theoretical tidy-up. With both packed into one field, a
-- payout during the grace period re-minted with status = PS_PartiallyPaid
-- and thereby ERASED the grace period: graceSweeper.js (which filtered on
-- that same field) never saw the policy again, so it was never suspended
-- even though the premium was still unpaid, and the notice index blocked
-- serving a second notice to recover. Found in live verification at the
-- end of the premium-default work, fixed here by splitting the axes rather than by
-- special-casing the trigger.
--
-- Movement on the two axes is fully independent: a payout changes
-- PolicyStatus and never touches DefaultState; serving notice, terminating,
-- and reinstating change DefaultState and never touch PolicyStatus.
--
-- Termination: DS_Suspended is GONE, and its removal is deliberate.
-- The earlier model had the contract survive the
-- notice period with coverage merely stopped, which conflicts with TTK 6102
-- m. 1434(3): at the end of the notice period the contract is
-- `feshedilmiş olur` -- deemed terminated. That is a consequence, not a
-- power the insurer may choose to exercise, there is no suspension state in
-- the paragraph, and m. 1452(3) makes m. 1434 non-derogable against the
-- insured, so the general conditions cannot introduce one either.
--
-- DS_Terminated therefore means the contract has ENDED. It does not mean
-- the token is gone: the token stays live until every payout raised on the
-- policy has reached a terminal state, because termination must not orphan
-- an obligation the insurer still owes (see PolicyToken_Terminate and
-- PolicyToken_ArchiveForNonPayment).
data DefaultState
  = DS_None          -- no notice outstanding; premium not in default
  -- m. 1434(3), the SUBSEQUENT-premium mechanism: notice, ten days, fesih.
  | DS_GracePeriod   -- notice served; coverage CONTINUES IN FULL, losses payable
  | DS_Terminated    -- notice period elapsed unpaid; contract ended (m. 1434(3))
  -- m. 1434(2), the FIRST-premium mechanism. A different mechanism with
  -- different consequences, deliberately given its own vocabulary rather than
  -- folded into the two above: no ihtar, no ten days, no service date, and
  -- cayma rather than fesih. The two must not be conflated.
  | DS_FirstPremiumUnpaid
      -- The insurer has reported a due date for a first instalment (or a
      -- premium payable in one sum) that has not been paid. m. 1431(1) puts
      -- that due date at contract formation against delivery of the policy --
      -- an external fact this platform cannot observe, so it is reported.
  -- m. 1434(4), the THIRD way a contract ends for non-payment, and it must
  -- not be conflated with the other two. (2) is withdrawal; (3) is automatic
  -- termination at the end of a notice period. This one is DISCRETIONARY --
  -- "sigortaci ... sozlesmeyi FESHEDEBILIR" -- and its effect is DEFERRED:
  -- "sigorta doneminin sonunda HUKUM DOGURMAK UZERE".
  --
  -- Reachable only where (3) did NOT fire, i.e. where payment arrived inside
  -- the ten days on one or both occasions. That is what the paragraph is for:
  -- the chronically late payer, who always pays but only after an ihtar. (3)
  -- cannot help because the debt was cleared each time.
  --
  -- The deferral is the other half of the same thought. The premium for the
  -- current period WAS paid, so ending the contract immediately would take
  -- back cover already bought; ending it at the period end takes nothing.
  | DS_TwoNoticeElected
      -- The insurer has elected. The contract RUNS ON until the period end --
      -- cover continues in full and a loss in this window is payable, exactly
      -- as during a notice period. Nothing about the election shortens it.
  | DS_TwoNoticeTerminated
      -- The effect has landed at the period end. The contract has ENDED, by a
      -- different route from DS_Terminated and recorded as such.
  | DS_WithdrawnForFirstPremium
      -- Withdrawn under m. 1434(2), by either path. Named for THIS cayma
      -- specifically: Book Six carries at least two others -- m. 1430(3) (the
      -- sigorta ettiren's own, before liability begins, against half the
      -- premium) and m. 1439 (the insurer's, for breach of the disclosure
      -- obligation) -- and each must be able to take its own name later
      -- without renaming this one.
  deriving (Eq, Show)

-- WHY the insurer's liability began. m. 1421(1) makes payment the default
-- trigger -- "Aksine sözleşme yoksa, sigortacının sorumluluğu primin veya ilk
-- taksidinin ödenmesi ile başlar" -- but expressly allows the parties to
-- agree otherwise, and m. 1452(3) lists 1421, so it may be varied only in the
-- insured's FAVOUR: cover may be agreed to start earlier than payment, never
-- later.
--
-- Recorded because the two cases are legally distinct even though both end in
-- the same instant. m. 1422 (no premium earned if the risk becomes impossible
-- before liability begins) and m. 1430(3) (the sigorta ettiren may withdraw
-- before liability begins, against half the premium) both turn on WHETHER
-- liability had begun; being able to reconstruct WHY it began is what lets a
-- later reading tell an agreed early start from a payment.
data CoverageStartBasis
  = CSB_PremiumPaid
      -- m. 1421(1)'s default: the insurer reported receiving the first
      -- premium, and cover began at that reported instant.
  | CSB_AgreedWithoutPayment
      -- "aksine sözleşme": the parties agreed cover starts on a date
      -- irrespective of payment. Permitted only because it is earlier than
      -- payment would have been -- the direction m. 1452(3) allows.
  deriving (Eq, Show)

-- Which of m. 1434(2)'s two routes ended the contract. Both reach the same
-- state; the paragraph gives them different triggers, and which one applied
-- is a fact a later reading may turn on.
data WithdrawalPath
  = WP_InsurerWithdrew
      -- Sentence 1: "sigortacı ... sözleşmeden üç ay içinde cayabilir" -- an
      -- act, exercised within the window while payment has not been made.
  | WP_DeemedNoEnforcement
      -- Sentence 2: "Prim alacağının ... üç ay içinde dava veya takip yoluyla
      -- istenmemiş olması hâlinde, sözleşmeden cayılmış olunur" -- withdrawal
      -- follows by operation of law from inaction. Nobody exercises anything;
      -- the sweeper observes that the window elapsed with no suit or
      -- enforcement reported, and records it.
  deriving (Eq, Show)

-- Which route the insurer pursued against the sigorta ettiren for the premium
-- debt, and which one then proved fruitless. Recorded rather than collapsed
-- into one "enforcement" fact because the Code itself keeps them apart:
-- m. 1434(2) names both -- "dava veya takip yoluyla" -- while m. 1431(4),
-- which is what fruitlessness opens, names only "takip semeresiz kalmissa".
-- Whether `takip` there is meant narrowly or as pursuit generally is not
-- settled on the text, so the platform records which it actually was and
-- leaves the question open rather than answering it by flattening.
data EnforcementRoute
  = ER_Takip   -- enforcement proceedings (icra takibi)
  | ER_Dava    -- a lawsuit
  deriving (Eq, Show)

-- What a known real-right holder (the mortgagee) elected to do
-- within the continuation window m. 1456(5) opens at termination. Recorded
-- only -- the takeover itself is deliberately not implemented, so nothing
-- in this system acts on an election beyond writing it down.
data MortgageeElection
  = ME_Continue   -- elected to continue the contract
  | ME_Decline    -- elected not to
  deriving (Eq, Show)

-- Why an approved indemnity legitimately never settles. These are
-- outcomes, not failures to pay -- a failure to pay is
-- PayoutApproved_MarkFailed, which produces a review item that is still
-- expected to end somewhere. This enum is where a review item ends when the
-- answer is "no money moves, and that is final".
--
-- Deliberately short and deliberately not a judgement: the system records
-- which of these the insurer asserted, alongside a mandatory free-text note.
-- It draws no legal conclusion from any of them, and none of them means the
-- obligation was lawfully extinguished -- only that the insurer says it will
-- not be paid and why.
data UnpaidReason
  = UR_Waived        -- the claimant relinquished the claim
  | UR_Disputed      -- contested between the parties, not (yet) in court
  | UR_Litigation    -- before a court or arbitration
  | UR_Other         -- anything else; the free-text note carries the detail
  deriving (Eq, Show)

-- Same taxonomy as sql/schema.sql's `document_type` enum -- keep the two in
-- sync by hand, there's no way to share a single definition across SQL and
-- Daml. Not referenced by any template/choice yet: schema only, no
-- document-type handling is implemented.
data DocumentType
  = DT_Offer
  | DT_Endorsement
  | DT_Renewal
  | DT_Release
  | DT_FormalNotice
  deriving (Eq, Show)

-- Same taxonomy as sql/schema.sql's `endorsement_reason` enum. Only
-- meaningful when the document is DT_Endorsement -- a sum-insured
-- reduction is not its own DocumentType, it's an endorsement with this
-- reason.
data EndorsementReason
  = ER_SumInsuredIncrease
  | ER_SumInsuredReduction
  | ER_InsuredObjectChange
  | ER_TierChange
  | ER_Correction
  deriving (Eq, Show)

-- PolicyToken.amendmentReason reuses this same type rather than defining a
-- second, identical taxonomy -- a reduction of sum insured is deliberately
-- not its own document type, it's an endorsement with this reason code,
-- and that's true whether the reason is read off a policy_documents row or
-- off the token itself.

-- Which stakeholder role a payout should route to. A list, not a single
-- value, so a later multi-recipient split (e.g. part to mortgagee, part to
-- beneficiary) can be expressed without changing the token's field shape
-- again.
data PayoutDestinationRole
  = PDR_Beneficiary
  | PDR_Mortgagee
  | PDR_Insured
  -- m. 1457: "Sigortali mal haczedilirse, sigortaci ... sigorta tazminatini
  -- ICRA MUDURLUGUNE odeyerek borcundan kurtulur." A fourth recipient that is
  -- none of the other three, and the only one nobody designates: it arises
  -- from an attachment, years after the policy was written.
  --
  -- The article reads as a DISCHARGE mechanism rather than a duty --
  -- "odeyerek borcundan kurtulur" tells the insurer how to pay validly. But
  -- the officer's ihtar in the second sentence says the insurer is discharged
  -- "ANCAK icra mudurlugune odenilmesiyle", so after it the alternatives stop
  -- discharging. Permissive in form, constraining in effect.
  | PDR_EnforcementOffice
  deriving (Eq, Show)

-- Why an indemnity was recorded rather than routed. Two situations, and they
-- must stay distinguishable: they have different reasons and different
-- resolutions.
data UnroutedReason
  = UNR_MortgageeSurplus
      -- m. 1456(2): the excess over the mortgagee's remaining secured claim.
      -- The paragraph forbids paying the sigortali without izin and offers no
      -- surplus carve-out.
  | UNR_CompetingClaims
      -- m. 1456 and m. 1457 both bite on one coverage. The Code does not say
      -- which prevails -- they sit as `a) Sinirli ayni hak` and `b) Haciz`
      -- under one heading, `4. Menfaat uzerinde sinirlamalar`, two species of
      -- one genus with no priority rule between them -- and the substantive
      -- question is Icra ve Iflas Kanunu territory, which is not in this
      -- repository. So nothing routes.
  deriving (Eq, Show)

-- One coverage within a package policy (e.g. fire, theft,
-- glass on a single home policy). Each coverage is fully independent --
-- its own sum insured, its own remaining limit, its own tier matrix, its
-- own payout destination, and (if the policy has a mortgagee) its own
-- mortgagee claim ceiling. `mortgageeClaimAmount` being Some on this
-- coverage and None on another is exactly how "the mortgagee has a claim
-- on fire but not on glass" is expressed -- there is no separate
-- per-coverage mortgagee flag. Deliberately no shared or aggregate limit
-- across coverages in this version -- see PolicyToken.daml.
data Coverage = Coverage
  with
    coverageCode          : Text
    sumInsured            : Decimal
    remainingLimit        : Decimal
    payoutTiers           : [PayoutTier]
    payoutDestination     : [PayoutDestinationRole]
    mortgageeClaimAmount  : Optional Decimal
    -- m. 1457. The attachment of the insured property, and its lifting.
    --
    -- AN APPROXIMATION, stated rather than hidden: the article attaches to
    -- the PROPERTY -- "Sigortali mal haczedilirse", "Bir malin haczinde" --
    -- and this system has no property registry. The coverage is its nearest
    -- honest unit, which is the same approximation v17 already made for the
    -- mortgagee's charge one field above.
    --
    -- Attached NOW means attachedAt is set and attachmentLiftedAt is either
    -- absent or older than it. The shape follows m. 1456(6)'s outstanding
    -- request, and it earns its keep the same way: an attachment can be
    -- lifted and later re-imposed without either date being lost.
    --
    -- Lifting is a fact the Code itself anticipates, not one this system
    -- invented: the officer's ihtar binds "DIGER BIR BILDIRIME KADAR" --
    -- until a further notification.
    --
    -- Both are reported from outside. The platform cannot observe an icra
    -- file, and holds no case number, court, office identifier or party
    -- identity for one -- the routing decision needs none.
    attachedAt            : Optional Time
    attachmentLiftedAt    : Optional Time
    -- v22. The metric code the oracle emits, unit inside the code (e.g.
    -- TEMPERATURE_C). A trigger must name the same one. Not empty.
    metric                : Text
    -- v22. See PayoutBasis.
    payoutBasis           : PayoutBasis
    -- v22. A salted commitment to the cell id, "sha256:" + 64 lowercase
    -- hex; the salt stays off-ledger. A trigger must carry the same value.
    -- Equality shows the oracle evaluated the cell the policy committed to;
    -- it does not show the oracle read the right data for it.
    cellCommitment        : Text
  deriving (Eq, Show)

-- Coverage codes are a policy's coverages' permanent identity -- never the
-- list index, which shifts when a future endorsement adds or removes one.
-- O(n^2), fine at the scale a policy's coverage list actually reaches.
allDistinct : Eq a => [a] -> Bool
allDistinct [] = True
allDistinct (x :: xs) = notElem x xs && allDistinct xs

-- (An earlier version had an `inferActiveStatus` helper here, which
-- PolicyToken_Reinstate used to reconstruct whether a policy should come
-- back as PS_Active or PS_PartiallyPaid. Splitting the two status axes
-- removed the need for it entirely: reinstatement now only clears
-- DefaultState back to DS_None and never touches PolicyStatus, so there is
-- nothing left to reconstruct. Deleted rather than left dead, because a
-- status-inferring helper sitting next to a status field would imply
-- reinstatement still derives one.)

-- Same taxonomy as sql/schema.sql's `event_type` enum -- the outbox
-- vocabulary, distinct from DocumentType (a document is paperwork
-- evidence; an event is the outbox action that may produce one). Not
-- referenced by any template/choice yet -- only ET_Activation has a
-- dispatcher handler (node/src/dispatch/dispatcher.js); the rest are
-- defined now and rejected explicitly when the dispatcher sees them.
-- Deliberately has no ET_Offer -- offers are pre-contract and never enter
-- the outbox.
data EventType
  = ET_Activation
  | ET_Endorsement
  | ET_Renewal
  | ET_Notice
  | ET_Release
  deriving (Eq, Show)

data TriggerResult = TriggerResult
  with
    matched          : Bool
    matchedTierLabel : Optional Text
    payoutPct        : Decimal
    payoutAmount     : Decimal
    isFullSettlement : Bool
  deriving (Eq, Show)

inRange : Decimal -> PayoutTier -> Bool
inRange observed tier = aboveMin && belowMax
  where
    aboveMin = case tier.minValue of
      None -> True
      Some m -> observed >= m
    belowMax = case tier.maxValue of
      None -> True
      Some m -> observed <= m

-- First matching tier wins. Caller is responsible for pre-sorting by
-- tierOrder (Node.js does this with `ORDER BY tier_order ASC` when it loads
-- the matrix from SQL at mint time).
matchTier : [PayoutTier] -> Decimal -> Optional PayoutTier
matchTier tiers observed = find (inRange observed) tiers

floorTo2dp : Decimal -> Decimal
floorTo2dp x = intToDecimal (floor (x * 100.0)) / 100.0

-- v22. The structural rules a tier's shape needs. The [0, 100] range of
-- a linear tier's end percentages is the range of a percentage, not a
-- product value.
validTier : PayoutTier -> Bool
validTier tier = case tier.shape of
  TS_Step -> isNone tier.pctAtMin && isNone tier.pctAtMax
  TS_Linear -> case (tier.minValue, tier.maxValue, tier.pctAtMin, tier.pctAtMax) of
    (Some lo, Some hi, Some pLo, Some pHi) ->
      lo < hi && inPctRange pLo && inPctRange pHi &&
      -- v22. On a linear tier payoutPct means "the
      -- highest rate this tier can pay", so it is held to that value rather
      -- than left as a number nothing reads.
      tier.payoutPct == max pLo pHi
    _ -> False
  where
    inPctRange : Decimal -> Bool
    inPctRange p = p >= 0.0 && p <= 100.0

-- v22. The percentage a matched tier pays for this observed value. A
-- linear tier interpolates between its end percentages across its bounds
-- (both inclusive, as inRange); a malformed one, which validTier keeps off
-- the ledger, pays nothing rather than guessing.
tierPct : PayoutTier -> Decimal -> Decimal
tierPct tier observed = case tier.shape of
  TS_Step -> tier.payoutPct
  TS_Linear -> case (tier.minValue, tier.maxValue, tier.pctAtMin, tier.pctAtMax) of
    (Some lo, Some hi, Some pLo, Some pHi) | lo < hi ->
      pLo + (observed - lo) * (pHi - pLo) / (hi - lo)
    _ -> 0.0

-- v22. "sha256:" followed by exactly 64 lowercase hex characters.
isSha256Digest : Text -> Bool
isSha256Digest t = case T.stripPrefix "sha256:" t of
  Some h -> T.length h == 64 && all (`elem` hexDigits) (T.explode h)
  None -> False
  where
    hexDigits = T.explode "0123456789abcdef"

-- v22: the percentage is applied to `basis` -- the coverage's remaining
-- limit or its sum insured, as the coverage's payoutBasis says -- and the
-- amount is capped at what is currently LEFT (remainingLimit) under either,
-- so a second partial claim after an earlier one can never overpay past the
-- policy's true remaining exposure.
evaluateAgainstTiers : [PayoutTier] -> Decimal -> Decimal -> Decimal -> TriggerResult
evaluateAgainstTiers tiers basis remainingLimit observed =
  case matchTier tiers observed of
    None ->
      TriggerResult with
        matched = False
        matchedTierLabel = None
        payoutPct = 0.0
        payoutAmount = 0.0
        isFullSettlement = False
    Some tier ->
      let pct = tierPct tier observed
          rawAmount = basis * pct / 100.0
          amount = min (floorTo2dp rawAmount) remainingLimit
          isFull = pct >= 100.0 || amount >= remainingLimit
      -- v22. A linear tier whose computed amount is
      -- 0.00 -- a 0 end percentage, or a small one that floors to 0.00 -- is
      -- NO MATCH, the same result as a value outside every tier: nothing is
      -- created and the token is not touched. Without this it would reach
      -- PayoutApproved's `amount > 0.0` ensure and fail as a generic
      -- precondition. What such a
      -- value means legally is left open; this decides only what the ledger does with it.
      --
      -- v22. The same for EVERY tier shape: the
      -- amount is taken after the remaining-limit cap, so on a coverage whose
      -- limit is exhausted a step tier gives 0.00 too, and without this every
      -- matching reading would be a failed trigger.
      in if amount == 0.0 then
        TriggerResult with
          matched = False
          matchedTierLabel = None
          payoutPct = 0.0
          payoutAmount = 0.0
          isFullSettlement = False
      else TriggerResult with
        matched = True
        matchedTierLabel = Some tier.label
        payoutPct = pct
        payoutAmount = amount
        isFullSettlement = isFull
